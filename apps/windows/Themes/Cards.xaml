<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="CE.Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource CE.Surface}"/><Setter Property="BorderBrush" Value="{StaticResource CE.Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="20"/></Style>
 <Style x:Key="CE.Card.Clickable" TargetType="Button" BasedOn="{StaticResource CE.Button.Secondary}"><Setter Property="Padding" Value="20"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="MinHeight" Value="72"/><Setter Property="ToolTip" Value="Mở nội dung"/></Style>
 <Style x:Key="CE.DataGrid" TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource CE.Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="RowHeight" Value="44"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AlternatingRowBackground" Value="White"/><Setter Property="RowStyle" Value="{DynamicResource CE.DataGridRow}"/><Setter Property="CellStyle" Value="{DynamicResource CE.DataGridCell}"/><Setter Property="ColumnHeaderStyle" Value="{DynamicResource CE.DataGridHeader}"/></Style>
 <Style x:Key="CE.DataGridHeader" TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{StaticResource CE.PrimaryTint}"/><Setter Property="Foreground" Value="{StaticResource CE.Text}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0"/></Style>
 <Style x:Key="CE.DataGridRow" TargetType="DataGridRow"><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="3,0,0,0"/><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F6FAF7"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource CE.PrimaryTint}"/><Setter Property="BorderBrush" Value="{StaticResource CE.Primary}"/><Setter Property="Foreground" Value="{StaticResource CE.Text}"/></Trigger></Style.Triggers></Style>
 <Style x:Key="CE.DataGridCell" TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource CE.Text}"/></Trigger></Style.Triggers></Style><Style x:Key="CE.ListView" TargetType="ListView"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource CE.Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="ItemContainerStyle" Value="{DynamicResource CE.ListViewItem}"/></Style>
 <Style x:Key="CE.ListViewItem" TargetType="ListViewItem"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="12,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="3,0,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource CE.Canvas}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource CE.PrimaryTint}"/><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource CE.Primary}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource CE.Focus}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
