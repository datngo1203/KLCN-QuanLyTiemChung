<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="CE.Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource CE.Surface}"/><Setter Property="BorderBrush" Value="{StaticResource CE.CardBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="16"/></Style>
 <Style x:Key="CE.TableFrame" TargetType="Border"><Setter Property="Background" Value="{StaticResource CE.Surface}"/><Setter Property="BorderBrush" Value="{StaticResource CE.CardBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/></Style>
 <Style x:Key="CE.Card.Clickable" TargetType="Button" BasedOn="{StaticResource CE.Button.Secondary}"><Setter Property="Padding" Value="16"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="MinHeight" Value="64"/><Setter Property="ToolTip" Value="Mở nội dung"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{StaticResource CE.CardBorder}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{StaticResource CE.Hover}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CE.Focus}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Background" Value="{StaticResource CE.DisabledBackground}"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="CE.DataGrid" TargetType="DataGrid"><Setter Property="Background" Value="{StaticResource CE.Surface}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="RowHeight" Value="36"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowStyle" Value="{DynamicResource CE.DataGridRow}"/><Setter Property="CellStyle" Value="{DynamicResource CE.DataGridCell}"/><Setter Property="ColumnHeaderStyle" Value="{DynamicResource CE.DataGridHeader}"/></Style>
 <Style x:Key="CE.DataGridHeader" TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{StaticResource CE.TableHeader}"/><Setter Property="Foreground" Value="{StaticResource CE.Text}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="10,7"/><Setter Property="BorderBrush" Value="{StaticResource CE.CardBorder}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
 <Style x:Key="CE.DataGridRow" TargetType="DataGridRow"><Setter Property="Background" Value="{StaticResource CE.Surface}"/><Setter Property="BorderThickness" Value="3,0,0,0"/><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource CE.Hover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource CE.Selected}"/><Setter Property="BorderBrush" Value="{StaticResource CE.Primary}"/><Setter Property="Foreground" Value="{StaticResource CE.Text}"/></Trigger></Style.Triggers></Style>
 <Style x:Key="CE.DataGridCell" TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,6"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource CE.Text}"/></Trigger></Style.Triggers></Style>
 <Style x:Key="CE.ListView" TargetType="ListView"><Setter Property="Background" Value="{StaticResource CE.Surface}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ItemContainerStyle" Value="{DynamicResource CE.ListViewItem}"/></Style>
 <Style x:Key="CE.ListViewItem" TargetType="ListViewItem"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="10,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="3,0,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource CE.Hover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource CE.Selected}"/><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource CE.Primary}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource CE.Focus}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
