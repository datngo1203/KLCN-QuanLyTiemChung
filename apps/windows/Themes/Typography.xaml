<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="CE.FontFamily">Segoe UI</FontFamily>
  <Style x:Key="CE.Body" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource CE.Text}"/></Style>
  <Style x:Key="CE.Caption" TargetType="TextBlock" BasedOn="{StaticResource CE.Body}"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource CE.SecondaryText}"/></Style>
  <Style x:Key="CE.SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource CE.Body}"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="CE.Heading" TargetType="TextBlock" BasedOn="{StaticResource CE.Body}"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
</ResourceDictionary>
