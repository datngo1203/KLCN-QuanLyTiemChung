<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="CE.Badge" TargetType="Border"><Setter Property="CornerRadius" Value="99"/><Setter Property="Padding" Value="10,4"/><Setter Property="Background" Value="{StaticResource CE.NeutralBackground}"/><Setter Property="BorderBrush" Value="{StaticResource CE.DisabledBorder}"/><Setter Property="BorderThickness" Value="1"/></Style>
 <Style x:Key="CE.Badge.Pending" TargetType="Border" BasedOn="{StaticResource CE.Badge}"><Setter Property="Background" Value="{StaticResource CE.WarningBackground}"/><Setter Property="BorderBrush" Value="#FDE68A"/></Style>
 <Style x:Key="CE.Badge.Processing" TargetType="Border" BasedOn="{StaticResource CE.Badge}"><Setter Property="Background" Value="{StaticResource CE.InfoBackground}"/><Setter Property="BorderBrush" Value="#BFDBFE"/></Style>
 <Style x:Key="CE.Badge.Complete" TargetType="Border" BasedOn="{StaticResource CE.Badge}"><Setter Property="Background" Value="{StaticResource CE.SuccessBackground}"/><Setter Property="BorderBrush" Value="#BBF7D0"/></Style>
 <Style x:Key="CE.Badge.Expired" TargetType="Border" BasedOn="{StaticResource CE.Badge}"><Setter Property="Background" Value="{StaticResource CE.DangerBackground}"/><Setter Property="BorderBrush" Value="#FECACA"/></Style>
 <Style x:Key="CE.Badge.Inactive" TargetType="Border" BasedOn="{StaticResource CE.Badge}"/>
 <Style x:Key="CE.Badge.Sample" TargetType="Border" BasedOn="{StaticResource CE.Badge}"><Setter Property="Background" Value="#F5F3FF"/><Setter Property="BorderBrush" Value="#DDD6FE"/></Style>
 <Style x:Key="CE.Alert" TargetType="Border"><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14"/><Setter Property="BorderThickness" Value="1"/></Style>
 <Style x:Key="CE.Alert.Safety" TargetType="Border" BasedOn="{StaticResource CE.Alert}"><Setter Property="Background" Value="{StaticResource CE.WarningBackground}"/><Setter Property="BorderBrush" Value="#FDE68A"/></Style>
 <Style x:Key="CE.Alert.Info" TargetType="Border" BasedOn="{StaticResource CE.Alert}"><Setter Property="Background" Value="{StaticResource CE.InfoBackground}"/><Setter Property="BorderBrush" Value="#BFDBFE"/></Style>
 <Style x:Key="CE.Alert.Success" TargetType="Border" BasedOn="{StaticResource CE.Alert}"><Setter Property="Background" Value="{StaticResource CE.SuccessBackground}"/><Setter Property="BorderBrush" Value="#BBF7D0"/></Style>
 <Style x:Key="CE.Toast" TargetType="Border"><Setter Property="Background" Value="{StaticResource CE.Text}"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14,10"/></Style>
</ResourceDictionary>
