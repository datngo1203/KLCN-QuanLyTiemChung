<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="CE.Badge" TargetType="Border"><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="7,3"/><Setter Property="Background" Value="{StaticResource CE.Neutral.Background}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="TextElement.Foreground" Value="{StaticResource CE.Neutral.Foreground}"/><Setter Property="TextElement.FontWeight" Value="SemiBold"/></Style>
 <Style x:Key="CE.Badge.Neutral" TargetType="Border" BasedOn="{StaticResource CE.Badge}"/>
 <Style x:Key="CE.Badge.Info" TargetType="Border" BasedOn="{StaticResource CE.Badge}"><Setter Property="Background" Value="{StaticResource CE.Info.Background}"/><Setter Property="TextElement.Foreground" Value="{StaticResource CE.Info.Foreground}"/></Style>
 <Style x:Key="CE.Badge.Success" TargetType="Border" BasedOn="{StaticResource CE.Badge}"><Setter Property="Background" Value="{StaticResource CE.Success.Background}"/><Setter Property="TextElement.Foreground" Value="{StaticResource CE.Success.Foreground}"/></Style>
 <Style x:Key="CE.Badge.Warning" TargetType="Border" BasedOn="{StaticResource CE.Badge}"><Setter Property="Background" Value="{StaticResource CE.Warning.Background}"/><Setter Property="TextElement.Foreground" Value="{StaticResource CE.Warning.Foreground}"/></Style>
 <Style x:Key="CE.Badge.Danger" TargetType="Border" BasedOn="{StaticResource CE.Badge}"><Setter Property="Background" Value="{StaticResource CE.Danger.Background}"/><Setter Property="TextElement.Foreground" Value="{StaticResource CE.Danger.Foreground}"/></Style>
 <Style x:Key="CE.Badge.Pending" TargetType="Border" BasedOn="{StaticResource CE.Badge.Warning}"/>
 <Style x:Key="CE.Badge.Processing" TargetType="Border" BasedOn="{StaticResource CE.Badge.Info}"/>
 <Style x:Key="CE.Badge.Complete" TargetType="Border" BasedOn="{StaticResource CE.Badge.Success}"/>
 <Style x:Key="CE.Badge.Expired" TargetType="Border" BasedOn="{StaticResource CE.Badge.Danger}"/>
 <Style x:Key="CE.Badge.Inactive" TargetType="Border" BasedOn="{StaticResource CE.Badge.Neutral}"/>
 <Style x:Key="CE.Badge.Sample" TargetType="Border" BasedOn="{StaticResource CE.Badge.Neutral}"/>
 <DataTemplate x:Key="CE.Badge.Dot.Neutral"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource CE.Neutral.Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{Binding}" Foreground="{StaticResource CE.Neutral.Foreground}" FontWeight="SemiBold"/></StackPanel></DataTemplate>
 <DataTemplate x:Key="CE.Badge.Dot.Info"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource CE.Info.Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{Binding}" Foreground="{StaticResource CE.Info.Foreground}" FontWeight="SemiBold"/></StackPanel></DataTemplate>
 <DataTemplate x:Key="CE.Badge.Dot.Success"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource CE.Success.Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{Binding}" Foreground="{StaticResource CE.Success.Foreground}" FontWeight="SemiBold"/></StackPanel></DataTemplate>
 <DataTemplate x:Key="CE.Badge.Dot.Warning"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource CE.Warning.Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{Binding}" Foreground="{StaticResource CE.Warning.Foreground}" FontWeight="SemiBold"/></StackPanel></DataTemplate>
 <DataTemplate x:Key="CE.Badge.Dot.Danger"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource CE.Danger.Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{Binding}" Foreground="{StaticResource CE.Danger.Foreground}" FontWeight="SemiBold"/></StackPanel></DataTemplate>
 <Style x:Key="CE.Alert" TargetType="ContentControl"><Setter Property="Background" Value="{StaticResource CE.Surface}"/><Setter Property="BorderBrush" Value="{StaticResource CE.CardBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Tag" Value="{StaticResource CE.Neutral.Accent}"/><Setter Property="Foreground" Value="{StaticResource CE.Neutral.Foreground}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"><DockPanel><Border DockPanel.Dock="Left" Width="4" Background="{TemplateBinding Tag}"/><ContentPresenter Margin="12,10" VerticalAlignment="Center"/></DockPanel></Border></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="CE.Alert.Safety" TargetType="ContentControl" BasedOn="{StaticResource CE.Alert}"><Setter Property="Tag" Value="{StaticResource CE.Danger.Accent}"/><Setter Property="Foreground" Value="{StaticResource CE.Danger.Foreground}"/><Setter Property="Background" Value="{StaticResource CE.Danger.Background}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style x:Key="CE.Alert.Warning" TargetType="ContentControl" BasedOn="{StaticResource CE.Alert}"><Setter Property="Tag" Value="{StaticResource CE.Warning.Accent}"/><Setter Property="Foreground" Value="{StaticResource CE.Warning.Foreground}"/></Style>
 <Style x:Key="CE.Alert.Info" TargetType="ContentControl" BasedOn="{StaticResource CE.Alert}"><Setter Property="Tag" Value="{StaticResource CE.Info.Accent}"/><Setter Property="Foreground" Value="{StaticResource CE.Info.Foreground}"/></Style>
 <Style x:Key="CE.Alert.Success" TargetType="ContentControl" BasedOn="{StaticResource CE.Alert}"><Setter Property="Tag" Value="{StaticResource CE.Success.Accent}"/><Setter Property="Foreground" Value="{StaticResource CE.Success.Foreground}"/></Style>
 <Style x:Key="CE.Toast" TargetType="Border"><Setter Property="Background" Value="{StaticResource CE.Surface}"/><Setter Property="BorderBrush" Value="{StaticResource CE.CardBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="12,8"/></Style>
</ResourceDictionary>
