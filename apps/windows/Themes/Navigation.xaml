<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="CE.Menu.Level1" TargetType="ToggleButton"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="12,7"/><Setter Property="Foreground" Value="{StaticResource CE.Text}"/><Setter Property="Background" Value="{StaticResource CE.Surface}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource CE.Hover}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource CE.Primary}"/><Setter Property="Foreground" Value="{StaticResource CE.Primary}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource CE.Focus}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource CE.Muted}"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="CE.Menu.Level2" TargetType="ToggleButton" BasedOn="{StaticResource CE.Menu.Level1}"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="10,5"/></Style>
 <Style x:Key="CE.TabControl" TargetType="TabControl"><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel Grid.Row="0" IsItemsHost="True" Background="{StaticResource CE.Surface}"/><Border Grid.Row="1" Background="{StaticResource CE.Surface}" BorderBrush="{StaticResource CE.CardBorder}" BorderThickness="1" CornerRadius="6"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0"/></Border></Grid></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="CE.Tab" TargetType="TabItem"><Setter Property="Foreground" Value="{StaticResource CE.Text}"/><Setter Property="Padding" Value="12,7"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Surface" Background="{StaticResource CE.Surface}" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource CE.Hover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource CE.Primary}"/><Setter Property="Foreground" Value="{StaticResource CE.Primary}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource CE.Focus}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource CE.Muted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="CE.SegmentedButton" TargetType="RadioButton"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="{StaticResource CE.Neutral.Background}"/><Setter Property="Foreground" Value="{StaticResource CE.Text}"/><Setter Property="Tag" Value="{StaticResource CE.Neutral.Accent}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource CE.Hover}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource CE.Surface}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource CE.Focus}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="{StaticResource CE.DisabledBackground}"/><Setter Property="Foreground" Value="{StaticResource CE.Muted}"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="CE.SegmentedButton.Info" TargetType="RadioButton" BasedOn="{StaticResource CE.SegmentedButton}"><Setter Property="Tag" Value="{StaticResource CE.Info.Accent}"/></Style>
 <Style x:Key="CE.SegmentedButton.Warning" TargetType="RadioButton" BasedOn="{StaticResource CE.SegmentedButton}"><Setter Property="Tag" Value="{StaticResource CE.Warning.Accent}"/></Style>
</ResourceDictionary>
