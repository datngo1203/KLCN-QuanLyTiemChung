<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="CE.Menu.Level1" TargetType="ToggleButton"><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="16,9"/><Setter Property="Foreground" Value="{StaticResource CE.Text}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource CE.Canvas}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource CE.PrimaryTint}"/><Setter Property="Foreground" Value="{StaticResource CE.Primary}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource CE.Focus}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource CE.Muted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="CE.Menu.Level2" TargetType="ToggleButton" BasedOn="{StaticResource CE.Menu.Level1}"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="12,6"/></Style>
 <Style x:Key="CE.Tab" TargetType="TabItem"><Setter Property="Foreground" Value="{StaticResource CE.Text}"/><Setter Property="Padding" Value="14,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Surface" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource CE.Canvas}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource CE.PrimaryTint}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource CE.Primary}"/><Setter Property="Foreground" Value="{StaticResource CE.Primary}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource CE.Focus}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource CE.Muted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="CE.SegmentedButton" TargetType="RadioButton"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="15,8"/><Setter Property="Margin" Value="2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="{StaticResource CE.NeutralBackground}"/><Setter Property="Foreground" Value="{StaticResource CE.Text}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource CE.BorderHover}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{StaticResource CE.PrimaryTint}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource CE.Primary}"/><Setter Property="Foreground" Value="{StaticResource CE.Primary}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource CE.Focus}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="{StaticResource CE.DisabledBackground}"/><Setter Property="Foreground" Value="{StaticResource CE.Muted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="CE.SegmentedButton.Info" TargetType="RadioButton" BasedOn="{StaticResource CE.SegmentedButton}"><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{StaticResource CE.InfoBackground}"/><Setter Property="Foreground" Value="{StaticResource CE.Info}"/></Trigger></Style.Triggers></Style>
 <Style x:Key="CE.SegmentedButton.Warning" TargetType="RadioButton" BasedOn="{StaticResource CE.SegmentedButton}"><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{StaticResource CE.WarningBackground}"/><Setter Property="Foreground" Value="{StaticResource CE.Warning}"/></Trigger></Style.Triggers></Style>
</ResourceDictionary>
