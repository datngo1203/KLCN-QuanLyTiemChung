<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTemplate x:Key="CE.Validation.ErrorTemplate"><StackPanel><Border BorderBrush="{StaticResource CE.ErrorBorder}" BorderThickness="1" CornerRadius="9"><AdornedElementPlaceholder/></Border><ItemsControl ItemsSource="{Binding}" Margin="2,4,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Foreground="{StaticResource CE.Error}" FontSize="12" Text="{Binding ErrorContent}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ControlTemplate>
  <Style x:Key="CE.InputBorder" TargetType="Border"><Setter Property="Background" Value="{StaticResource CE.Surface}"/><Setter Property="BorderBrush" Value="{StaticResource CE.Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/></Style>
  <Style x:Key="CE.TextBox" TargetType="TextBox"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="12,8"/><Setter Property="Foreground" Value="{StaticResource CE.Text}"/><Setter Property="Background" Value="{StaticResource CE.Surface}"/><Setter Property="BorderBrush" Value="{StaticResource CE.Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Validation.ErrorTemplate" Value="{StaticResource CE.Validation.ErrorTemplate}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><Grid><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/><TextBlock x:Name="Watermark" Text="{TemplateBinding Tag}" Foreground="{StaticResource CE.Placeholder}" Margin="{TemplateBinding Padding}" IsHitTestVisible="False" Visibility="Collapsed"/></Grid></Border><ControlTemplate.Triggers><MultiTrigger><MultiTrigger.Conditions><Condition Property="Text" Value=""/><Condition Property="IsKeyboardFocused" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Watermark" Property="Visibility" Value="Visible"/></MultiTrigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource CE.BorderHover}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource CE.Focus}"/><Setter TargetName="Border" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource CE.ErrorBorder}"/><Setter TargetName="Border" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Background" Value="{StaticResource CE.DisabledBackground}"/><Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource CE.DisabledBorder}"/><Setter Property="Foreground" Value="{StaticResource CE.Muted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="CE.PasswordBox" TargetType="PasswordBox"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="12,8"/><Setter Property="Foreground" Value="{StaticResource CE.Text}"/><Setter Property="Background" Value="{StaticResource CE.Surface}"/><Setter Property="BorderBrush" Value="{StaticResource CE.Border}"/><Setter Property="Validation.ErrorTemplate" Value="{StaticResource CE.Validation.ErrorTemplate}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource CE.BorderHover}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource CE.Focus}"/><Setter TargetName="Border" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource CE.ErrorBorder}"/><Setter TargetName="Border" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Background" Value="{StaticResource CE.DisabledBackground}"/><Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource CE.DisabledBorder}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="CE.ComboBox" TargetType="ComboBox"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="10,7"/><Setter Property="Background" Value="{StaticResource CE.Surface}"/><Setter Property="Foreground" Value="{StaticResource CE.Text}"/><Setter Property="BorderBrush" Value="{StaticResource CE.Border}"/><Setter Property="Validation.ErrorTemplate" Value="{StaticResource CE.Validation.ErrorTemplate}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9"/><ContentPresenter Margin="12,0,34,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/><ToggleButton x:Name="DropDownToggle" Width="32" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><Path Stroke="{StaticResource CE.Muted}" StrokeThickness="2" Data="M 2,4 L 7,9 L 12,4" Width="14" Height="12" Stretch="None"/></ToggleButton><Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade"><Border Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="{StaticResource CE.Surface}" BorderBrush="{StaticResource CE.Border}" BorderThickness="1" CornerRadius="9" Padding="4"><ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource CE.BorderHover}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource CE.Focus}"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource CE.ErrorBorder}"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Background" Value="{StaticResource CE.DisabledBackground}"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource CE.DisabledBorder}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="CE.ComboBoxItem" TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource CE.PrimaryTint}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource CE.PrimaryTint}"/><Setter Property="Foreground" Value="{StaticResource CE.Primary}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="CE.DatePicker" TargetType="DatePicker"><Setter Property="MinHeight" Value="38"/><Setter Property="Validation.ErrorTemplate" Value="{StaticResource CE.Validation.ErrorTemplate}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker"><Grid><Border x:Name="Box" Background="{StaticResource CE.Surface}" BorderBrush="{StaticResource CE.Border}" BorderThickness="1" CornerRadius="9"/><DatePickerTextBox x:Name="PART_TextBox" BorderThickness="0" Background="Transparent" Margin="9,2,36,2" VerticalContentAlignment="Center"/><Button x:Name="PART_Button" Width="32" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" ToolTip="Chọn ngày"><Viewbox Width="18" Height="18"><Canvas Width="20" Height="20"><Path Stroke="{StaticResource CE.Muted}" StrokeThickness="1.8" Data="M3,5 L17,5 L17,18 L3,18 Z M3,9 L17,9 M7,2 L7,7 M13,2 L13,7"/></Canvas></Viewbox></Button><Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" StaysOpen="False" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><Border Background="{StaticResource CE.Surface}" BorderBrush="{StaticResource CE.Border}" BorderThickness="1" CornerRadius="9" Padding="6"><Calendar x:Name="PART_Calendar"/></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource CE.BorderHover}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource CE.Focus}"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource CE.ErrorBorder}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Background" Value="{StaticResource CE.DisabledBackground}"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource CE.DisabledBorder}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="CE.CheckBox" TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource CE.Text}"/><Setter Property="Margin" Value="0,4"/><Setter Property="Validation.ErrorTemplate" Value="{StaticResource CE.Validation.ErrorTemplate}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Mark" Width="18" Height="18" CornerRadius="4" BorderBrush="{StaticResource CE.Border}" BorderThickness="1" Background="White" Margin="0,0,8,0"><Path x:Name="Tick" Visibility="Collapsed" Stroke="White" StrokeThickness="2" Data="M 3,9 L 7,13 L 15,4"/></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Background" Value="{StaticResource CE.Primary}"/><Setter TargetName="Mark" Property="BorderBrush" Value="{StaticResource CE.Primary}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Mark" Property="BorderBrush" Value="{StaticResource CE.Focus}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Mark" Property="BorderThickness" Value="2"/><Setter TargetName="Mark" Property="BorderBrush" Value="{StaticResource CE.Focus}"/></Trigger><Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Mark" Property="BorderBrush" Value="{StaticResource CE.ErrorBorder}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Mark" Property="Background" Value="{StaticResource CE.DisabledBackground}"/><Setter Property="Foreground" Value="{StaticResource CE.Muted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="CE.RadioButton" TargetType="RadioButton"><Setter Property="Foreground" Value="{StaticResource CE.Text}"/><Setter Property="Margin" Value="0,4"/><Setter Property="Validation.ErrorTemplate" Value="{StaticResource CE.Validation.ErrorTemplate}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><StackPanel Orientation="Horizontal"><Border x:Name="Mark" Width="18" Height="18" CornerRadius="9" BorderBrush="{StaticResource CE.Border}" BorderThickness="1" Background="White" Margin="0,0,8,0"><Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource CE.Primary}" Visibility="Collapsed"/></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="BorderBrush" Value="{StaticResource CE.Primary}"/><Setter TargetName="Dot" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Mark" Property="BorderBrush" Value="{StaticResource CE.Focus}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Mark" Property="BorderThickness" Value="2"/><Setter TargetName="Mark" Property="BorderBrush" Value="{StaticResource CE.Focus}"/></Trigger><Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Mark" Property="BorderBrush" Value="{StaticResource CE.ErrorBorder}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Mark" Property="Background" Value="{StaticResource CE.DisabledBackground}"/><Setter Property="Foreground" Value="{StaticResource CE.Muted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>

