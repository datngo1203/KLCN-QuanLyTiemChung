<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="CE.ButtonBase" TargetType="Button"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="16,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="{StaticResource CE.Primary}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource CE.Focus}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{StaticResource CE.DisabledBackground}"/><Setter Property="Foreground" Value="{StaticResource CE.Muted}"/><Setter Property="BorderBrush" Value="{StaticResource CE.DisabledBorder}"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="CE.Button.Primary" TargetType="Button" BasedOn="{StaticResource CE.ButtonBase}"/>
 <Style x:Key="CE.Button.Secondary" TargetType="Button" BasedOn="{StaticResource CE.ButtonBase}"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource CE.Text}"/><Setter Property="BorderBrush" Value="{StaticResource CE.Border}"/></Style>
 <Style x:Key="CE.Button.Ghost" TargetType="Button" BasedOn="{StaticResource CE.ButtonBase}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource CE.Primary}"/></Style>
 <Style x:Key="CE.Button.Danger" TargetType="Button" BasedOn="{StaticResource CE.ButtonBase}"><Setter Property="Background" Value="{StaticResource CE.Error}"/><Setter Property="Foreground" Value="White"/></Style>
 <Style x:Key="CE.Button.Icon" TargetType="Button" BasedOn="{StaticResource CE.Button.Secondary}"><Setter Property="Width" Value="38"/><Setter Property="Padding" Value="8"/></Style>
 <Geometry x:Key="CE.Icon.Refresh">M 18,6 A 7,7 0 1 0 20,12 M 18,2 L 18,7 L 13,7</Geometry>
 <Geometry x:Key="CE.Icon.Delete">M 4,6 L 20,6 M 8,6 L 9,20 L 17,20 L 18,6 M 7,3 L 17,3</Geometry>
 <Geometry x:Key="CE.Icon.Add">M 12,3 L 12,21 M 3,12 L 21,12</Geometry>
 <Geometry x:Key="CE.Icon.Search">M 17,17 L 22,22 M 19,10 A 8,8 0 1 1 3,10 A 8,8 0 1 1 19,10</Geometry>
</ResourceDictionary>
