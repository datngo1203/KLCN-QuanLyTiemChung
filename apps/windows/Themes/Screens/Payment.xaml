<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="Payment.ListItem" TargetType="ListBoxItem">
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,4"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="3,0,0,0"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border><ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource CE.Hover}"/></Trigger>
   <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource CE.Selected}"/><Setter Property="BorderBrush" Value="{StaticResource CE.Primary}"/></Trigger>
  </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Payment.InvoiceBadge" TargetType="Border" BasedOn="{StaticResource CE.Badge.Warning}"><Style.Triggers><DataTrigger Binding="{Binding State}" Value="Đã hoàn tất"><Setter Property="Background" Value="{StaticResource CE.Success.Background}"/><Setter Property="TextElement.Foreground" Value="{StaticResource CE.Success.Foreground}"/></DataTrigger></Style.Triggers></Style>
 <Style x:Key="Payment.TransactionBadge" TargetType="Border" BasedOn="{StaticResource CE.Badge.Info}"><Style.Triggers>
  <DataTrigger Binding="{Binding Status}" Value="Thành công"><Setter Property="Background" Value="{StaticResource CE.Success.Background}"/><Setter Property="TextElement.Foreground" Value="{StaticResource CE.Success.Foreground}"/></DataTrigger>
  <DataTrigger Binding="{Binding Status}" Value="Thất bại"><Setter Property="Background" Value="{StaticResource CE.Danger.Background}"/><Setter Property="TextElement.Foreground" Value="{StaticResource CE.Danger.Foreground}"/></DataTrigger>
 </Style.Triggers></Style>
</ResourceDictionary>
