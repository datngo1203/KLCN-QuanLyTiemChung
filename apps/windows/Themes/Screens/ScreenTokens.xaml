<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Style x:Key="CE.Screen.MainWindowText" TargetType="{x:Type Window}"><Setter Property="FontSize" Value="14"/></Style>
    <Style x:Key="CE.Screen.MainWindowIcon" TargetType="{x:Type ui:SymbolIcon}"><Setter Property="FontSize" Value="24"/></Style>
    <Style x:Key="CE.Screen.LoginMark" TargetType="{x:Type TextBlock}"><Setter Property="FontSize" Value="38"/></Style>
    <Style x:Key="CE.Screen.LoginTitle" TargetType="{x:Type TextBlock}"><Setter Property="FontSize" Value="26"/></Style>
    <Style x:Key="CE.Screen.LoginCaption" TargetType="{x:Type TextBlock}"><Setter Property="FontSize" Value="12"/></Style>
    <Style x:Key="CE.Screen.LoginDescription" TargetType="{x:Type TextBlock}"><Setter Property="FontSize" Value="14"/></Style>
    <Style x:Key="CE.Screen.OverviewId" TargetType="{x:Type TextBlock}"><Setter Property="FontSize" Value="11"/></Style>
    <Style x:Key="CE.Screen.OverviewEmptyIcon" TargetType="{x:Type ui:SymbolIcon}"><Setter Property="FontSize" Value="28"/></Style>
    <SolidColorBrush x:Key="CE.Screen.InventoryDialogOverlay" Color="#66000000"/>
</ResourceDictionary>
