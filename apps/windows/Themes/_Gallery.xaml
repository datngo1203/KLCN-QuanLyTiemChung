<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Themes gallery — Clinical Emerald" Width="1100" Height="900" Background="{DynamicResource CE.Canvas}" FontFamily="Segoe UI">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Colors.xaml"/><ResourceDictionary Source="Typography.xaml"/><ResourceDictionary Source="Controls.xaml"/><ResourceDictionary Source="Buttons.xaml"/><ResourceDictionary Source="Cards.xaml"/><ResourceDictionary Source="BadgesAlerts.xaml"/><ResourceDictionary Source="Navigation.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
  <TextBlock Text="Clinical Emerald — thư viện giao diện" Style="{DynamicResource CE.Heading}"/><TextBlock Text="Trang thử theme; không nằm trong menu chính" Style="{DynamicResource CE.Caption}" Margin="0,3,0,20"/>
  <TextBlock Text="Ô nhập · thường / lỗi / vô hiệu" FontWeight="SemiBold" Margin="0,0,0,8"/>
  <WrapPanel><StackPanel Width="220" Margin="0,0,14,12"><TextBlock Text="Họ tên"/><TextBox Style="{DynamicResource CE.TextBox}" Tag="Nhập họ tên"/><TextBlock Text="Gợi ý: nhập họ tên" Foreground="{DynamicResource CE.Placeholder}" FontSize="12"/></StackPanel><StackPanel Width="220" Margin="0,0,14,12"><TextBlock Text="Mật khẩu"/><PasswordBox Style="{DynamicResource CE.PasswordBox}"/><TextBlock Text="Lỗi: cần nhập mật khẩu" Foreground="{DynamicResource CE.Error}" FontSize="12"/></StackPanel><StackPanel Width="220" Margin="0,0,14,12"><TextBlock Text="Lựa chọn"/><ComboBox Style="{DynamicResource CE.ComboBox}" ItemContainerStyle="{DynamicResource CE.ComboBoxItem}" SelectedIndex="0"><ComboBoxItem Content="Chờ khám"/><ComboBoxItem Content="Đã khám"/></ComboBox></StackPanel><StackPanel Width="220"><TextBlock Text="Ngày"/><DatePicker Style="{DynamicResource CE.DatePicker}"/></StackPanel></WrapPanel>
  <WrapPanel Margin="0,0,0,18"><TextBox Width="180" Text="Đã vô hiệu" IsEnabled="False" Style="{DynamicResource CE.TextBox}" Margin="0,0,18,0"/><CheckBox Content="Đã chọn" IsChecked="True" Style="{DynamicResource CE.CheckBox}" Margin="0,0,18,0"/><CheckBox Content="Vô hiệu" IsEnabled="False" Style="{DynamicResource CE.CheckBox}" Margin="0,0,18,0"/><RadioButton Content="Lựa chọn A" IsChecked="True" GroupName="demo" Style="{DynamicResource CE.RadioButton}" Margin="0,0,18,0"/><RadioButton Content="Lựa chọn B" GroupName="demo" Style="{DynamicResource CE.RadioButton}"/></WrapPanel>
  <TextBlock Text="Nút · màu và icon" FontWeight="SemiBold" Margin="0,0,0,8"/><WrapPanel Margin="0,0,0,18"><Button Content="Lưu" Style="{DynamicResource CE.Button.Primary}" Margin="0,0,8,0"/><Button Content="Hủy" Style="{DynamicResource CE.Button.Secondary}" Margin="0,0,8,0"/><Button Content="Xem thêm" Style="{DynamicResource CE.Button.Ghost}" Margin="0,0,8,0"/><Button Content="Xóa" Style="{DynamicResource CE.Button.Danger}" Margin="0,0,8,0"/><Button Content="Vô hiệu" IsEnabled="False" Style="{DynamicResource CE.Button.Primary}" Margin="0,0,18,0"/><Button Style="{DynamicResource CE.Button.Icon}" ToolTip="Làm mới" Margin="0,0,5,0"><Path Data="{DynamicResource CE.Icon.Refresh}" Stroke="{DynamicResource CE.Text}" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform"/></Button><Button Style="{DynamicResource CE.Button.Icon}" ToolTip="Xóa dòng" Margin="0,0,5,0"><Path Data="{DynamicResource CE.Icon.Delete}" Stroke="{DynamicResource CE.Error}" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform"/></Button><Button Style="{DynamicResource CE.Button.Icon}" ToolTip="Thêm" Margin="0,0,5,0"><Path Data="{DynamicResource CE.Icon.Add}" Stroke="{DynamicResource CE.Text}" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform"/></Button><Button Style="{DynamicResource CE.Button.Icon}" ToolTip="Tìm kiếm"><Path Data="{DynamicResource CE.Icon.Search}" Stroke="{DynamicResource CE.Text}" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform"/></Button></WrapPanel>
  <TextBlock Text="Bảng và danh sách" FontWeight="SemiBold" Margin="0,0,0,8"/><Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DataGrid Style="{DynamicResource CE.DataGrid}" AutoGenerateColumns="False" Height="145" SelectedIndex="1" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Mã" Binding="{Binding Tag}" Width="*"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Content}" Width="2*"/></DataGrid.Columns><TextBlock Tag="01" Text="Chờ khám"/><TextBlock Tag="02" Text="Đã khám"/></DataGrid><ListView Grid.Column="1" Margin="12,0,0,0" Height="145" Style="{DynamicResource CE.ListView}" SelectedIndex="1"><ListViewItem Content="Hàng bình thường"/><ListViewItem Content="Hàng đã chọn"/><ListViewItem Content="Hàng cuối"/></ListView></Grid>
  <TextBlock Text="Badge trạng thái" FontWeight="SemiBold" Margin="0,0,0,8"/><WrapPanel Margin="0,0,0,18"><Border Style="{DynamicResource CE.Badge.Pending}" Margin="0,0,6,6"><TextBlock Text="Chờ khám" Foreground="{DynamicResource CE.Warning}"/></Border><Border Style="{DynamicResource CE.Badge.Pending}" Margin="0,0,6,6"><TextBlock Text="Chờ thanh toán" Foreground="{DynamicResource CE.Warning}"/></Border><Border Style="{DynamicResource CE.Badge.Processing}" Margin="0,0,6,6"><TextBlock Text="Chờ tiêm" Foreground="{DynamicResource CE.Info}"/></Border><Border Style="{DynamicResource CE.Badge.Processing}" Margin="0,0,6,6"><TextBlock Text="Theo dõi" Foreground="{DynamicResource CE.Info}"/></Border><Border Style="{DynamicResource CE.Badge.Complete}" Margin="0,0,6,6"><TextBlock Text="Đã khám" Foreground="{DynamicResource CE.Success}"/></Border><Border Style="{DynamicResource CE.Badge.Pending}" Margin="0,0,6,6"><TextBlock Text="Hoãn" Foreground="{DynamicResource CE.Warning}"/></Border><Border Style="{DynamicResource CE.Badge.Expired}" Margin="0,0,6,6"><TextBlock Text="Hết hạn" Foreground="{DynamicResource CE.Error}"/></Border><Border Style="{DynamicResource CE.Badge.Inactive}" Margin="0,0,6,6"><TextBlock Text="Tạm ngừng" Foreground="{DynamicResource CE.Muted}"/></Border><Border Style="{DynamicResource CE.Badge.Complete}" Margin="0,0,6,6"><TextBlock Text="Đang hoạt động" Foreground="{DynamicResource CE.Success}"/></Border><Border Style="{DynamicResource CE.Badge.Expired}" Margin="0,0,6,6"><TextBlock Text="Đã khóa" Foreground="{DynamicResource CE.Error}"/></Border><Border Style="{DynamicResource CE.Badge.Sample}" Margin="0,0,6,6"><TextBlock Text="Dữ liệu mẫu" Foreground="#5B21B6"/></Border></WrapPanel>
  <TextBlock Text="Alert và thông báo" FontWeight="SemiBold" Margin="0,0,0,8"/><StackPanel Margin="0,0,0,18"><Border Style="{DynamicResource CE.Alert.Safety}" Margin="0,0,0,6"><TextBlock Text="⚠  Cảnh báo an toàn — cần đánh giá trước khi tiếp tục" Foreground="{DynamicResource CE.Warning}"/></Border><Border Style="{DynamicResource CE.Alert.Info}" Margin="0,0,0,6"><TextBlock Text="ⓘ  Thông tin — dữ liệu đang được kiểm tra" Foreground="{DynamicResource CE.Info}"/></Border><Border Style="{DynamicResource CE.Alert.Success}"><TextBlock Text="✓  Thành công — đã hoàn tất thao tác" Foreground="{DynamicResource CE.Success}"/></Border></StackPanel>
  <TextBlock Text="Điều hướng, tab, card và lựa chọn" FontWeight="SemiBold" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><ToggleButton Content="Nhóm cấp 1" IsChecked="True" Style="{DynamicResource CE.Menu.Level1}"/><ToggleButton Content="Nhóm cấp 2" IsChecked="True" Style="{DynamicResource CE.Menu.Level2}"/><ToggleButton Content="Mục khác" Style="{DynamicResource CE.Menu.Level2}"/></StackPanel><TabControl Height="95" Margin="0,0,0,12"><TabItem Header="Nhân viên" Style="{DynamicResource CE.Tab}"><TextBlock Text="Nội dung tab" Margin="12"/></TabItem><TabItem Header="Tài khoản" Style="{DynamicResource CE.Tab}"/><TabItem Header="Quyền bổ sung" Style="{DynamicResource CE.Tab}"/></TabControl><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Border Style="{DynamicResource CE.Card}" Width="210" Margin="0,0,12,0"><TextBlock Text="Card thông thường"/></Border><Button Content="Card có thể bấm →" Style="{DynamicResource CE.Card.Clickable}" Width="210"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><RadioButton Content="Chế độ 1" GroupName="segment" IsChecked="True" Style="{DynamicResource CE.SegmentedButton}"/><RadioButton Content="Chế độ 2" GroupName="segment" Style="{DynamicResource CE.SegmentedButton.Info}"/><RadioButton Content="Chế độ 3" GroupName="segment" Style="{DynamicResource CE.SegmentedButton.Warning}"/></StackPanel><Border Style="{DynamicResource CE.Toast}"><TextBlock Text="Thông báo ngắn: thao tác đã được ghi nhận" Foreground="White"/></Border>
 </StackPanel></ScrollViewer>
</Window>
