<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Clinical Neutral — Themes gallery" Width="1100" Height="900" Language="vi-VN" Background="{DynamicResource CE.Canvas}" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Colors.xaml"/><ResourceDictionary Source="Typography.xaml"/><ResourceDictionary Source="Controls.xaml"/><ResourceDictionary Source="Buttons.xaml"/><ResourceDictionary Source="Cards.xaml"/><ResourceDictionary Source="BadgesAlerts.xaml"/><ResourceDictionary Source="Navigation.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
  <TextBlock Text="Clinical Neutral — thư viện giao diện" Style="{DynamicResource CE.Heading}"/>
  <TextBlock Text="Trang thử Theme, không nằm trong menu chính" Style="{DynamicResource CE.Caption}" Margin="0,2,0,18"/>
  <Border Style="{DynamicResource CE.Card}" Margin="0,0,0,16"><StackPanel>
   <TextBlock Text="Bảng + bộ lọc" Style="{DynamicResource CE.SectionHeading}" Margin="0,0,0,3"/>
   <TextBlock Text="Theo dõi hồ sơ tiêm chủng · dữ liệu minh họa" Style="{DynamicResource CE.Caption}" Margin="0,0,0,12"/>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
    <TextBox Width="220" Tag="Tìm mã hồ sơ" Style="{DynamicResource CE.TextBox}" Margin="0,0,8,0"/>
    <ComboBox Width="170" Style="{DynamicResource CE.ComboBox}" ItemContainerStyle="{DynamicResource CE.ComboBoxItem}" SelectedIndex="0" Margin="0,0,8,0"><ComboBoxItem Content="Tất cả trạng thái"/><ComboBoxItem Content="Chờ khám"/><ComboBoxItem Content="Đã khám"/></ComboBox>
    <DatePicker Width="150" Style="{DynamicResource CE.DatePicker}" Margin="0,0,8,0"/>
    <Button Content="Lọc" Style="{DynamicResource CE.Button.Primary}" Margin="0,0,8,0"/>
    <Button Content="Đặt lại" Style="{DynamicResource CE.Button.Secondary}" Margin="0,0,8,0"/>
    <Button Style="{DynamicResource CE.Button.Icon}" ToolTip="Làm mới"><Path Data="{DynamicResource CE.Icon.Refresh}" Stroke="{DynamicResource CE.Text}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform"/></Button>
   </StackPanel>
   <Border Style="{DynamicResource CE.TableFrame}"><StackPanel>
    <Grid Background="{DynamicResource CE.TableHeader}" Height="36"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="175"/><ColumnDefinition Width="145"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="Mã hồ sơ" Grid.Column="0" Margin="12,9" FontWeight="SemiBold"/><TextBlock Text="Dịch vụ" Grid.Column="1" Margin="12,9" FontWeight="SemiBold"/><TextBlock Text="Trạng thái" Grid.Column="2" Margin="12,9" FontWeight="SemiBold"/><TextBlock Text="Cập nhật" Grid.Column="3" Margin="12,9" FontWeight="SemiBold"/><TextBlock Text="Thao tác" Grid.Column="4" Margin="4,9" FontWeight="SemiBold"/></Grid>
    <Grid Height="36" Background="{DynamicResource CE.Surface}"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="175"/><ColumnDefinition Width="145"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="HS-001" Grid.Column="0" Margin="12,8"/><TextBlock Text="Khám sàng lọc" Grid.Column="1" Margin="12,8"/><Border Style="{DynamicResource CE.Badge.Warning}" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0"><TextBlock Text="Chờ khám"/></Border><TextBlock Text="22/10/2026" Grid.Column="3" Margin="12,8"/><Button Grid.Column="4" Style="{DynamicResource CE.Button.Icon}" ToolTip="Xem hồ sơ" Margin="4,2"><Path Data="{DynamicResource CE.Icon.Search}" Stroke="{DynamicResource CE.Text}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform"/></Button></Grid>
    <Grid Height="36" Background="{DynamicResource CE.Selected}"><Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="107"/><ColumnDefinition Width="*"/><ColumnDefinition Width="175"/><ColumnDefinition Width="145"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{DynamicResource CE.Primary}"/><TextBlock Text="HS-002" Grid.Column="1" Margin="9,8"/><TextBlock Text="Theo dõi sau tiêm" Grid.Column="2" Margin="12,8"/><Border Style="{DynamicResource CE.Badge.Info}" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0"><TextBlock Text="Theo dõi"/></Border><TextBlock Text="22/10/2026" Grid.Column="4" Margin="12,8"/><Button Grid.Column="5" Style="{DynamicResource CE.Button.Icon}" ToolTip="Xem hồ sơ" Margin="4,2"><Path Data="{DynamicResource CE.Icon.Search}" Stroke="{DynamicResource CE.Text}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform"/></Button></Grid>
    <Grid Height="36" Background="{DynamicResource CE.Surface}"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="175"/><ColumnDefinition Width="145"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="HS-003" Grid.Column="0" Margin="12,8"/><TextBlock Text="Khám sàng lọc" Grid.Column="1" Margin="12,8"/><Border Style="{DynamicResource CE.Badge.Success}" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0"><TextBlock Text="Đã khám"/></Border><TextBlock Text="21/10/2026" Grid.Column="3" Margin="12,8"/><Button Grid.Column="4" Style="{DynamicResource CE.Button.Icon}" ToolTip="Xem hồ sơ" Margin="4,2"><Path Data="{DynamicResource CE.Icon.Search}" Stroke="{DynamicResource CE.Text}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform"/></Button></Grid>
    <Grid Height="36" Background="{DynamicResource CE.Surface}"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="175"/><ColumnDefinition Width="145"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="HS-004" Grid.Column="0" Margin="12,8"/><TextBlock Text="Lịch hẹn" Grid.Column="1" Margin="12,8"/><Border Style="{DynamicResource CE.Badge.Danger}" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0"><TextBlock Text="Hết hạn"/></Border><TextBlock Text="20/10/2026" Grid.Column="3" Margin="12,8"/><Button Grid.Column="4" Style="{DynamicResource CE.Button.Icon}" ToolTip="Xem hồ sơ" Margin="4,2"><Path Data="{DynamicResource CE.Icon.Search}" Stroke="{DynamicResource CE.Text}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform"/></Button></Grid>
    <Grid Height="36" Background="{DynamicResource CE.Surface}"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="175"/><ColumnDefinition Width="145"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="HS-005" Grid.Column="0" Margin="12,8"/><TextBlock Text="Danh mục" Grid.Column="1" Margin="12,8"/><Border Style="{DynamicResource CE.Badge.Neutral}" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0"><TextBlock Text="Tạm ngừng"/></Border><TextBlock Text="19/10/2026" Grid.Column="3" Margin="12,8"/><Button Grid.Column="4" Style="{DynamicResource CE.Button.Icon}" ToolTip="Xem hồ sơ" Margin="4,2"><Path Data="{DynamicResource CE.Icon.Search}" Stroke="{DynamicResource CE.Text}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform"/></Button></Grid>
   </StackPanel></Border>
   <DockPanel Margin="0,10,0,0"><TextBlock Text="Hiển thị 1–5 trong 25 hồ sơ" Foreground="{DynamicResource CE.SecondaryText}" DockPanel.Dock="Left" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="‹" Style="{DynamicResource CE.Button.Secondary}" Width="32" Margin="0,0,4,0"/><Button Content="1" Style="{DynamicResource CE.Button.Primary}" Width="32" Margin="0,0,4,0"/><Button Content="2" Style="{DynamicResource CE.Button.Secondary}" Width="32" Margin="0,0,4,0"/><Button Content="3" Style="{DynamicResource CE.Button.Secondary}" Width="32" Margin="0,0,4,0"/><Button Content="›" Style="{DynamicResource CE.Button.Secondary}" Width="32"/></StackPanel></DockPanel>
  </StackPanel></Border>
  <TextBlock Text="Điều khiển và trạng thái" Style="{DynamicResource CE.SectionHeading}" Margin="0,0,0,8"/>
  <WrapPanel Margin="0,0,0,12"><TextBox Width="180" Tag="Nhập nội dung" Style="{DynamicResource CE.TextBox}" Margin="0,0,8,0"/><PasswordBox Width="150" Style="{DynamicResource CE.PasswordBox}" Margin="0,0,8,0"/><TextBox Width="150" Text="Vô hiệu" IsEnabled="False" Style="{DynamicResource CE.TextBox}" Margin="0,0,8,0"/><CheckBox Content="Đã chọn" IsChecked="True" Style="{DynamicResource CE.CheckBox}" Margin="0,0,8,0"/><RadioButton Content="Lựa chọn" IsChecked="True" Style="{DynamicResource CE.RadioButton}"/></WrapPanel>
  <WrapPanel Margin="0,0,0,14"><Button Content="Lưu" Style="{DynamicResource CE.Button.Primary}" Margin="0,0,8,0"/><Button Content="Hủy" Style="{DynamicResource CE.Button.Secondary}" Margin="0,0,8,0"/><Button Content="Xem thêm" Style="{DynamicResource CE.Button.Ghost}" Margin="0,0,8,0"/><Button Content="Xóa" Style="{DynamicResource CE.Button.Danger}" Margin="0,0,8,0"/><Button Content="Vô hiệu" IsEnabled="False" Style="{DynamicResource CE.Button.Primary}" Margin="0,0,8,0"/><Button Style="{DynamicResource CE.Button.Icon}" ToolTip="Xóa dòng" Margin="0,0,6,0"><Path Data="{DynamicResource CE.Icon.Delete}" Stroke="{DynamicResource CE.Danger.Foreground}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform"/></Button><Button Style="{DynamicResource CE.Button.Icon}" ToolTip="Thêm" Margin="0,0,6,0"><Path Data="{DynamicResource CE.Icon.Add}" Stroke="{DynamicResource CE.Text}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform"/></Button></WrapPanel>
  <TextBlock Text="Badge và chấm trạng thái" Style="{DynamicResource CE.SectionHeading}" Margin="0,0,0,8"/>
  <WrapPanel Margin="0,0,0,8"><Border Style="{DynamicResource CE.Badge.Warning}" Margin="0,0,6,6"><TextBlock Text="Chờ khám"/></Border><Border Style="{DynamicResource CE.Badge.Warning}" Margin="0,0,6,6"><TextBlock Text="Chờ thanh toán"/></Border><Border Style="{DynamicResource CE.Badge.Warning}" Margin="0,0,6,6"><TextBlock Text="Hoãn"/></Border><Border Style="{DynamicResource CE.Badge.Info}" Margin="0,0,6,6"><TextBlock Text="Chờ tiêm"/></Border><Border Style="{DynamicResource CE.Badge.Info}" Margin="0,0,6,6"><TextBlock Text="Theo dõi"/></Border><Border Style="{DynamicResource CE.Badge.Success}" Margin="0,0,6,6"><TextBlock Text="Đã khám"/></Border><Border Style="{DynamicResource CE.Badge.Success}" Margin="0,0,6,6"><TextBlock Text="Đang hoạt động"/></Border><Border Style="{DynamicResource CE.Badge.Danger}" Margin="0,0,6,6"><TextBlock Text="Hết hạn"/></Border><Border Style="{DynamicResource CE.Badge.Danger}" Margin="0,0,6,6"><TextBlock Text="Đã khóa"/></Border><Border Style="{DynamicResource CE.Badge.Neutral}" Margin="0,0,6,6"><TextBlock Text="Tạm ngừng"/></Border><Border Style="{DynamicResource CE.Badge.Sample}" Margin="0,0,6,6"><TextBlock Text="Dữ liệu mẫu"/></Border></WrapPanel>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,14"><ContentControl Content="Chờ khám" ContentTemplate="{DynamicResource CE.Badge.Dot.Warning}" Margin="0,0,16,0"/><ContentControl Content="Theo dõi" ContentTemplate="{DynamicResource CE.Badge.Dot.Info}" Margin="0,0,16,0"/><ContentControl Content="Đã khám" ContentTemplate="{DynamicResource CE.Badge.Dot.Success}" Margin="0,0,16,0"/><ContentControl Content="Hết hạn" ContentTemplate="{DynamicResource CE.Badge.Dot.Danger}" Margin="0,0,16,0"/><ContentControl Content="Tạm ngừng" ContentTemplate="{DynamicResource CE.Badge.Dot.Neutral}"/></StackPanel>
  <TextBlock Text="Alert và thông báo" Style="{DynamicResource CE.SectionHeading}" Margin="0,0,0,8"/>
  <ContentControl Style="{DynamicResource CE.Alert.Safety}" Margin="0,0,0,6"><StackPanel Orientation="Horizontal"><TextBlock Text="⚠" Margin="0,0,8,0"/><TextBlock Text="Cảnh báo an toàn — cần đánh giá trước khi tiếp tục" FontWeight="SemiBold"/></StackPanel></ContentControl>
  <ContentControl Style="{DynamicResource CE.Alert.Warning}" Margin="0,0,0,6"><StackPanel Orientation="Horizontal"><TextBlock Text="⚠" Margin="0,0,8,0"/><TextBlock Text="Cảnh báo thông thường"/></StackPanel></ContentControl>
  <ContentControl Style="{DynamicResource CE.Alert.Info}" Margin="0,0,0,6"><StackPanel Orientation="Horizontal"><TextBlock Text="ⓘ" Margin="0,0,8,0"/><TextBlock Text="Thông tin đang được kiểm tra"/></StackPanel></ContentControl>
  <ContentControl Style="{DynamicResource CE.Alert.Success}" Margin="0,0,0,14"><StackPanel Orientation="Horizontal"><TextBlock Text="✓" Margin="0,0,8,0"/><TextBlock Text="Thao tác đã hoàn tất"/></StackPanel></ContentControl>
  <TextBlock Text="Điều hướng và bề mặt" Style="{DynamicResource CE.SectionHeading}" Margin="0,0,0,8"/>
  <StackPanel Orientation="Horizontal" Background="{DynamicResource CE.Surface}" Margin="0,0,0,8"><ToggleButton Content="Nhóm cấp 1" IsChecked="True" Style="{DynamicResource CE.Menu.Level1}"/><ToggleButton Content="Nhóm cấp 2" IsChecked="True" Style="{DynamicResource CE.Menu.Level2}"/><ToggleButton Content="Mục khác" Style="{DynamicResource CE.Menu.Level2}"/></StackPanel>
  <TabControl Style="{DynamicResource CE.TabControl}" Height="80" Margin="0,0,0,10"><TabItem Header="Nhân viên" Style="{DynamicResource CE.Tab}"><TextBlock Text="Nội dung tab" Margin="12"/></TabItem><TabItem Header="Tài khoản" Style="{DynamicResource CE.Tab}"/><TabItem Header="Quyền bổ sung" Style="{DynamicResource CE.Tab}"/></TabControl>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Border Style="{DynamicResource CE.Card}" Width="200" Margin="0,0,8,0"><TextBlock Text="Card thông thường"/></Border><Button Content="Card có thể bấm →" Style="{DynamicResource CE.Card.Clickable}" Width="200"/></StackPanel>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><RadioButton Content="Bình thường" GroupName="segment" IsChecked="True" Style="{DynamicResource CE.SegmentedButton}"/><RadioButton Content="Theo dõi" GroupName="segment" Style="{DynamicResource CE.SegmentedButton.Info}"/><RadioButton Content="Hoãn" GroupName="segment" Style="{DynamicResource CE.SegmentedButton.Warning}"/></StackPanel>
  <Border Style="{DynamicResource CE.Toast}"><TextBlock Text="Thông báo: thao tác đã được ghi nhận"/></Border>
  <TextBlock Text="DataGrid và ListView" Style="{DynamicResource CE.SectionHeading}" Margin="0,16,0,8"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{DynamicResource CE.TableFrame}" Margin="0,0,8,0"><DataGrid Style="{DynamicResource CE.DataGrid}" AutoGenerateColumns="False" Height="110" SelectedIndex="1" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Mã" Binding="{Binding Tag}" Width="*"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Text}" Width="2*"/></DataGrid.Columns><TextBlock Tag="01" Text="Chờ khám"/><TextBlock Tag="02" Text="Đã khám"/></DataGrid></Border>
   <Border Grid.Column="1" Style="{DynamicResource CE.TableFrame}"><ListView Height="110" SelectedIndex="1" Style="{DynamicResource CE.ListView}"><ListViewItem Content="Hàng bình thường"/><ListViewItem Content="Hàng đã chọn"/></ListView></Border>
  </Grid>
 </StackPanel></ScrollViewer>
</Window>
