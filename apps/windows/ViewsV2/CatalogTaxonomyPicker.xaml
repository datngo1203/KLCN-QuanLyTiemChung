<UserControl x:Class="TiemChung.Desktop.ViewsV2.CatalogTaxonomyPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TiemChung.Desktop.ViewsV2"
             x:Name="Picker">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhen"/>
    </UserControl.Resources>
    <StackPanel>
        <ItemsControl ItemsSource="{Binding Selected}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource CE.Selected}" BorderBrush="{StaticResource CE.Border}"
                            BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Bỏ" Click="RemoveItem" Margin="8,0,0,0"
                                    Style="{StaticResource CE.Button.Secondary}" AutomationProperties.Name="{Binding RemoveLabel}"
                                    Visibility="{Binding CanEdit, RelativeSource={RelativeSource AncestorType=local:CatalogTaxonomyPicker}, Converter={StaticResource VisibleWhen}}"/>
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Chưa chọn mục nào." Margin="0,0,0,4">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource CE.Caption}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <StackPanel Visibility="{Binding CanEdit, ElementName=Picker, Converter={StaticResource VisibleWhen}}">
            <TextBox x:Name="SearchBox" Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource CE.TextBox}" Tag="Tìm theo mã hoặc tên" PreviewKeyDown="SearchKeyDown"
                     AutomationProperties.Name="{Binding (AutomationProperties.Name),ElementName=Picker,StringFormat='Tìm {0}'}"/>
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="Matches" ItemsSource="{Binding Results}" TextSearch.TextPath="Label"
                          Style="{StaticResource CE.ComboBox}" PreviewKeyDown="MatchKeyDown" SelectionChanged="MatchChanged"
                          AutomationProperties.Name="{Binding (AutomationProperties.Name),ElementName=Picker,StringFormat='Kết quả tìm {0}'}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="AddButton" Grid.Column="1" Content="Thêm" Click="AddItem" Margin="8,0,0,0" IsEnabled="False"
                        Style="{StaticResource CE.Button.Secondary}" AutomationProperties.Name="{Binding (AutomationProperties.Name),ElementName=Picker,StringFormat='Thêm {0}'}"/>
            </Grid>
            <TextBlock Text="{Binding ResultsHint}" Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
