<UserControl x:Class="TiemChung.Desktop.ViewsV2.CatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime" Language="vi-VN">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Vis"/>
  <Style TargetType="TextBlock" BasedOn="{StaticResource CE.Body}"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="CE.Catalog.Resource" TargetType="ListBoxItem">
   <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Foreground" Value="{StaticResource CE.Text}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Surface" Background="{StaticResource CE.Surface}" BorderBrush="{StaticResource CE.Border}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource CE.Selected}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource CE.Primary}"/><Setter TargetName="Surface" Property="BorderThickness" Value="1,1,1,3"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource CE.Hover}"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource CE.Focus}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid Margin="24" Background="{StaticResource CE.Canvas}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock Text="Danh mục tiêm chủng" Style="{StaticResource CE.Heading}"/><TextBlock Text="{Binding DataSourceLabel}" Style="{StaticResource CE.Caption}" Margin="0,4,0,0"/></StackPanel>
  <ListBox x:Name="ResourcesList" KeyboardNavigation.TabIndex="0" Grid.Row="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding Tab,Mode=OneWay}" IsEnabled="{Binding CanInteract}" SelectionChanged="RestoreResourceSelection" ItemContainerStyle="{StaticResource CE.Catalog.Resource}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Chọn nhóm danh mục">
   <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
  </ListBox>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CE.Card}" Padding="14" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="1"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding Tab}" Style="{StaticResource CE.SectionHeading}" Margin="0,0,0,12"/>
    <DockPanel Grid.Row="1" Margin="0,0,0,8">
     <Button DockPanel.Dock="Right" KeyboardNavigation.TabIndex="2" Content="↻" ToolTip="Tải lại danh sách" AutomationProperties.Name="Tải lại danh sách" Command="{Binding LoadCommand}" Style="{StaticResource CE.Button.Secondary}" Margin="6,0,0,0"/>
     <Button DockPanel.Dock="Right" KeyboardNavigation.TabIndex="1" Content="Tìm" Command="{Binding LoadCommand}" Style="{StaticResource CE.Button.Secondary}" AutomationProperties.Name="Tìm danh mục" Margin="6,0,0,0"/>
     <TextBox KeyboardNavigation.TabIndex="0" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Tag="{Binding SearchHint}" ToolTip="{Binding SearchHint}" IsEnabled="{Binding CanInteract}" Style="{StaticResource CE.TextBox}" AutomationProperties.Name="Tìm theo mã hoặc tên">
      <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding LoadCommand}"/></TextBox.InputBindings>
     </TextBox>
    </DockPanel>
    <DockPanel Grid.Row="2" Margin="0,0,0,12">
     <Button DockPanel.Dock="Right" KeyboardNavigation.TabIndex="4" Content="Thêm mới" Command="{Binding NewCommand}" Style="{StaticResource CE.Button.Secondary}" Margin="8,0,0,0"/>
     <ComboBox KeyboardNavigation.TabIndex="3" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" DisplayMemberPath="Label" IsEnabled="{Binding CanInteract}" Style="{StaticResource CE.ComboBox}" AutomationProperties.Name="Lọc trạng thái" ToolTip="Chọn trạng thái rồi nhấn Tìm hoặc Enter trong ô tìm kiếm"/>
    </DockPanel>
    <Grid Grid.Row="3">
     <DataGrid x:Name="CatalogRows" KeyboardNavigation.TabIndex="5" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected,Mode=OneWay}" SelectionChanged="RestoreRowSelection" PreviewKeyDown="OpenFocusedRow" ToolTip="Enter hoặc Space để mở hàng đang chọn" IsEnabled="{Binding CanInteract}" Style="{StaticResource CE.DataGrid}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" AutomationProperties.Name="Danh sách danh mục" RowHeight="{x:Static sys:Double.NaN}" MinRowHeight="40">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="110"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="6"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
       <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*" MinWidth="80"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="6"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
       <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusLabel}" Width="115"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="6"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
       <DataGridTextColumn x:Name="PriceColumn" Header="Giá VND" Binding="{Binding Price,StringFormat={}{0:N0}}" Width="100"/>
      </DataGrid.Columns>
     </DataGrid>
     <Border Background="{StaticResource CE.Surface}" VerticalAlignment="Center" Padding="16" Visibility="{Binding ShowEmpty,Converter={StaticResource Vis}}"><TextBlock Text="{Binding EmptyMessage}" TextAlignment="Center" Style="{StaticResource CE.Caption}"/></Border>
    </Grid>
   </Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource CE.Card}" Padding="16" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="2"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10">
     <TextBlock Text="{Binding FormTitle}" Style="{StaticResource CE.SectionHeading}"/>
     <TextBlock Text="{Binding EditLabel}" Style="{StaticResource CE.Caption}" Margin="0,4,0,0"/>
     <TextBlock Text="Chỉ xem. Bạn có thể tìm, chọn và đọc danh mục; cần quyền quản lý tương ứng để ghi." Visibility="{Binding IsReadOnly,Converter={StaticResource Vis}}" Style="{StaticResource CE.Caption}" Margin="0,6,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,8">
     <TextBlock Text="Đang tải / xử lý…" Visibility="{Binding IsBusy,Converter={StaticResource Vis}}" Style="{StaticResource CE.Caption}" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     <Button Content="Thử lại tải danh sách" Command="{Binding LoadCommand}" Visibility="{Binding LoadFailed,Converter={StaticResource Vis}}" Style="{StaticResource CE.Button.Secondary}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
    </StackPanel>
    <ScrollViewer x:Name="DetailScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0" Focusable="False"><StackPanel>
     <TextBlock Text="Thông tin danh mục" FontWeight="SemiBold" Margin="0,0,0,12" Visibility="{Binding ShowLookup,Converter={StaticResource Vis}}"/>
     <StackPanel IsEnabled="{Binding CanEdit}">
      <TextBlock Text="Mã nghiệp vụ *"/><TextBox KeyboardNavigation.TabIndex="0" Text="{Binding Code,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CodeReadOnly}" MaxLength="50" Style="{StaticResource CE.TextBox}" AutomationProperties.Name="Mã nghiệp vụ" Margin="0,4,0,10"/>
      <TextBlock Text="Tên *"/><TextBox x:Name="NameInput" KeyboardNavigation.TabIndex="1" Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}" AutomationProperties.Name="Tên danh mục" Margin="0,4,0,10"/>
      <StackPanel Visibility="{Binding ShowLookup,Converter={StaticResource Vis}}">
       <TextBlock Text="Mô tả"/><TextBox KeyboardNavigation.TabIndex="2" Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}" AutomationProperties.Name="Mô tả" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalScrollBarVisibility="Auto" Margin="0,4,0,10"/>
       <TextBlock Text="Trạng thái *"/><ComboBox KeyboardNavigation.TabIndex="3" ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Status}" Style="{StaticResource CE.ComboBox}" AutomationProperties.Name="Trạng thái danh mục" Margin="0,4,0,6"/>
      </StackPanel>
      <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource CE.Caption}" Margin="0,0,0,10"/>
    <StackPanel Visibility="{Binding ShowVaccine,Converter={StaticResource Vis}}">
     <TextBlock Text="Loại vắc xin *"/><ComboBox ItemsSource="{Binding VaccineTypes}" SelectedItem="{Binding VaccineType}" DisplayMemberPath="Name" Style="{StaticResource CE.ComboBox}" AutomationProperties.Name="Loại vắc xin" Margin="0,5,0,10"/>
     <TextBlock Text="Loại tiêm chủng *"/><ComboBox ItemsSource="{Binding InjectionTypes}" SelectedItem="{Binding InjectionType}" DisplayMemberPath="Name" Style="{StaticResource CE.ComboBox}" AutomationProperties.Name="Loại tiêm chủng" Margin="0,5,0,10"/>
     <TextBlock Text="Nhà sản xuất *"/><TextBox Text="{Binding Manufacturer,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}" AutomationProperties.Name="Nhà sản xuất" Margin="0,5,0,10"/>
     <TextBlock Text="Xuất xứ *"/><TextBox Text="{Binding Origin,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}" AutomationProperties.Name="Xuất xứ" Margin="0,5,0,10"/>
    </StackPanel>
    <StackPanel Visibility="{Binding ShowPrice,Converter={StaticResource Vis}}"><TextBlock Text="Đối tượng sử dụng tham khảo *"/><TextBox Text="{Binding TargetAudience,UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Style="{StaticResource CE.TextBox}" AutomationProperties.Name="Đối tượng sử dụng tham khảo" Margin="0,5,0,10"/></StackPanel>
    <StackPanel Visibility="{Binding ShowVaccine,Converter={StaticResource Vis}}">
     <TextBlock Text="Bệnh phòng * (danh mục Active)"/>
     <ItemsControl ItemsSource="{Binding Diseases}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Included}" Margin="0,5"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="Đường dùng *" Margin="0,10,0,0"/><ComboBox ItemsSource="{Binding AdministrationRoutes}" SelectedItem="{Binding AdministrationRoute}" Style="{StaticResource CE.ComboBox}" AutomationProperties.Name="Đường dùng" Margin="0,5,0,10"/>
     <StackPanel Visibility="{Binding ShowRouteNote,Converter={StaticResource Vis}}"><TextBlock Text="Mô tả đường dùng khác *"/><TextBox Text="{Binding AdministrationRouteNote,UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Style="{StaticResource CE.TextBox}" AutomationProperties.Name="Mô tả đường dùng khác" Margin="0,5,0,10"/></StackPanel>
    </StackPanel>
    <StackPanel Visibility="{Binding ShowPrice,Converter={StaticResource Vis}}"><TextBlock Text="Giá VND * (số nguyên, không dấu phân cách)"/><TextBox Text="{Binding Price,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}" AutomationProperties.Name="Giá VND" Margin="0,5,0,10"/></StackPanel>
    <StackPanel Visibility="{Binding ShowPackage,Converter={StaticResource Vis}}"><TextBlock Text="Thành phần gói * — chọn vắc xin, nhập số lượng" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding PackageChoices}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,5"><TextBox DockPanel.Dock="Right" Width="55" Text="{Binding Quantity}" AutomationProperties.Name="Số lượng"/><CheckBox Content="{Binding Name}" IsChecked="{Binding Included}" VerticalAlignment="Center"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
     </StackPanel>
    </StackPanel></ScrollViewer>
    <WrapPanel Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Right">
     <Button KeyboardNavigation.TabIndex="12" Content="Xóa" Command="{Binding DeleteCommand}" Style="{StaticResource CE.Button.Danger}" Margin="0,0,8,6"/>
     <Button KeyboardNavigation.TabIndex="11" Content="Hoàn tác" Command="{Binding RevertCommand}" Style="{StaticResource CE.Button.Secondary}" Margin="0,0,8,6"/>
     <Button KeyboardNavigation.TabIndex="10" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" Style="{StaticResource CE.Button.Primary}" Margin="0,0,0,6"/>
    </WrapPanel>
   </Grid></Border>
  </Grid>
 </Grid>
</UserControl>
