<UserControl x:Class="TiemChung.Desktop.ViewsV2.CatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:TiemChung.Desktop.ViewModels">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Vis"/><DataTemplate DataType="{x:Type vm:CatalogViewModel}"><Grid Margin="28" Background="{StaticResource CE.Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel LastChildFill="False"><StackPanel><TextBlock Text="Danh mục tiêm chủng" Style="{StaticResource CE.Heading}"/><TextBlock Text="Quản lý loại, vắc xin và gói dịch vụ" Style="{StaticResource CE.Caption}" Margin="0,5,0,0"/></StackPanel><Border DockPanel.Dock="Right" Style="{StaticResource CE.Badge.Info}" HorizontalAlignment="Right"><TextBlock Text="{Binding DataSourceLabel}"/></Border></DockPanel>
  <ItemsControl Grid.Row="1" ItemsSource="{Binding Tabs}" Margin="0,20,0,16"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource CE.Button.Secondary}" Margin="0,0,8,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CE.Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Danh sách vắc xin" Style="{StaticResource CE.SectionHeading}"/><DataGrid Grid.Row="1" ItemsSource="{Binding Vaccines}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Tên vắc xin" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Loại" Binding="{Binding VaccineType}" Width="120"/><DataGridTextColumn Header="Nhà sản xuất" Binding="{Binding Manufacturer}" Width="150"/><DataGridTextColumn Header="Giá" Binding="{Binding Price, StringFormat={}{0:N0} đ}" Width="100"/><DataGridTemplateColumn Header="Trạng thái" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Padding="8,3" CornerRadius="10" Background="#FFE5E7EB"><TextBlock Text="{Binding Status}" Foreground="#FF6B7280"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="Chưa có dữ liệu từ nguồn đã kết nối." Style="{StaticResource CE.Caption}" HorizontalAlignment="Center" Margin="0,20,0,4" Visibility="{Binding HasNoData, Converter={StaticResource Vis}}"/></Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource CE.Card}" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Thông tin vắc xin" Style="{StaticResource CE.SectionHeading}" Margin="0,0,0,14"/><TextBlock Text="Tên vắc xin *" Style="{StaticResource CE.Caption}"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}" Margin="0,5,0,10"/><TextBlock Text="Loại vắc xin / Loại tiêm chủng" Style="{StaticResource CE.Caption}"/><ComboBox ItemsSource="{Binding VaccineTypes}" SelectedItem="{Binding VaccineType}" IsEnabled="{Binding CanEditChuyenMon}" Style="{StaticResource CE.ComboBox}" Margin="0,5,0,10"/><TextBlock Text="Loại tiêm chủng *" Style="{StaticResource CE.Caption}"/><ComboBox ItemsSource="{Binding InjectionTypes}" SelectedItem="{Binding InjectionType}" IsEnabled="{Binding CanEditChuyenMon}" Style="{StaticResource CE.ComboBox}" Margin="0,5,0,10"/><TextBlock Text="Nhà sản xuất *" Style="{StaticResource CE.Caption}"/><TextBox Text="{Binding Manufacturer,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}" Margin="0,5,0,10"/><TextBlock Text="Xuất xứ *" Style="{StaticResource CE.Caption}"/><TextBox Text="{Binding Origin,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}" Margin="0,5,0,10"/><TextBlock Text="Liều lượng *" Style="{StaticResource CE.Caption}"/><TextBox IsEnabled="{Binding CanEditChuyenMon}" Text="{Binding Dose,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}" Margin="0,5,0,10"/><TextBlock Text="Thể tích (ml) *" Style="{StaticResource CE.Caption}"/><TextBox IsEnabled="{Binding CanEditChuyenMon}" Text="{Binding Volume,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}" Margin="0,5,0,10"/><TextBlock Text="Phản ứng sau tiêm *" Style="{StaticResource CE.Caption}"/><TextBox IsEnabled="{Binding CanEditChuyenMon}" Text="{Binding Reaction,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}" Height="56" Margin="0,5,0,10"/><TextBlock Text="Giá (VNĐ) *" Style="{StaticResource CE.Caption}"/><TextBox IsEnabled="{Binding CanEditGia}" Text="{Binding Price,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}" Margin="0,5,0,10"/><TextBlock Text="Trạng thái" Style="{StaticResource CE.Caption}"/><ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" IsEnabled="{Binding CanEditGia}" Style="{StaticResource CE.ComboBox}" Margin="0,5,0,10"/><TextBlock Text="Bệnh phòng ngừa *" Style="{StaticResource CE.Caption}"/><ItemsControl ItemsSource="{Binding Diseases}" Margin="0,6"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding}" IsEnabled="{Binding DataContext.CanEditChuyenMon, RelativeSource={RelativeSource AncestorType=UserControl}}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Checked="Disease_Checked" Unchecked="Disease_Unchecked" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding Validation}" Style="{StaticResource CE.Caption}" Margin="0,4"/><TextBlock Text="{Binding Feedback}" Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,4"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button Content="Mới" Command="{Binding NewCommand}" Style="{StaticResource CE.Button.Secondary}" Margin="0,0,8,0"/><Button Content="Lưu" Command="{Binding SaveCommand}" Style="{StaticResource CE.Button.Primary}"/></StackPanel></StackPanel></ScrollViewer></Border>
  </Grid></Grid></DataTemplate></UserControl.Resources><ContentControl Content="{Binding}"/>
</UserControl>
