<UserControl x:Class="TiemChung.Desktop.ViewsV2.CatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Vis"/></UserControl.Resources>
 <Grid Margin="28" Background="{StaticResource CE.Canvas}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Danh mục tiêm chủng" Style="{StaticResource CE.Heading}"/><TextBlock Text="{Binding DataSourceLabel}" Style="{StaticResource CE.Caption}"/></StackPanel>
  <ItemsControl Grid.Row="1" ItemsSource="{Binding Tabs}" Margin="0,16"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource CE.Button.Secondary}" Margin="0,0,8,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <TextBlock Grid.Row="2" Text="{Binding Feedback}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CE.Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel><Button DockPanel.Dock="Right" Content="Tìm / Tải lại" Command="{Binding LoadCommand}" Style="{StaticResource CE.Button.Secondary}"/><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanInteract}" Style="{StaticResource CE.TextBox}" AutomationProperties.Name="Tìm theo tên" Margin="0,0,8,0"/></DockPanel>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" IsEnabled="{Binding CanInteract}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Mã" Binding="{Binding Id}" Width="60"/><DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Giá VND" Binding="{Binding Price,StringFormat={}{0:N0}}" Width="120"/></DataGrid.Columns></DataGrid>
   </Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource CE.Card}" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding CanEdit}">
    <TextBlock Text="{Binding Tab}" Style="{StaticResource CE.SectionHeading}" Margin="0,0,0,12"/>
    <TextBlock Text="Tên *"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}" AutomationProperties.Name="Tên danh mục" Margin="0,5,0,10"/>
    <StackPanel Visibility="{Binding ShowLookup,Converter={StaticResource Vis}}"><TextBlock Text="Mô tả"/><TextBox Text="{Binding Description}" Style="{StaticResource CE.TextBox}" AutomationProperties.Name="Mô tả" Margin="0,5,0,10"/></StackPanel>
    <StackPanel Visibility="{Binding ShowVaccine,Converter={StaticResource Vis}}">
     <TextBlock Text="Loại vắc xin *"/><ComboBox ItemsSource="{Binding VaccineTypes}" SelectedItem="{Binding VaccineType}" DisplayMemberPath="Name" Style="{StaticResource CE.ComboBox}" AutomationProperties.Name="Loại vắc xin" Margin="0,5,0,10"/>
     <TextBlock Text="Loại tiêm chủng *"/><ComboBox ItemsSource="{Binding InjectionTypes}" SelectedItem="{Binding InjectionType}" DisplayMemberPath="Name" Style="{StaticResource CE.ComboBox}" AutomationProperties.Name="Loại tiêm chủng" Margin="0,5,0,10"/>
     <TextBlock Text="Nhà sản xuất *"/><TextBox Text="{Binding Manufacturer}" Style="{StaticResource CE.TextBox}" AutomationProperties.Name="Nhà sản xuất" Margin="0,5,0,10"/>
     <TextBlock Text="Xuất xứ *"/><TextBox Text="{Binding Origin}" Style="{StaticResource CE.TextBox}" AutomationProperties.Name="Xuất xứ" Margin="0,5,0,10"/>
    </StackPanel>
    <StackPanel Visibility="{Binding ShowPrice,Converter={StaticResource Vis}}"><TextBlock Text="Giá VND * (số nguyên, không dấu phân cách)"/><TextBox Text="{Binding Price}" Style="{StaticResource CE.TextBox}" AutomationProperties.Name="Giá VND" Margin="0,5,0,10"/></StackPanel>
    <StackPanel Visibility="{Binding ShowPackage,Converter={StaticResource Vis}}"><TextBlock Text="Thành phần gói * — chọn vắc xin, nhập số lượng" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding PackageChoices}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,5"><TextBox DockPanel.Dock="Right" Width="55" Text="{Binding Quantity}" AutomationProperties.Name="Số lượng"/><CheckBox Content="{Binding Name}" IsChecked="{Binding Included}" VerticalAlignment="Center"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
    <WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Mới" Command="{Binding NewCommand}" Style="{StaticResource CE.Button.Secondary}" Margin="0,0,8,0"/><Button Content="Xóa" Command="{Binding DeleteCommand}" Style="{StaticResource CE.Button.Secondary}" Margin="0,0,8,0"/><Button Content="Lưu" Command="{Binding SaveCommand}" Style="{StaticResource CE.Button.Primary}"/></WrapPanel>
   </StackPanel></ScrollViewer></Border>
  </Grid>
 </Grid>
</UserControl>
