<UserControl x:Class="TiemChung.Desktop.ViewsV2.InventoryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Vis"/></UserControl.Resources>
 <Grid Margin="24" Background="{StaticResource CE.Canvas}">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="*" MinHeight="110"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="90"/>
  </Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Kho &amp; lô vắc xin" Style="{StaticResource CE.Heading}"/>
   <TextBlock Text="API / SQL · Nhập một lô mới từ nhà cung cấp; không điều chỉnh hoặc nhập bổ sung lô cũ."
    TextWrapping="Wrap" Style="{StaticResource CE.Caption}" Margin="0,5,0,8"/>
  </StackPanel>
  <StackPanel Grid.Row="1">
   <TextBlock Text="Cần nhân viên Thủ kho đang hoạt động có quyền XemKho. Đăng nhập và mở lại sau khi được cấp quyền."
    TextWrapping="Wrap" Visibility="{Binding NoAccess,Converter={StaticResource Vis}}" Margin="0,0,0,8"/>
   <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
   <ProgressBar Height="4" IsIndeterminate="True" Visibility="{Binding IsBusy,Converter={StaticResource Vis}}" Margin="0,0,0,8"/>
  </StackPanel>
  <WrapPanel Grid.Row="2" IsEnabled="{Binding CanBrowse}" Margin="0,0,0,8">
   <Button Content="Nhập lô vắc xin" Click="OpenReceiving" IsEnabled="{Binding Receiving.HasAccess}" ToolTip="Cần Thủ kho Active có cả quyền XemKho và NhapKho." ToolTipService.ShowOnDisabled="True" Style="{StaticResource CE.Button.Primary}" Margin="0,0,12,0"/>
   <Label Content="Tìm số lô / vắc xin" Target="{Binding ElementName=SearchBox}" VerticalAlignment="Center"/>
   <TextBox x:Name="SearchBox" Width="220" MaxLength="100" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}"
    Style="{StaticResource CE.TextBox}" Margin="0,0,8,0">
    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ReloadCommand}"/></TextBox.InputBindings>
   </TextBox>
   <Button Content="Tìm / Tải lại" Command="{Binding ReloadCommand}" Style="{StaticResource CE.Button.Primary}"/>
   <Button Content="Trước" Command="{Binding PreviousCommand}" Style="{StaticResource CE.Button.Secondary}" Margin="8,0"/>
   <TextBlock Text="{Binding Page,StringFormat=Trang {0}}" VerticalAlignment="Center"/>
   <Button Content="Sau" Command="{Binding NextCommand}" Style="{StaticResource CE.Button.Secondary}" Margin="8,0"/>
  </WrapPanel>
  <Grid Grid.Row="3">
   <DataGrid ItemsSource="{Binding Batches}" SelectedItem="{Binding Selected}" IsEnabled="{Binding CanBrowse}"
    AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
    AutomationProperties.Name="Lô vắc xin SQL" ScrollViewer.HorizontalScrollBarVisibility="Auto">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Số lô" Binding="{Binding Data.LotNumber}" Width="160"/>
     <DataGridTextColumn Header="Vắc xin" Binding="{Binding Data.VaccineName}" Width="*" MinWidth="150"/>
     <DataGridTextColumn Header="NSX" Binding="{Binding Data.ManufacturedOn,StringFormat={}{0:dd/MM/yyyy}}" Width="100"/>
     <DataGridTextColumn Header="Hạn dùng" Binding="{Binding Data.ExpiresOn,StringFormat={}{0:dd/MM/yyyy}}" Width="100"/>
     <DataGridTextColumn Header="Ban đầu" Binding="{Binding Data.InitialQuantity}" Width="75"/>
     <DataGridTextColumn Header="Tồn" Binding="{Binding Data.Stock}" Width="60"/>
     <DataGridTextColumn Header="Trạng thái SQL" Binding="{Binding Data.Status}" Width="110"/>
     <DataGridTextColumn Header="Hạn / tồn (UTC+7)" Binding="{Binding Availability}" Width="130"/>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Text="Không có lô phù hợp trong SQL." HorizontalAlignment="Center" VerticalAlignment="Center"
    IsHitTestVisible="False" Visibility="{Binding NoBatches,Converter={StaticResource Vis}}"/>
  </Grid>
  <WrapPanel Grid.Row="4" Margin="0,12,0,6">
   <TextBlock Text="Biến động kho" Style="{StaticResource CE.SectionHeading}" VerticalAlignment="Center" Margin="0,0,12,0"/>
   <Button Content="Xem / Thử lại biến động" Command="{Binding MovementsCommand}" Style="{StaticResource CE.Button.Secondary}"/>
   <Button Content="Trước" Command="{Binding PreviousMovementsCommand}" Style="{StaticResource CE.Button.Secondary}" Margin="8,0"/>
   <TextBlock Text="{Binding MovementPage,StringFormat=Trang {0}}" VerticalAlignment="Center"/>
   <Button Content="Sau" Command="{Binding NextMovementsCommand}" Style="{StaticResource CE.Button.Secondary}" Margin="8,0"/>
  </WrapPanel>
  <TextBlock Grid.Row="5" Text="{Binding MovementFeedback}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
  <Grid Grid.Row="6">
   <DataGrid ItemsSource="{Binding Movements}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
    AutomationProperties.Name="Biến động kho SQL" ScrollViewer.HorizontalScrollBarVisibility="Auto">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Mã" Binding="{Binding Data.Id}" Width="60"/>
     <DataGridTextColumn Header="Loại (SQL)" Binding="{Binding Data.Type}" Width="150"/>
     <DataGridTextColumn Header="Số lô" Binding="{Binding Data.LotNumber}" Width="160"/>
     <DataGridTextColumn Header="Số lượng" Binding="{Binding Data.Quantity}" Width="90"/>
     <DataGridTextColumn Header="Thời điểm" Binding="{Binding TimeLabel}" Width="160"/>
     <DataGridTextColumn Header="Nhân viên" Binding="{Binding Data.EmployeeName}" Width="*" MinWidth="140"/>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Text="Lô chưa có biến động trong SQL." HorizontalAlignment="Center" VerticalAlignment="Center"
    IsHitTestVisible="False" Visibility="{Binding NoMovements,Converter={StaticResource Vis}}"/>
  </Grid>
 </Grid>
</UserControl>
