<UserControl x:Class="TiemChung.Desktop.ViewsV2.AppointmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TiemChung.Desktop.ViewModels">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Screens/Appointment.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Vis"/>
        <DataTemplate DataType="{x:Type vm:AppointmentViewModel}">
            <Grid Margin="28" Background="{StaticResource CE.Canvas}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,16"><StackPanel><TextBlock Text="Lịch &amp; nhắc lịch" Style="{StaticResource CE.Heading}"/><TextBlock Text="Quản lý lịch hẹn, trạng thái và lịch sử nhắc" Style="{StaticResource CE.Caption}" Margin="0,5,0,0"/></StackPanel><Border DockPanel.Dock="Right" Style="{StaticResource CE.Badge.Sample}"><TextBlock Text="{Binding DataSourceLabel}"/></Border></DockPanel>
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CE.Card}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Danh sách lịch hẹn" Style="{StaticResource CE.SectionHeading}"/><ListView Grid.Row="1" ItemsSource="{Binding Appointments}" SelectedItem="{Binding Selected}" Style="{StaticResource CE.ListView}" Margin="0,8"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Recipient}" Style="{StaticResource CE.Body}" FontWeight="SemiBold"/><TextBlock Text="{Binding ScheduledAt,StringFormat={}{0:dd/MM/yyyy HH:mm}}" Style="{StaticResource CE.Caption}" Margin="0,3,0,0"/><TextBlock Text="{Binding Location}" Style="{StaticResource CE.Caption}"/><Border Style="{StaticResource A09.StatusBadge}" HorizontalAlignment="Left" Margin="0,4,0,0"><TextBlock Text="{Binding DisplayStatus}"/></Border><TextBlock Text="Đã nhắc gần đây" Visibility="{Binding HasRecentReminder,Converter={StaticResource Vis}}" Style="{StaticResource CE.Caption}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><TextBlock Grid.Row="1" Text="Chưa có lịch hẹn trong nguồn dữ liệu." Visibility="{Binding HasNoAppointments,Converter={StaticResource Vis}}" Style="{StaticResource CE.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Text="{Binding Feedback}" Style="{StaticResource CE.Caption}" TextWrapping="Wrap"/></Grid></Border>
                    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="1.05*"/><RowDefinition Height="14"/><RowDefinition Height="0.95*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource CE.Card}" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><StackPanel Grid.ColumnSpan="2"><TextBlock Text="Tạo / đổi lịch" Style="{StaticResource CE.SectionHeading}"/><TextBlock Text="Người được tiêm" Style="{StaticResource CE.Caption}" Margin="0,10,0,4"/><ComboBox ItemsSource="{Binding Recipients}" SelectedItem="{Binding Recipient}" Style="{StaticResource CE.ComboBox}"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ngày hẹn" Style="{StaticResource CE.Caption}" Margin="0,0,0,4"/><DatePicker SelectedDate="{Binding AppointmentDate}" Style="{StaticResource CE.DatePicker}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Giờ hẹn (07:30–17:30)" Style="{StaticResource CE.Caption}" Margin="0,0,0,4"/><TextBox Text="{Binding Time,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}" Tag="HH:mm"/></StackPanel></Grid><TextBlock Text="Địa điểm" Style="{StaticResource CE.Caption}" Margin="0,10,0,4"/><TextBox Text="{Binding Location,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}"/><TextBlock Text="{Binding Validation}" Style="{StaticResource CE.Caption}" Margin="0,5,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Tạo lịch" Command="{Binding CreateAppointmentCommand}" Style="{StaticResource CE.Button.Primary}" Margin="0,0,8,0"/><Button Content="Đổi lịch" Command="{Binding RescheduleCommand}" Style="{StaticResource CE.Button.Secondary}"/></StackPanel></StackPanel></Grid></Border>
                        <Border Grid.Row="2" Style="{StaticResource CE.Card}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="Lịch sử nhắc" Style="{StaticResource CE.SectionHeading}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}" Style="{StaticResource CE.ComboBox}" Width="120" Margin="0,0,8,0"/><Button Content="Gửi nhắc" Command="{Binding SendReminderCommand}" Style="{StaticResource CE.Button.Primary}"/></StackPanel></DockPanel><DataGrid Grid.Row="1" Style="{StaticResource CE.DataGrid}" ItemsSource="{Binding Selected.Reminders}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,8"><DataGrid.Columns><DataGridTextColumn Header="Kênh" Binding="{Binding Channel}" Width="100"/><DataGridTextColumn Header="Thời điểm" Binding="{Binding SentAt,StringFormat={}{0:dd/MM HH:mm}}" Width="140"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="130"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="1" Text="Chọn lịch để xem lịch sử nhắc." Visibility="{Binding HasNoSelection,Converter={StaticResource Vis}}" Style="{StaticResource CE.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>
    </ResourceDictionary></UserControl.Resources><ContentControl Content="{Binding}"/>
</UserControl>
