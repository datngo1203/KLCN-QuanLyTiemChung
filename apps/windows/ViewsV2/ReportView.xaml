<UserControl x:Class="TiemChung.Desktop.ViewsV2.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TiemChung.Desktop.ViewModels">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="Vis"/>
        <DataTemplate DataType="{x:Type vm:ReportViewModel}">
            <Grid Margin="28" Background="{StaticResource CE.Canvas}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12"><StackPanel><TextBlock Text="Báo cáo" Style="{StaticResource CE.Heading}"/><TextBlock Text="Doanh thu, mũi tiêm và phản ứng" Style="{StaticResource CE.Caption}" Margin="0,4,0,0"/></StackPanel><Border DockPanel.Dock="Right" Style="{StaticResource CE.Badge.Sample}"><TextBlock Text="{Binding DataSourceLabel}"/></Border></DockPanel>
                <Border Grid.Row="1" Style="{StaticResource CE.Card}" Padding="12" Margin="0,0,0,10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><StackPanel><TextBlock Text="Từ ngày" Style="{StaticResource CE.Caption}"/><DatePicker SelectedDate="{Binding FromDate}" Style="{StaticResource CE.DatePicker}" Width="150" Margin="0,4,12,0"/></StackPanel><StackPanel><TextBlock Text="Đến ngày" Style="{StaticResource CE.Caption}"/><DatePicker SelectedDate="{Binding ToDate}" Style="{StaticResource CE.DatePicker}" Width="150" Margin="0,4,12,0"/></StackPanel><Button Content="Tạo báo cáo" Command="{Binding GenerateReportCommand}" Style="{StaticResource CE.Button.Primary}" VerticalAlignment="Bottom"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Visibility="Collapsed"><Button Content="Excel" Command="{Binding ExportCommand}" CommandParameter="Excel" Style="{StaticResource CE.Button.Secondary}" Margin="0,0,6,0"/><Button Content="PDF" Command="{Binding ExportCommand}" CommandParameter="PDF" Style="{StaticResource CE.Button.Secondary}" Margin="0,0,6,0"/><Button Content="CSV" Command="{Binding ExportCommand}" CommandParameter="CSV" Style="{StaticResource CE.Button.Secondary}"/></StackPanel></DockPanel><TextBlock Grid.Row="1" Text="{Binding Validation}" Style="{StaticResource CE.Caption}" Foreground="{StaticResource CE.Danger.Foreground}" Margin="0,4,0,0"/></Grid></Border>
                <TextBlock Grid.Row="2" Text="{Binding Feedback}" Style="{StaticResource CE.Caption}" Margin="0,0,0,8"/>
                <Grid Grid.Row="3" Visibility="{Binding HasData,Converter={StaticResource Vis}}"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CE.Card}" Padding="14" Margin="0,0,8,8"><StackPanel><TextBlock Text="DOANH THU" Style="{StaticResource CE.Caption}"/><TextBlock Text="{Binding Revenue,StringFormat={}{0:N0} đ}" Style="{StaticResource CE.SectionHeading}" Margin="0,5,0,0"/></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource CE.Card}" Padding="14" Margin="0,0,0,8"><StackPanel><TextBlock Text="TỶ LỆ PHẢN ỨNG" Style="{StaticResource CE.Caption}"/><TextBlock Text="{Binding ReactionRate,StringFormat={}{0:0.0}%}" Style="{StaticResource CE.SectionHeading}" Margin="0,5,0,0"/></StackPanel></Border>
                    <Border Grid.Row="1" Style="{StaticResource CE.Card}" Padding="14" Margin="0,0,8,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Số mũi theo loại vắc xin · biểu đồ cột" Style="{StaticResource CE.SectionHeading}"/><ItemsControl Grid.Row="1" ItemsSource="{Binding Doses}" VerticalAlignment="Bottom" Margin="0,12,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="120" VerticalAlignment="Bottom" Margin="6,0"><TextBlock Text="{Binding Doses}" HorizontalAlignment="Center" Style="{StaticResource CE.Caption}"/><Border Height="{Binding BarHeight}" Background="{StaticResource CE.Primary}" CornerRadius="4,4,0,0" Margin="14,4,14,4"/><TextBlock Text="{Binding Vaccine}" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource CE.Caption}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border>
                    <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource CE.Card}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Bảng số mũi theo loại vắc xin" Style="{StaticResource CE.SectionHeading}"/><DataGrid Grid.Row="1" Style="{StaticResource CE.DataGrid}" ItemsSource="{Binding Doses}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,8"><DataGrid.Columns><DataGridTextColumn Header="Loại vắc xin" Binding="{Binding Vaccine}" Width="240"/><DataGridTextColumn Header="Số mũi" Binding="{Binding Doses}" Width="100"/></DataGrid.Columns></DataGrid></Grid></Border>
                </Grid>
                <Border Grid.Row="4" Style="{StaticResource CE.Card}" Padding="14" Margin="0,10,0,0" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Lô sắp hết hạn" Style="{StaticResource CE.SectionHeading}"/><DataGrid Grid.Row="1" Style="{StaticResource CE.DataGrid}" ItemsSource="{Binding ExpiringLots}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,6"><DataGrid.Columns><DataGridTextColumn Header="Số lô" Binding="{Binding LotNumber}" Width="130"/><DataGridTextColumn Header="Vắc xin" Binding="{Binding Vaccine}" Width="280"/><DataGridTextColumn Header="Hạn dùng" Binding="{Binding ExpiresOn,StringFormat={}{0:dd/MM/yyyy}}" Width="120"/><DataGridTextColumn Header="Tồn" Binding="{Binding Stock}" Width="80"/></DataGrid.Columns></DataGrid></Grid></Border>
                <ContentControl Grid.Row="3" Grid.RowSpan="2" Style="{StaticResource CE.Alert.Info}" Visibility="{Binding HasNoData,Converter={StaticResource Vis}}"><StackPanel><TextBlock Text="Chưa có dữ liệu trong khoảng thời gian đã chọn." FontWeight="SemiBold"/><TextBlock Text="Chọn khoảng ngày khác để xem báo cáo." Margin="0,5,0,0"/></StackPanel></ContentControl>
                <ContentControl Grid.Row="3" Grid.RowSpan="2" Style="{StaticResource CE.Alert.Warning}" Visibility="{Binding HasInvalidRange,Converter={StaticResource Vis}}"><TextBlock Text="Khoảng ngày chưa hợp lệ. Sửa bộ lọc để tạo báo cáo." FontWeight="SemiBold"/></ContentControl>
            </Grid>
        </DataTemplate>
    </UserControl.Resources><ContentControl Content="{Binding}"/>
</UserControl>
