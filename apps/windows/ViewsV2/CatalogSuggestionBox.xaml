<UserControl x:Class="TiemChung.Desktop.ViewsV2.CatalogSuggestionBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="SuggestionBox" IsKeyboardFocusWithinChanged="FocusChanged"
             PreviewKeyDown="OnPreviewKeyDown" IsEnabledChanged="EnabledChanged">
    <StackPanel>
        <TextBox x:Name="Input" Style="{StaticResource CE.TextBox}" TextChanged="InputChanged"
                 AutomationProperties.Name="{Binding (AutomationProperties.Name),ElementName=SuggestionBox}"
                 MaxLength="{Binding MaxLength,ElementName=SuggestionBox}"
                 Text="{Binding Text,ElementName=SuggestionBox,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
        <ListBox x:Name="Choices" Visibility="Collapsed" Margin="0,4,0,0" MaxHeight="132"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="{StaticResource CE.Surface}" BorderBrush="{StaticResource CE.Border}"
                 AutomationProperties.Name="Giá trị gợi ý" PreviewMouseLeftButtonUp="ChooseByMouse">
            <ListBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="6,4"/></DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="NoMatch" Visibility="Collapsed" Text="Có thể dùng giá trị vừa nhập."
                   Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel>
</UserControl>
