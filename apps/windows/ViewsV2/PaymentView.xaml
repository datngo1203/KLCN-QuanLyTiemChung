<UserControl x:Class="TiemChung.Desktop.ViewsV2.PaymentView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Language="vi-VN">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Screens/Payment.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Visible"/></ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24"><StackPanel>
  <TextBlock Text="THU NGÂN / A08" Style="{StaticResource CE.Caption}"/>
  <TextBlock Text="Ghi nhận thanh toán" Style="{StaticResource CE.Heading}" Margin="0,4,0,8"/>
  <TextBlock Text="API / SQL · Thanh toán toàn bộ một lần · Mô phỏng" Style="{StaticResource CE.Caption}" Margin="0,0,0,12"/>
  <ContentControl Style="{StaticResource CE.Alert.Warning}" Margin="0,0,0,16"><TextBlock Text="Chỉ ghi nhận mô phỏng phục vụ hệ thống; không xử lý hoặc xác nhận tiền thật." TextWrapping="Wrap"/></ContentControl>
  <ContentControl Style="{StaticResource CE.Alert.Warning}" Visibility="{Binding NoAccess, Converter={StaticResource Visible}}"><TextBlock Text="Thiếu phiên hoặc quyền. Chỉ nhân viên Active chức danh Thu ngân có XemThanhToan được tra cứu; cần thêm GhiThanhToan để ghi nhận. Vui lòng đăng nhập bằng tài khoản phù hợp." TextWrapping="Wrap"/></ContentControl>
  <Grid Visibility="{Binding HasAccess, Converter={StaticResource Visible}}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CE.Card}" VerticalAlignment="Top"><StackPanel>
    <TextBlock Text="Tra cứu đăng ký" Style="{StaticResource CE.SectionHeading}" Margin="0,0,0,8"/>
    <TextBlock Text="Mã đăng ký, khách hàng hoặc người được tiêm" Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,0,0,4"/>
    <TextBox x:Name="SearchInput" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Style="{StaticResource CE.TextBox}" AutomationProperties.Name="Tìm đăng ký thanh toán" IsEnabled="{Binding CanBrowse}">
     <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
    </TextBox>
    <WrapPanel Margin="0,8,0,8"><Button Content="_Tìm" Command="{Binding SearchCommand}" Style="{StaticResource CE.Button.Primary}" Margin="0,0,8,4"/><Button Content="Tải lại" Command="{Binding ReloadCommand}" Style="{StaticResource CE.Button.Secondary}" Margin="0,0,0,4"/></WrapPanel>
    <TextBlock Text="{Binding ListFeedback}" TextWrapping="Wrap" Style="{StaticResource CE.Caption}" Margin="0,0,0,8"/>
    <TextBlock Text="Không có kết quả." Visibility="{Binding NoResults, Converter={StaticResource Visible}}" Style="{StaticResource CE.Caption}"/>
    <ListBox ItemsSource="{Binding Registrations}" SelectedItem="{Binding SelectedRegistration}" SelectionChanged="RegistrationChanged" IsEnabled="{Binding CanBrowse}" ItemContainerStyle="{StaticResource Payment.ListItem}" MaxHeight="380" MinHeight="100" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Danh sách đăng ký thanh toán">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,4">
      <TextBlock Text="{Binding Code}" Style="{StaticResource CE.Body}" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Customer.FullName, StringFormat=Khách hàng: {0}}" Style="{StaticResource CE.Caption}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Recipient.FullName, StringFormat=Người tiêm: {0}}" Style="{StaticResource CE.Body}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding TotalDue, StringFormat={}{0:N0} đ}" Style="{StaticResource CE.Body}"/>
      <TextBlock Text="{Binding State}" Style="{StaticResource CE.Caption}" TextWrapping="Wrap"/>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <WrapPanel Margin="0,12,0,0"><Button Content="Trước" Command="{Binding PreviousCommand}" Style="{StaticResource CE.Button.Secondary}"/><TextBlock Text="{Binding Page, StringFormat=Trang {0}}" VerticalAlignment="Center" Margin="8,0"/><Button Content="Sau" Command="{Binding NextCommand}" Style="{StaticResource CE.Button.Secondary}"/></WrapPanel>
   </StackPanel></Border>
   <StackPanel Grid.Column="2">
    <ContentControl Style="{StaticResource CE.Alert.Info}" Visibility="{Binding IsReadOnly, Converter={StaticResource Visible}}" Margin="0,0,0,12"><TextBlock Text="Bạn có quyền xem. Có thể tìm và chọn đăng ký; ghi nhận cần quyền GhiThanhToan." TextWrapping="Wrap"/></ContentControl>
    <ContentControl Style="{StaticResource CE.Alert.Info}" Visibility="{Binding NoSelection, Converter={StaticResource Visible}}"><TextBlock Text="Chọn đăng ký để kiểm tra khách hàng, người được tiêm, dịch vụ và số tiền." TextWrapping="Wrap"/></ContentControl>
    <Border Style="{StaticResource CE.Card}" Visibility="{Binding HasSelection, Converter={StaticResource Visible}}"><StackPanel>
     <TextBlock Text="{Binding SelectedRegistration.Code}" Style="{StaticResource CE.SectionHeading}"/>
     <TextBlock Text="{Binding Feedback}" Style="{StaticResource CE.Body}" TextWrapping="Wrap" Margin="0,8" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock Text="Đang tải dữ liệu…" Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" Style="{StaticResource CE.Caption}"/>
     <Button Content="Đối chiếu bằng _GET / Thử lại" Command="{Binding ReconcileCommand}" Style="{StaticResource CE.Button.Secondary}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
     <StackPanel x:Name="DetailPanel" DataContext="{Binding Detail}">
      <TextBlock Text="{Binding Customer.FullName, StringFormat=Khách hàng: {0}}" Style="{StaticResource CE.Body}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Recipient.FullName, StringFormat=Người được tiêm: {0}}" Style="{StaticResource CE.Body}" TextWrapping="Wrap" Margin="0,4,0,12"/>
      <TextBlock Text="Dịch vụ và giá chốt" Style="{StaticResource CE.SectionHeading}" Margin="0,0,0,8"/>
      <ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource CE.Border}" BorderThickness="0,0,0,1" Padding="0,4,0,8" Margin="0,0,0,8"><StackPanel>
       <TextBlock Text="{Binding KindLabel}" Style="{StaticResource CE.Caption}"/>
       <TextBlock Text="{Binding Name}" Style="{StaticResource CE.Body}" TextWrapping="Wrap"/>
       <WrapPanel><TextBlock Text="{Binding Quantity, StringFormat=SL: {0}}" Margin="0,0,12,0"/><TextBlock Text="{Binding UnitPrice, StringFormat=Giá chốt: {0:N0} đ}"/></WrapPanel>
       <TextBlock Text="{Binding LineTotal, StringFormat=Thành tiền: {0:N0} đ}" Style="{StaticResource CE.Body}"/>
       <TextBlock Text="{Binding ComponentLabel}" Style="{StaticResource CE.Caption}" TextWrapping="Wrap"/>
      </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <WrapPanel Margin="0,4,0,12">
       <StackPanel Margin="0,0,20,8"><TextBlock Text="Tổng phải thu" Style="{StaticResource CE.Caption}"/><TextBlock Text="{Binding TotalDue, StringFormat={}{0:N0} đ}" Style="{StaticResource CE.SectionHeading}"/></StackPanel>
       <StackPanel Margin="0,0,20,8"><TextBlock Text="Đã ghi nhận" Style="{StaticResource CE.Caption}"/><TextBlock Text="{Binding PaidAmount, StringFormat={}{0:N0} đ}" Style="{StaticResource CE.SectionHeading}"/></StackPanel>
       <StackPanel Margin="0,0,0,8"><TextBlock Text="Còn lại" Style="{StaticResource CE.Caption}"/><TextBlock Text="{Binding RemainingAmount, StringFormat={}{0:N0} đ}" Style="{StaticResource CE.SectionHeading}"/></StackPanel>
      </WrapPanel>
      <TextBlock Text="{Binding State}" Style="{StaticResource CE.Body}" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding RecordedLabel}" Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,4,0,8"/>
     </StackPanel>
     <TextBlock Text="Kết quả POST chưa xác định. Đối chiếu bằng GET trước khi quyết định ghi lại." Visibility="{Binding UnknownOutcome, Converter={StaticResource Visible}}" TextWrapping="Wrap" Foreground="{StaticResource CE.Danger.Foreground}" Margin="0,8"/>
     <Button Content="Đã đối chiếu — xác nhận rủi ro ghi lại" Click="AcknowledgeRisk" IsEnabled="{Binding CanAcknowledgeRisk}" Visibility="{Binding UnknownOutcome, Converter={StaticResource Visible}}" Style="{StaticResource CE.Button.Secondary}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
     <Button x:Name="RecordButton" Click="ConfirmPayment" IsEnabled="{Binding CanRecord}" Style="{StaticResource CE.Button.Primary}" HorizontalAlignment="Left" Margin="0,8,0,0"><TextBlock Text="Ghi nhận thanh toán mô phỏng" TextWrapping="Wrap"/></Button>
     <TextBlock Text="Đang gửi. Không đóng ứng dụng hoặc gửi lại; nếu mất phản hồi hãy dùng GET đối chiếu." Visibility="{Binding IsSaving, Converter={StaticResource Visible}}" TextWrapping="Wrap" Style="{StaticResource CE.Caption}" Margin="0,8,0,0"/>
    </StackPanel></Border>
   </StackPanel>
  </Grid>
 </StackPanel></ScrollViewer>
</UserControl>
