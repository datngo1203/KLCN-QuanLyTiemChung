<UserControl x:Class="TiemChung.Desktop.ViewsV2.PaymentView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TiemChung.Desktop.ViewsV2" Language="vi-VN">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Screens/Payment.xaml"/></ResourceDictionary.MergedDictionaries>
   <BooleanToVisibilityConverter x:Key="Visible"/>
   <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CE.Caption}">
    <Setter Property="Margin" Value="0,8,0,4"/><Setter Property="TextWrapping" Value="Wrap"/>
   </Style>
   <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource CE.Card}">
    <Setter Property="Margin" Value="0,12,0,0"/>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24"><StackPanel>
  <TextBlock Text="THU NGÂN" Style="{StaticResource CE.Caption}"/>
  <TextBlock Text="Thanh toán dịch vụ" Style="{StaticResource CE.Heading}" Margin="0,4,0,8"/>
  <TextBlock Text="Thanh toán toàn bộ số tiền của đăng ký" Style="{StaticResource CE.Caption}" Margin="0,0,0,16"/>
  <ContentControl Style="{StaticResource CE.Alert.Warning}" Visibility="{Binding NoAccess, Converter={StaticResource Visible}}"><TextBlock Text="Tài khoản chưa có quyền xem thanh toán. Vui lòng đăng nhập bằng tài khoản Thu ngân phù hợp." TextWrapping="Wrap"/></ContentControl>
  <Grid Visibility="{Binding HasAccess, Converter={StaticResource Visible}}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CE.Card}" VerticalAlignment="Top"><StackPanel>
    <TextBlock Text="Tra cứu đăng ký" Style="{StaticResource CE.SectionHeading}" Margin="0,0,0,8"/>
    <TextBlock Text="Mã đăng ký, khách hàng hoặc người được tiêm" Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,0,0,4"/>
    <TextBox x:Name="SearchInput" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Style="{StaticResource CE.TextBox}" AutomationProperties.Name="Tìm đăng ký thanh toán" IsEnabled="{Binding CanBrowse}">
     <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
    </TextBox>
    <WrapPanel Margin="0,8,0,8"><Button Content="_Tìm" Command="{Binding SearchCommand}" Style="{StaticResource CE.Button.Primary}" Margin="0,0,8,4"/><Button Content="Tải lại" Command="{Binding ReloadCommand}" Style="{StaticResource CE.Button.Secondary}" Margin="0,0,0,4"/></WrapPanel>
    <TextBlock Text="{Binding ListFeedback}" TextWrapping="Wrap" Style="{StaticResource CE.Caption}" Margin="0,0,0,8"/>
    <TextBlock Text="Không có kết quả." Visibility="{Binding NoResults, Converter={StaticResource Visible}}" Style="{StaticResource CE.Caption}"/>
    <ListBox ItemsSource="{Binding Registrations}" SelectedItem="{Binding SelectedRegistration, Mode=OneWay}" SelectionChanged="RegistrationChanged" IsEnabled="{Binding CanBrowse}" ItemContainerStyle="{StaticResource Payment.ListItem}" MaxHeight="380" MinHeight="100" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Danh sách đăng ký thanh toán">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,4">
      <TextBlock Text="{Binding Code}" Style="{StaticResource CE.Body}" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Customer.FullName, StringFormat=Khách hàng: {0}}" Style="{StaticResource CE.Caption}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Recipient.FullName, StringFormat=Người tiêm: {0}}" Style="{StaticResource CE.Body}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Subtotal, StringFormat=Dịch vụ: {0:N0} đ}" Style="{StaticResource CE.Caption}"/>
      <TextBlock Text="{Binding ConsultationFeeLabel, StringFormat=Phí khám/tư vấn: {0}}" Style="{StaticResource CE.Caption}"/>
      <TextBlock Text="{Binding TotalDue, StringFormat=Tổng phải thu: {0:N0} đ}" Style="{StaticResource CE.Body}"/>
      <TextBlock Text="{Binding State}" Style="{StaticResource CE.Caption}" TextWrapping="Wrap"/>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <WrapPanel Margin="0,12,0,0"><Button Content="Trước" Command="{Binding PreviousCommand}" Style="{StaticResource CE.Button.Secondary}"/><TextBlock Text="{Binding Page, StringFormat=Trang {0}}" VerticalAlignment="Center" Margin="8,0"/><Button Content="Sau" Command="{Binding NextCommand}" Style="{StaticResource CE.Button.Secondary}"/></WrapPanel>
   </StackPanel></Border>
   <StackPanel Grid.Column="2">
    <ContentControl Style="{StaticResource CE.Alert.Info}" Visibility="{Binding IsReadOnly, Converter={StaticResource Visible}}" Margin="0,0,0,12"><TextBlock Text="Bạn có thể tra cứu đăng ký và biên nhận. Tài khoản chưa có quyền xác nhận thanh toán." TextWrapping="Wrap"/></ContentControl>
    <ContentControl Style="{StaticResource CE.Alert.Info}" Visibility="{Binding NoSelection, Converter={StaticResource Visible}}"><TextBlock Text="Chọn đăng ký để kiểm tra khách hàng, người được tiêm, dịch vụ và số tiền." TextWrapping="Wrap"/></ContentControl>
    <Border Style="{StaticResource CE.Card}" Visibility="{Binding HasSelection, Converter={StaticResource Visible}}"><StackPanel>
     <TextBlock Text="{Binding SelectedRegistration.Code, StringFormat=Thông tin đăng ký · {0}}" Style="{StaticResource CE.SectionHeading}" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding Feedback}" Style="{StaticResource CE.Body}" TextWrapping="Wrap" Margin="0,8" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock Text="Đang tải dữ liệu…" Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" Style="{StaticResource CE.Caption}"/>
     <Button Content="_Đối chiếu thanh toán" Command="{Binding ReconcileCommand}" Style="{StaticResource CE.Button.Secondary}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
     <StackPanel x:Name="DetailPanel" DataContext="{Binding Detail}">
      <StackPanel.Style>
       <Style TargetType="StackPanel">
        <Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
       </Style>
      </StackPanel.Style>
      <TextBlock Text="{Binding Customer.FullName, StringFormat=Khách hàng: {0}}" Style="{StaticResource CE.Body}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Recipient.FullName, StringFormat=Người được tiêm: {0}}" Style="{StaticResource CE.Body}" TextWrapping="Wrap" Margin="0,4,0,12"/>
      <TextBlock Text="{Binding ExpectedChannelLabel, StringFormat=Kênh dự kiến: {0}}" Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock Text="Dịch vụ và giá chốt" Style="{StaticResource CE.SectionHeading}" Margin="0,0,0,8"/>
      <ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource CE.Border}" BorderThickness="0,0,0,1" Padding="0,4,0,8" Margin="0,0,0,8"><StackPanel>
       <TextBlock Text="{Binding KindLabel}" Style="{StaticResource CE.Caption}"/>
       <TextBlock Text="{Binding Name}" Style="{StaticResource CE.Body}" TextWrapping="Wrap"/>
       <WrapPanel><TextBlock Text="{Binding Quantity, StringFormat=SL: {0}}" Margin="0,0,12,0"/><TextBlock Text="{Binding UnitPrice, StringFormat=Giá chốt: {0:N0} đ}"/></WrapPanel>
       <TextBlock Text="{Binding LineTotal, StringFormat=Thành tiền: {0:N0} đ}" Style="{StaticResource CE.Body}"/>
       <TextBlock Text="{Binding ComponentLabel}" Style="{StaticResource CE.Caption}" TextWrapping="Wrap"/>
      </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <WrapPanel Margin="0,4,0,12">
       <StackPanel Margin="0,0,20,8"><TextBlock Text="Tạm tính dịch vụ" Style="{StaticResource CE.Caption}"/><TextBlock Text="{Binding Subtotal, StringFormat={}{0:N0} đ}"/></StackPanel>
       <StackPanel Margin="0,0,20,8"><TextBlock Text="Phí khám/tư vấn" Style="{StaticResource CE.Caption}"/><TextBlock Text="{Binding ConsultationFeeLabel}"/></StackPanel>
       <StackPanel Margin="0,0,20,8"><TextBlock Text="Tổng phải thu" Style="{StaticResource CE.Caption}"/><TextBlock Text="{Binding TotalDue, StringFormat={}{0:N0} đ}" Style="{StaticResource CE.SectionHeading}"/></StackPanel>
       <StackPanel Margin="0,0,20,8"><TextBlock Text="Đã thu" Style="{StaticResource CE.Caption}"/><TextBlock Text="{Binding PaidAmount, StringFormat={}{0:N0} đ}" Style="{StaticResource CE.SectionHeading}"/></StackPanel>
       <StackPanel Margin="0,0,0,8"><TextBlock Text="Còn lại" Style="{StaticResource CE.Caption}"/><TextBlock Text="{Binding RemainingAmount, StringFormat={}{0:N0} đ}" Style="{StaticResource CE.SectionHeading}"/></StackPanel>
      </WrapPanel>
      <TextBlock Text="{Binding State}" Style="{StaticResource CE.Body}" FontWeight="SemiBold" TextWrapping="Wrap"/>
     </StackPanel>
     <Button Content="Đã đối chiếu, mở lại thanh toán" Click="AcknowledgeRisk" IsEnabled="{Binding CanAcknowledgeRisk}" Visibility="{Binding UnknownOutcome, Converter={StaticResource Visible}}" Style="{StaticResource CE.Button.Secondary}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
     <TextBlock Text="Vui lòng chờ xác nhận kết quả." Visibility="{Binding IsSaving, Converter={StaticResource Visible}}" TextWrapping="Wrap" Style="{StaticResource CE.Caption}" Margin="0,8,0,0"/>
    </StackPanel></Border>

    <StackPanel Visibility="{Binding ShowEditor, Converter={StaticResource Visible}}" IsEnabled="{Binding CanRecord}">
     <StackPanel DataContext="{Binding Draft}">
      <Border Style="{StaticResource SectionCard}"><StackPanel>
       <TextBlock Text="Người thanh toán" Style="{StaticResource CE.SectionHeading}"/>
       <TextBlock Text="Điền từ liên hệ của đăng ký. Có thể điều chỉnh cho giao dịch này." Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,4,0,6"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="Họ và tên *" Style="{StaticResource FieldLabel}"/>
         <TextBox AutomationProperties.Name="Họ tên người thanh toán" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" Style="{StaticResource CE.TextBox}"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
         <TextBlock Text="Điện thoại *" Style="{StaticResource FieldLabel}"/>
         <TextBox AutomationProperties.Name="Điện thoại người thanh toán" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="11" Style="{StaticResource CE.TextBox}"/>
        </StackPanel>
       </Grid>
       <Expander Header="Email và địa chỉ (tùy chọn)" Margin="0,12,0,0"><StackPanel>
        <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
        <TextBox AutomationProperties.Name="Email người thanh toán" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="254" Style="{StaticResource CE.TextBox}"/>
        <TextBlock Text="Tỉnh / thành phố" Style="{StaticResource FieldLabel}"/>
        <TextBox AutomationProperties.Name="Tỉnh thành người thanh toán" Text="{Binding ProvinceCity, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Style="{StaticResource CE.TextBox}"/>
        <TextBlock Text="Phường / xã" Style="{StaticResource FieldLabel}"/>
        <TextBox AutomationProperties.Name="Phường xã người thanh toán" Text="{Binding WardCommune, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Style="{StaticResource CE.TextBox}"/>
        <TextBlock Text="Địa chỉ" Style="{StaticResource FieldLabel}"/>
        <TextBox AutomationProperties.Name="Địa chỉ người thanh toán" Text="{Binding AddressLine, UpdateSourceTrigger=PropertyChanged}" MaxLength="250" Style="{StaticResource CE.TextBox}"/>
       </StackPanel></Expander>
      </StackPanel></Border>

      <Border Style="{StaticResource SectionCard}"><StackPanel>
       <TextBlock Text="Phương thức tại trung tâm" Style="{StaticResource CE.SectionHeading}" TextWrapping="Wrap"/>
       <ComboBox AutomationProperties.Name="Phương thức thanh toán" ItemsSource="{Binding Methods}"
        SelectedValuePath="Code" SelectedValue="{Binding Method, Mode=TwoWay}" Style="{StaticResource CE.ComboBox}"
        ItemContainerStyle="{StaticResource CE.ComboBoxItem}" Margin="0,8,0,6">
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
       </ComboBox>
       <StackPanel Visibility="{Binding IsCash, Converter={StaticResource Visible}}">
        <TextBlock Text="Khách đưa (VND) *" Style="{StaticResource FieldLabel}"/>
        <local:VndMoneyInput AutomationProperties.Name="Số tiền khách đưa" RawText="{Binding Cash, UpdateSourceTrigger=PropertyChanged}" MaxLength="24" Style="{StaticResource CE.TextBox}"/>
        <TextBlock Text="{Binding ChangeLabel, StringFormat=Tiền trả lại: {0}}" Style="{StaticResource CE.Body}" Margin="0,8,0,0"/>
       </StackPanel>
       <StackPanel Visibility="{Binding IsCard, Converter={StaticResource Visible}}">
        <TextBlock Text="Loại thẻ *" Style="{StaticResource FieldLabel}"/>
        <ComboBox AutomationProperties.Name="Loại thẻ" ItemsSource="{Binding Brands}" SelectedItem="{Binding Brand}"
         Style="{StaticResource CE.ComboBox}" ItemContainerStyle="{StaticResource CE.ComboBoxItem}"/>
        <TextBlock Text="Chủ thẻ *" Style="{StaticResource FieldLabel}"/>
        <TextBox AutomationProperties.Name="Chủ thẻ" Text="{Binding Cardholder, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" Style="{StaticResource CE.TextBox}"/>
        <TextBlock Text="Số thẻ *" Style="{StaticResource FieldLabel}"/>
        <TextBox AutomationProperties.Name="Số thẻ" Text="{Binding CardNumber, UpdateSourceTrigger=PropertyChanged}"
         TextChanged="FormatCardNumber" PreviewKeyDown="CardNumberKeyDown" MaxLength="23" Style="{StaticResource CE.TextBox}"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="Tháng hết hạn (MM) *" Style="{StaticResource FieldLabel}"/>
          <TextBox AutomationProperties.Name="Tháng hết hạn" Text="{Binding Month, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" Style="{StaticResource CE.TextBox}"/>
         </StackPanel>
         <StackPanel Grid.Column="2">
          <TextBlock Text="Năm hết hạn (YYYY) *" Style="{StaticResource FieldLabel}"/>
          <TextBox AutomationProperties.Name="Năm hết hạn" Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" Style="{StaticResource CE.TextBox}"/>
         </StackPanel>
        </Grid>
        <TextBlock Text="Mã xác thực giao dịch *" Style="{StaticResource FieldLabel}"/>
        <TextBox AutomationProperties.Name="Mã xác thực giao dịch" Text="{Binding Authorization, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Style="{StaticResource CE.TextBox}"/>
       </StackPanel>
       <StackPanel Visibility="{Binding IsTransfer, Converter={StaticResource Visible}}">
        <TextBlock Text="Ngân hàng hoặc ví *" Style="{StaticResource FieldLabel}"/>
        <TextBox AutomationProperties.Name="Ngân hàng hoặc ví" Text="{Binding Provider, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Style="{StaticResource CE.TextBox}"/>
        <TextBlock Text="Chủ tài khoản *" Style="{StaticResource FieldLabel}"/>
        <TextBox AutomationProperties.Name="Chủ tài khoản" Text="{Binding Holder, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" Style="{StaticResource CE.TextBox}"/>
        <TextBlock Text="Tài khoản hoặc định danh ví *" Style="{StaticResource FieldLabel}"/>
        <TextBox AutomationProperties.Name="Tài khoản hoặc định danh ví" Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Style="{StaticResource CE.TextBox}"/>
        <TextBlock Text="Mã tham chiếu chuyển khoản *" Style="{StaticResource FieldLabel}"/>
        <TextBox AutomationProperties.Name="Mã tham chiếu chuyển khoản" Text="{Binding TransferReference, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Style="{StaticResource CE.TextBox}"/>
       </StackPanel>
      </StackPanel></Border>
     </StackPanel>
     <Border Style="{StaticResource SectionCard}"><StackPanel>
      <TextBlock Text="Xem lại và xác nhận" Style="{StaticResource CE.SectionHeading}"/>
      <TextBlock Text="{Binding Detail.TotalDue, StringFormat=Thanh toán toàn bộ: {0:N0} đ}" Style="{StaticResource CE.Body}" Margin="0,4,0,0"/>
      <TextBlock Text="{Binding Draft.Error}" Foreground="{StaticResource CE.Danger.Foreground}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <Button x:Name="RecordButton" Content="_Xem lại thanh toán" Click="ConfirmPayment"
       Style="{StaticResource CE.Button.Primary}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
     </StackPanel></Border>
    </StackPanel>

    <Border x:Name="PendingPanel" Style="{StaticResource SectionCard}"
     Visibility="{Binding Detail.IsPending, Converter={StaticResource Visible}, FallbackValue=Collapsed}"><StackPanel>
     <TextBlock Text="Chuyển khoản chờ xác nhận" Style="{StaticResource CE.SectionHeading}" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding Detail.Payment.Code, StringFormat=Mã giao dịch: {0}}" TextWrapping="Wrap" Margin="0,4,0,0"/>
     <TextBlock Text="{Binding Detail.Payment.Provider, StringFormat=Nguồn: {0}}" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding Detail.Payment.Reference, StringFormat=Tham chiếu: {0}}" TextWrapping="Wrap"/>
     <Button Content="_Xác nhận đã nhận tiền" Click="ConfirmPayment" Visibility="{Binding ShowPendingAction, Converter={StaticResource Visible}}"
      IsEnabled="{Binding CanConfirmPending}" Style="{StaticResource CE.Button.Primary}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
    </StackPanel></Border>

    <Border x:Name="Receipt" Style="{StaticResource SectionCard}"
     Visibility="{Binding Detail.HasReceipt, Converter={StaticResource Visible}, FallbackValue=Collapsed}"
     Focusable="True" KeyboardNavigation.IsTabStop="False"><StackPanel DataContext="{Binding Detail}">
     <TextBlock Text="Biên nhận thanh toán" Style="{StaticResource CE.SectionHeading}" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding Payment.Code, StringFormat=Mã giao dịch: {0}}" Style="{StaticResource CE.Body}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
     <TextBlock Text="{Binding Code, StringFormat=Đăng ký: {0}}"/>
     <TextBlock Text="{Binding Recipient.FullName, StringFormat=Người được tiêm: {0}}" TextWrapping="Wrap"/>
     <ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate>
      <TextBlock TextWrapping="Wrap"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{Binding Quantity, Mode=OneWay, StringFormat= × {0}}"/><Run Text="{Binding LineTotal, Mode=OneWay, StringFormat= · {0:N0} đ}"/></TextBlock>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="{Binding ConsultationFeeLabel, StringFormat=Phí khám/tư vấn: {0}}"/>
     <TextBlock Text="{Binding TotalDue, StringFormat=Tổng phải thu: {0:N0} đ}"/>
     <StackPanel DataContext="{Binding Payment}" Margin="0,8,0,0">
      <TextBlock Text="{Binding MethodLabel, StringFormat=Phương thức: {0}}" TextWrapping="Wrap"/>
      <StackPanel Visibility="{Binding HasPayer, Converter={StaticResource Visible}}">
       <TextBlock Text="{Binding Payer.FullName, StringFormat=Người thanh toán: {0}}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Payer.PhoneNumber}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Payer.Email}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding PayerAddress}" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Visibility="{Binding HasProvider, Converter={StaticResource Visible}}">
       <TextBlock Text="{Binding Provider, StringFormat=Nguồn: {0}}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding HolderName, StringFormat=Chủ thẻ / tài khoản: {0}}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding MaskedIdentifier, StringFormat=Định danh: {0}}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Reference, StringFormat=Tham chiếu: {0}}" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Visibility="{Binding HasCash, Converter={StaticResource Visible}}">
       <TextBlock Text="{Binding CashTendered, StringFormat=Khách đưa: {0:N0} đ}"/>
       <TextBlock Text="{Binding ChangeAmount, StringFormat=Trả lại: {0:N0} đ}"/>
      </StackPanel>
      <TextBlock Text="{Binding Amount, StringFormat=Số tiền đã thu: {0:N0} đ}" Style="{StaticResource CE.SectionHeading}" Margin="0,4,0,0"/>
      <TextBlock Text="{Binding EmployeeId, StringFormat=Nhân viên #{0}}"/>
      <TextBlock Text="{Binding OccurredLabel, StringFormat=Giờ Việt Nam: {0}}" TextWrapping="Wrap"/>
      <TextBlock Text="Đã thanh toán" Style="{StaticResource CE.Caption}" Margin="0,4,0,0"/>
     </StackPanel>
    </StackPanel></Border>
   </StackPanel>
  </Grid>
  <TextBlock Text="Thanh toán trong môi trường thử nghiệm, không kết nối cổng thanh toán thực tế."
   Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,16,0,0"/>
 </StackPanel></ScrollViewer>
</UserControl>
