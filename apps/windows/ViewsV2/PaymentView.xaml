<UserControl x:Class="TiemChung.Desktop.ViewsV2.PaymentView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Language="vi-VN">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Screens/Payment.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Visible"/></ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24"><StackPanel>
  <TextBlock Text="TIẾP NHẬN / A08" Style="{StaticResource CE.Caption}"/>
  <TextBlock Text="Thu ngân &amp; thanh toán" Style="{StaticResource CE.Heading}" Margin="0,4,0,8"/>
  <Border Style="{StaticResource CE.Badge.Sample}" HorizontalAlignment="Left" Margin="0,0,0,16"><TextBlock Text="{Binding DataSourceLabel}"/></Border>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource CE.Card}" VerticalAlignment="Top"><StackPanel>
    <TextBlock Text="Tìm phiếu đăng ký" Style="{StaticResource CE.SectionHeading}" Margin="0,0,0,12"/>
    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}" AutomationProperties.Name="Tìm phiếu đăng ký"/>
    <Button Content="Tìm phiếu" Command="{Binding TimPhieuCommand}" Style="{StaticResource CE.Button.Secondary}" HorizontalAlignment="Left" Margin="0,8,0,8"/>
    <TextBlock Text="Không tìm thấy phiếu đăng ký." Visibility="{Binding NoResults, Converter={StaticResource Visible}}" Style="{StaticResource CE.Caption}" Margin="0,8"/>
    <ListBox ItemsSource="{Binding FilteredInvoices}" SelectedItem="{Binding SelectedInvoice}" ItemContainerStyle="{StaticResource Payment.ListItem}" MinHeight="210" AutomationProperties.Name="Danh sách phiếu đăng ký"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,5">
     <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding TotalLabel}" Style="{StaticResource CE.Caption}"/><TextBlock Text="{Binding Code}" Style="{StaticResource CE.Body}" FontWeight="SemiBold"/></DockPanel>
     <TextBlock Text="{Binding RecipientName}" Style="{StaticResource CE.Caption}" Margin="0,3"/>
     <Border Style="{StaticResource Payment.InvoiceBadge}" HorizontalAlignment="Left"><TextBlock Text="{Binding State}"/></Border>
    </StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   </StackPanel></Border>
   <StackPanel Grid.Column="2">
    <ContentControl Style="{StaticResource CE.Alert.Info}" Visibility="{Binding HasNoSelection, Converter={StaticResource Visible}}"><TextBlock Text="Chọn một phiếu để xem công nợ và các lần thu."/></ContentControl>
    <Border Style="{StaticResource CE.Card}" Visibility="{Binding HasSelection, Converter={StaticResource Visible}}" Margin="0,0,0,16"><StackPanel>
     <DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource CE.Badge.Complete}" Visibility="{Binding IsPaidInFull, Converter={StaticResource Visible}}"><TextBlock Text="Đã hoàn tất"/></Border><TextBlock Text="Công nợ phiếu" Style="{StaticResource CE.SectionHeading}"/></DockPanel>
     <TextBlock Text="{Binding SelectedInvoice.Code}" Style="{StaticResource CE.Body}" Margin="0,8,0,12"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Tổng phải thu" Style="{StaticResource CE.Caption}"/><TextBlock Text="{Binding SelectedInvoice.TotalLabel}" Style="{StaticResource CE.SectionHeading}"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="Đã thanh toán" Style="{StaticResource CE.Caption}"/><TextBlock Text="{Binding SelectedInvoice.PaidLabel}" Style="{StaticResource CE.SectionHeading}"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Còn lại" Style="{StaticResource CE.Caption}"/><TextBlock Text="{Binding SelectedInvoice.RemainingLabel}" Style="{StaticResource CE.SectionHeading}"/></StackPanel>
     </Grid>
    </StackPanel></Border>
    <Border Style="{StaticResource CE.Card}" Visibility="{Binding HasSelection, Converter={StaticResource Visible}}" Margin="0,0,0,16"><StackPanel>
     <TextBlock Text="Lịch sử các lần thu" Style="{StaticResource CE.SectionHeading}" Margin="0,0,0,8"/>
     <TextBlock Text="Chưa có lần thu nào."><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CE.Caption}"><Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers><Setter Property="Visibility" Value="Collapsed"/></Style></TextBlock.Style></TextBlock>
     <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedPayment}" ItemContainerStyle="{StaticResource Payment.ListItem}" MinHeight="110" AutomationProperties.Name="Lịch sử thu"><ListBox.ItemTemplate><DataTemplate><Grid Margin="2,5"><Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Code}" Style="{StaticResource CE.Body}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Type}" Style="{StaticResource CE.Body}"/><TextBlock Text="{Binding TimeLabel}" Style="{StaticResource CE.Caption}"/></StackPanel>
      <TextBlock Grid.Column="2" Text="{Binding AmountLabel}" Style="{StaticResource CE.Body}"/>
      <Border Grid.Column="3" Style="{StaticResource Payment.TransactionBadge}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Status}"/></Border>
     </Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
     <Button Content="In biên lai" Command="{Binding InBienLaiCommand}" Style="{StaticResource CE.Button.Secondary}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource CE.Card}" Visibility="{Binding HasSelection, Converter={StaticResource Visible}}"><StackPanel IsEnabled="{Binding CanEnterPayment}">
     <TextBlock Text="Ghi lần thu mới" Style="{StaticResource CE.SectionHeading}" Margin="0,0,0,12"/>
     <TextBlock Text="Số tiền lần này * (đ)" Style="{StaticResource CE.Caption}"/><TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}" Margin="0,4,0,0" AutomationProperties.Name="Số tiền thu"/>
     <TextBlock Text="{Binding AmountError}" Foreground="{StaticResource CE.Danger.Foreground}" Margin="0,4,0,8"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Phương thức *" Style="{StaticResource CE.Caption}"/><ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" Style="{StaticResource CE.ComboBox}" Margin="0,4,0,8"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Loại thanh toán *" Style="{StaticResource CE.Caption}"/><ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" Style="{StaticResource CE.ComboBox}" Margin="0,4,0,8"/></StackPanel>
     </Grid>
     <TextBlock Text="Trạng thái giao dịch *" Style="{StaticResource CE.Caption}"/><ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" Style="{StaticResource CE.ComboBox}" Margin="0,4,0,12"/>
     <Button Content="Xác nhận thanh toán" Command="{Binding XacNhanThanhToanCommand}" Style="{StaticResource CE.Button.Primary}" HorizontalAlignment="Left"/>
    </StackPanel></Border>
   </StackPanel>
  </Grid>
  <TextBlock Text="{Binding Feedback}" Style="{StaticResource CE.Caption}" Margin="0,12,0,0"/>
 </StackPanel></ScrollViewer>
</UserControl>
