<UserControl x:Class="TiemChung.Desktop.ViewsV2.PromotionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:TiemChung.Desktop.ViewModels"><UserControl.Resources><BooleanToVisibilityConverter x:Key="Vis"/><DataTemplate DataType="{x:Type vm:PromotionViewModel}"><Grid Margin="28" Background="{StaticResource CE.Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel LastChildFill="False" Margin="0,0,0,18"><StackPanel><TextBlock Text="Khuyến mãi" Style="{StaticResource CE.Heading}"/><TextBlock Text="Quản lý chương trình và thời hạn áp dụng" Style="{StaticResource CE.Caption}" Margin="0,5,0,0"/></StackPanel><Border DockPanel.Dock="Right" Style="{StaticResource CE.Badge.Sample}"><TextBlock Text="{Binding DataSourceLabel}"/></Border></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Border Style="{StaticResource CE.Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Chương trình" Style="{StaticResource CE.SectionHeading}"/><DataGrid Grid.Row="1" ItemsSource="{Binding Promotions}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,10"><DataGrid.Columns><DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Bắt đầu" Binding="{Binding Starts,StringFormat={}{0:dd/MM/yyyy}}" Width="100"/><DataGridTextColumn Header="Kết thúc" Binding="{Binding Ends,StringFormat={}{0:dd/MM/yyyy}}" Width="100"/><DataGridTextColumn Header="Mức ưu đãi" Binding="{Binding Discount,StringFormat={}{0:N0} đ}" Width="110"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="130"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="Chưa có chương trình khuyến mãi." Visibility="{Binding HasNoData,Converter={StaticResource Vis}}" HorizontalAlignment="Center"/></Grid></Border><Border Grid.Column="2" Style="{StaticResource CE.Card}" Padding="18"><StackPanel><TextBlock Text="Thông tin chương trình" Style="{StaticResource CE.SectionHeading}" Margin="0,0,0,14"/><TextBlock Text="Tên *" Style="{StaticResource CE.Caption}"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}" Margin="0,5,0,10"/><TextBlock Text="Nội dung" Style="{StaticResource CE.Caption}"/><TextBox Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}" Height="70" Margin="0,5,0,10"/><TextBlock Text="Bắt đầu"/><DatePicker SelectedDate="{Binding Start}" Style="{StaticResource CE.DatePicker}" Margin="0,5,0,10"/><TextBlock Text="Kết thúc *"/><DatePicker SelectedDate="{Binding End}" Style="{StaticResource CE.DatePicker}" Margin="0,5,0,10"/><TextBlock Text="Mức ưu đãi *"/><TextBox Text="{Binding Amount,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}" Margin="0,5,0,10"/><TextBlock Text="{Binding Validation}" Style="{StaticResource CE.Caption}"/><TextBlock Text="Đã gán vào đăng ký: không thể xóa." Visibility="{Binding IsAssigned,Converter={StaticResource Vis}}" Style="{StaticResource CE.Caption}"/><TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" Margin="0,6"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button Content="Mới" Command="{Binding NewCommand}" Style="{StaticResource CE.Button.Secondary}" Margin="0,0,8,0"/><Button Content="Xóa" Command="{Binding DeleteCommand}" Style="{StaticResource CE.Button.Danger}" Margin="0,0,8,0"/><Button Content="Lưu" Command="{Binding SaveCommand}" Style="{StaticResource CE.Button.Primary}"/></StackPanel></StackPanel></Border></Grid></Grid></DataTemplate></UserControl.Resources><ContentControl Content="{Binding}"/></UserControl>
