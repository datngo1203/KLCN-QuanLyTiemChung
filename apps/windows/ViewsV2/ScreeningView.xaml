<UserControl x:Class="TiemChung.Desktop.ViewsV2.ScreeningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Screening" Language="vi-VN" SizeChanged="View_SizeChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    </UserControl.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
        <StackPanel>
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="CHUYÊN MÔN" AutomationProperties.AutomationId="A02.Breadcrumb" Style="{StaticResource CE.Caption}" Foreground="{StaticResource CE.Primary}" />
                <TextBlock Text="Khám sàng lọc &amp; chỉ định" Style="{StaticResource CE.Heading}" Margin="0,4" />
                <TextBlock Text="Bàn khám theo lượt và ghi nhận chỉ định" Style="{StaticResource CE.Caption}" />
                <Border Style="{StaticResource CE.Badge.Warning}" HorizontalAlignment="Left" Margin="0,8,0,0"><TextBlock Text="{Binding DataSourceLabel}" /></Border>
            </StackPanel>
            <Grid x:Name="Workspace">
                <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CE.Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Làm mới" Style="{StaticResource CE.Button.Secondary}" Command="{Binding RefreshQueueCommand}" AutomationProperties.Name="Làm mới hàng đợi khám" />
                            <StackPanel><TextBlock Text="Hàng đợi khám" Style="{StaticResource CE.SectionHeading}" /><TextBlock Text="{Binding QueueCountLabel}" Style="{StaticResource CE.Caption}" Margin="0,4,0,0" /></StackPanel>
                        </DockPanel>
                        <TextBlock Text="Tìm lượt / người được tiêm" Style="{StaticResource CE.Caption}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource CE.TextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tìm lượt hoặc người được tiêm" />
                        <TextBlock Text="Trạng thái" Style="{StaticResource CE.Caption}" Margin="0,12,0,4" />
                        <ComboBox Style="{StaticResource CE.ComboBox}" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" AutomationProperties.Name="Lọc trạng thái hàng đợi" />
                        <TextBlock Text="Hàng đợi hiện không có lượt khám." Style="{StaticResource CE.Caption}" Margin="0,16,0,0" Visibility="{Binding HasEmptyQueue, Converter={StaticResource BoolVisibility}}" />
                        <TextBlock Text="Không có lượt phù hợp với bộ lọc." Style="{StaticResource CE.Caption}" Margin="0,16,0,0" Visibility="{Binding HasNoQueueResults, Converter={StaticResource BoolVisibility}}" />
                        <ItemsControl ItemsSource="{Binding QueueView}" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button HorizontalContentAlignment="Stretch" Margin="0,0,0,8"
                                        AutomationProperties.Name="{Binding RecipientName, StringFormat=Chọn lượt khám {0}}"
                                        Command="{Binding DataContext.SelectEncounterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource CE.Button.Secondary}"><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{StaticResource CE.Selected}"/><Setter Property="BorderBrush" Value="{StaticResource CE.Primary}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                    <StackPanel>
                                        <DockPanel LastChildFill="True"><TextBlock DockPanel.Dock="Right" Text="{Binding TimeLabel}" Style="{StaticResource CE.Caption}" Margin="8,0,0,0" /><TextBlock Text="{Binding RecipientName}" Style="{StaticResource CE.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></DockPanel>
                                        <TextBlock Text="{Binding Id}" Style="{StaticResource CE.Caption}" Margin="0,4,0,0" />
                                        <Border Style="{StaticResource CE.Badge.Warning}" HorizontalAlignment="Left" Margin="0,4,0,0"><TextBlock Text="{Binding Status}"/></Border>
                                    </StackPanel>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="DetailPanel" Grid.Column="2">
                    <Border Margin="0,0,0,16">
                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource CE.Badge.Info}"><Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers></Style></Border.Style>
                        <TextBlock>
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CE.Body}"><Setter Property="Text" Value="Chưa chọn lượt khám. Chọn một dòng trong hàng đợi để mở biểu mẫu."/><Style.Triggers><DataTrigger Binding="{Binding HasEmptyQueue}" Value="True"><Setter Property="Text" Value="Hàng đợi hiện không có lượt khám để mở biểu mẫu."/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <StackPanel IsEnabled="{Binding HasSelection}" Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}">
                        <Border Style="{StaticResource CE.Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Người được tiêm &amp; đăng ký" Style="{StaticResource CE.SectionHeading}" Margin="0,0,0,12" />
                                <TextBlock Text="{Binding SelectedEncounter.RecipientName}" Style="{StaticResource CE.Heading}" />
                                <WrapPanel Margin="0,12,0,0">
                                    <StackPanel Margin="0,0,24,8"><TextBlock Text="Mã hồ sơ" Style="{StaticResource CE.Caption}" /><TextBlock Text="{Binding SelectedEncounter.RecipientId}" Style="{StaticResource CE.Body}" /></StackPanel>
                                    <StackPanel Margin="0,0,24,8"><TextBlock Text="Ngày sinh" Style="{StaticResource CE.Caption}" /><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SelectedEncounter.BirthDateLabel}" Style="{StaticResource CE.Body}"/><TextBlock Text="{Binding SelectedEncounter.RecipientAgeLabel}" Style="{StaticResource CE.Caption}" Margin="8,0,0,0"/></StackPanel></StackPanel>
                                    <StackPanel Margin="0,0,24,8"><TextBlock Text="Giới tính" Style="{StaticResource CE.Caption}" /><TextBlock Text="{Binding SelectedEncounter.Gender}" Style="{StaticResource CE.Body}" /></StackPanel>
                                    <StackPanel Margin="0,0,24,8"><TextBlock Text="CCCD" Style="{StaticResource CE.Caption}" /><TextBlock Text="{Binding SelectedEncounter.RecipientNationalId}" Style="{StaticResource CE.Body}" /></StackPanel>
                                    <StackPanel Margin="0,0,24,8"><TextBlock Text="Mã đăng ký" Style="{StaticResource CE.Caption}" /><TextBlock Text="{Binding SelectedEncounter.RegistrationId}" Style="{StaticResource CE.Body}" /></StackPanel>
                                    <StackPanel Margin="0,0,24,8"><TextBlock Text="Khách hàng liên hệ" Style="{StaticResource CE.Caption}" /><TextBlock Text="{Binding SelectedEncounter.CustomerName}" Style="{StaticResource CE.Body}" /></StackPanel>
                                    <StackPanel Margin="0,0,24,8"><TextBlock Text="Số điện thoại" Style="{StaticResource CE.Caption}" /><TextBlock Text="{Binding SelectedEncounter.CustomerPhone}" Style="{StaticResource CE.Body}" /></StackPanel>
                                    <StackPanel Margin="0,0,0,8"><TextBlock Text="Dịch vụ đăng ký" Style="{StaticResource CE.Caption}" /><TextBlock Text="{Binding SelectedEncounter.RegisteredService}" Style="{StaticResource CE.Body}" /></StackPanel>
                                </WrapPanel>
                                <ContentControl Style="{StaticResource CE.Alert.Safety}" Margin="0,8,0,0"
                                                Visibility="{Binding HasAllergySafetyAlert, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="{Binding AllergyAlertText}" Style="{StaticResource CE.Body}" />
                                </ContentControl>
                                <CheckBox Content="Đánh dấu thủ công dị ứng nguy hiểm" IsChecked="{Binding IsDangerousAllergy}"
                                          Margin="0,8,0,0" AutomationProperties.Name="Đánh dấu thủ công dị ứng nguy hiểm" />
                                <Button Content="{Binding SafetyConfirmationLabel}" Command="{Binding ConfirmSafetyCommand}"
                                        Style="{StaticResource CE.Button.Secondary}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Visibility="{Binding IsDangerousAllergy, Converter={StaticResource BoolVisibility}}"
                                        AutomationProperties.Name="Xác nhận đánh giá dị ứng nguy hiểm" />
                            </StackPanel>
                        </Border>

                        <Grid x:Name="ClinicalColumns" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Style="{StaticResource CE.Card}" Grid.Column="0">
                                <StackPanel>
                                    <TextBlock Text="Khám sàng lọc" Style="{StaticResource CE.SectionHeading}" Margin="0,0,0,12" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"><TextBlock Text="Mạch (lần/phút)" Style="{StaticResource CE.Caption}" Margin="0,0,0,4" /><TextBox Style="{StaticResource CE.TextBox}" Text="{Binding PulseText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Mạch" /><TextBlock Text="{Binding PulseError}" Style="{StaticResource CE.Caption}" Margin="0,4,0,0" /></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Nhiệt độ (°C)" Style="{StaticResource CE.Caption}" Margin="0,0,0,4" /><TextBox Style="{StaticResource CE.TextBox}" Text="{Binding TemperatureText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nhiệt độ" /><TextBlock Text="{Binding TemperatureError}" Style="{StaticResource CE.Caption}" Margin="0,4,0,0" /><TextBlock Text="{Binding TemperatureSuggestion}" Style="{StaticResource CE.Caption}" Foreground="{StaticResource CE.Warning.Foreground}" Margin="0,4,0,0" /></StackPanel>
                                    </Grid>
                                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"><TextBlock Text="Huyết áp tâm thu (mmHg)" Style="{StaticResource CE.Caption}" Margin="0,0,0,4" /><TextBox Style="{StaticResource CE.TextBox}" Text="{Binding SystolicText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Huyết áp tâm thu" /><TextBlock Text="{Binding SystolicError}" Style="{StaticResource CE.Caption}" Margin="0,4,0,0" /></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Huyết áp tâm trương (mmHg)" Style="{StaticResource CE.Caption}" Margin="0,0,0,4" /><TextBox Style="{StaticResource CE.TextBox}" Text="{Binding DiastolicText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Huyết áp tâm trương" /><TextBlock Text="{Binding DiastolicError}" Style="{StaticResource CE.Caption}" Margin="0,4,0,0" /></StackPanel>
                                    </Grid>
                                    <TextBlock Text="Tiền sử dị ứng (bắt buộc)" Style="{StaticResource CE.Caption}" Margin="0,16,0,4" />
                                    <TextBox Style="{StaticResource CE.TextBox}" Text="{Binding AllergyHistory, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" Height="72" AutomationProperties.Name="Tiền sử dị ứng bắt buộc" />
                                    <TextBlock Text="{Binding AllergyError}" Style="{StaticResource CE.Caption}" Margin="0,4,0,0" />
                                    <TextBlock Text="Bệnh lý mãn tính" Style="{StaticResource CE.Caption}" Margin="0,12,0,4" />
                                    <TextBox Style="{StaticResource CE.TextBox}" Text="{Binding ChronicConditions, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" Height="64" AutomationProperties.Name="Bệnh lý mãn tính" />
                                    <TextBlock Text="Ghi chú bác sĩ" Style="{StaticResource CE.Caption}" Margin="0,12,0,4" />
                                    <TextBox Style="{StaticResource CE.TextBox}" Text="{Binding DoctorNote, UpdateSourceTrigger=PropertyChanged}" Height="64" AutomationProperties.Name="Ghi chú bác sĩ" />
                                </StackPanel>
                            </Border>
                                                        <StackPanel x:Name="ClinicalPanel" Grid.Column="2">
                                <Border Style="{StaticResource CE.Card}" Margin="0,0,0,16"><StackPanel>
                                    <TextBlock Text="Kết luận" Style="{StaticResource CE.SectionHeading}" Margin="0,0,0,12"/>
                                    <UniformGrid Columns="3">
                                        <RadioButton Content="Đủ điều kiện" GroupName="Conclusion" Style="{StaticResource CE.SegmentedButton}" IsChecked="{Binding IsEligible, Mode=OneWay}" Command="{Binding SetConclusionCommand}" CommandParameter="Đủ điều kiện" AutomationProperties.Name="Kết luận đủ điều kiện"/>
                                        <RadioButton Content="Tạm hoãn" GroupName="Conclusion" Style="{StaticResource CE.SegmentedButton.Warning}" IsChecked="{Binding IsDeferred, Mode=OneWay}" Command="{Binding SetConclusionCommand}" CommandParameter="Tạm hoãn" AutomationProperties.Name="Kết luận tạm hoãn"/>
                                        <RadioButton Content="Chống chỉ định" GroupName="Conclusion" Style="{StaticResource CE.SegmentedButton.Warning}" IsChecked="{Binding IsContraindicated, Mode=OneWay}" Command="{Binding SetConclusionCommand}" CommandParameter="Chống chỉ định" AutomationProperties.Name="Kết luận chống chỉ định"/>
                                    </UniformGrid>
                                    <TextBlock Text="{Binding ConclusionError}" Style="{StaticResource CE.Caption}" Margin="0,8,0,0"/>
                                    <StackPanel Visibility="{Binding NeedsDeferReason, Converter={StaticResource BoolVisibility}}" Margin="0,16,0,0">
                                        <TextBlock Text="Lý do" Style="{StaticResource CE.Caption}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource CE.TextBox}" Text="{Binding DeferReason, UpdateSourceTrigger=PropertyChanged}" Height="64" MaxLength="500" AutomationProperties.Name="Lý do tạm hoãn hoặc chống chỉ định"/>
                                        <TextBlock Text="{Binding DeferReasonError}" Style="{StaticResource CE.Caption}" Foreground="{StaticResource CE.Danger.Foreground}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel></Border>
                                <Border x:Name="IndicationCard" Style="{StaticResource CE.Card}" IsEnabled="{Binding AreIndicationsEnabled}">
                                <StackPanel>
                                    <TextBlock Text="Chỉ định theo vắc xin" Style="{StaticResource CE.SectionHeading}" Margin="0,0,0,8" />
                                    <TextBlock Text="Chỉ định chỉ nhập khi kết luận đủ điều kiện." Style="{StaticResource CE.Caption}" Margin="0,0,0,12" />
                                    <Button Content="Thêm chỉ định" Style="{StaticResource CE.Button.Primary}" Command="{Binding AddIndicationCommand}" HorizontalAlignment="Left" Margin="0,0,0,12" AutomationProperties.Name="Thêm dòng chỉ định" />
                                    <DataGrid ItemsSource="{Binding Indications}" Style="{StaticResource CE.DataGrid}" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="280" AutomationProperties.Name="Danh sách chỉ định">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Vắc xin" Width="*" MinWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <ComboBox Style="{StaticResource CE.ComboBox}" ItemsSource="{Binding DataContext.VaccineCatalog, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Name" SelectedItem="{Binding Vaccine, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Chọn vắc xin" />
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Ghi chú từng dòng" Width="*" MinWidth="140"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <TextBox Style="{StaticResource CE.TextBox}" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Ghi chú chỉ định" />
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="" Width="64"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <Button Content="Xóa" Style="{StaticResource CE.Button.Secondary}" Command="{Binding DataContext.RemoveIndicationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="Xóa dòng chỉ định" />
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="{Binding IndicationsError}" Style="{StaticResource CE.Caption}" Foreground="{StaticResource CE.Danger.Foreground}" Margin="0,8,0,0" />
                                    <TextBlock Text="" Style="{StaticResource CE.Caption}" Margin="0,8,0,0" />
                                </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Feedback}" Style="{StaticResource CE.Body}" Margin="0,16,0,0" AutomationProperties.LiveSetting="Polite" />

        </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Background="{StaticResource CE.Surface}" BorderBrush="{StaticResource CE.CardBorder}" BorderThickness="0,1,0,0" Padding="24,12"><DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Hủy thay đổi" Style="{StaticResource CE.Button.Secondary}" Command="{Binding ResetDraftCommand}" Margin="0,0,8,0" AutomationProperties.Name="Hủy thay đổi phiếu khám"/><Button Content="Lưu" Style="{StaticResource CE.Button.Primary}" Command="{Binding LuuPhieuKhamVaChiDinhCommand}" AutomationProperties.Name="Lưu phiếu khám và chỉ định"/></StackPanel><TextBlock Text="{Binding ValidationSummary}" Style="{StaticResource CE.Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
    </Grid>
</UserControl>
