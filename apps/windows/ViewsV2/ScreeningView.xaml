<UserControl x:Class="TiemChung.Desktop.ViewsV2.ScreeningView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Language="vi-VN" SizeChanged="View_SizeChanged">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Vis"/></UserControl.Resources>
 <Grid Background="{StaticResource CE.Canvas}">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
   <StackPanel>
    <TextBlock Text="CHUYÊN MÔN / A02" Style="{StaticResource CE.Caption}"/>
    <TextBlock Text="Kết luận và chỉ định theo lịch hẹn" Style="{StaticResource CE.Heading}" TextWrapping="Wrap" Margin="0,4,0,8"/>
    <TextBlock Text="API / SQL · Lịch hẹn chưa phải xác nhận đã đến khám hoặc đã tiêm." Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBlock Text="Chỉ Bác sĩ đang hoạt động được xem và ghi kết luận." Visibility="{Binding NoAccess,Converter={StaticResource Vis}}" Style="{StaticResource CE.Body}" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Feedback}" Style="{StaticResource CE.Body}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
    <TextBlock Text="Đang xử lý…" Visibility="{Binding IsBusy,Converter={StaticResource Vis}}" Style="{StaticResource CE.Caption}"/>
    <WrapPanel Visibility="{Binding HasPending,Converter={StaticResource Vis}}" Margin="0,8,0,12">
     <Button Content="Đối chiếu bằng GET" Command="{Binding ReconcileCommand}" Style="{StaticResource CE.Button.Secondary}" Margin="0,0,8,8"/>
     <Button Content="Thử lại đúng yêu cầu cũ" Command="{Binding RetryCommand}" Style="{StaticResource CE.Button.Secondary}" Margin="0,0,0,8"/>
    </WrapPanel>
    <Grid x:Name="Workspace" Visibility="{Binding HasAccess,Converter={StaticResource Vis}}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Style="{StaticResource CE.Card}" Padding="16" VerticalAlignment="Top">
      <StackPanel>
       <TextBlock Text="Danh sách lịch hẹn" Style="{StaticResource CE.SectionHeading}" Margin="0,0,0,12"/>
       <TextBlock Text="Tên người tiêm hoặc mã LH-0001" Style="{StaticResource CE.Caption}" TextWrapping="Wrap"/>
       <TextBox Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" MaxLength="100" IsEnabled="{Binding CanBrowse}" Style="{StaticResource CE.TextBox}" AutomationProperties.Name="Tìm lịch hẹn" Margin="0,4,0,8"/>
       <Button Content="Tìm / tải lại lịch" Command="{Binding ReloadCommand}" Style="{StaticResource CE.Button.Secondary}"/>
       <TextBlock Text="Không có lịch hẹn phù hợp." Visibility="{Binding NoResults,Converter={StaticResource Vis}}" Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>
       <ListView ItemsSource="{Binding Appointments}" SelectedItem="{Binding Selected}" SelectionChanged="AppointmentChanged" IsEnabled="{Binding CanBrowse}" Style="{StaticResource CE.ListView}" HorizontalContentAlignment="Stretch" MaxHeight="380" Margin="0,12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Lịch hẹn chuyên môn">
        <ListView.ItemTemplate><DataTemplate><StackPanel Margin="4">
         <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding TimeLabel}" Margin="0,4,0,0"/>
         <TextBlock Text="{Binding SourceLabel}" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding Location}" TextWrapping="Wrap" Style="{StaticResource CE.Caption}"/>
        </StackPanel></DataTemplate></ListView.ItemTemplate>
       </ListView>
       <WrapPanel><Button Content="Trang trước" Command="{Binding PreviousCommand}" Style="{StaticResource CE.Button.Secondary}"/><TextBlock Text="{Binding Page,StringFormat=Trang {0}}" VerticalAlignment="Center" Margin="8"/><Button Content="Trang sau" Command="{Binding NextCommand}" Style="{StaticResource CE.Button.Secondary}"/></WrapPanel>
       <TextBlock Text="Xóa bản nháp nếu muốn chọn lịch khác." Visibility="{Binding IsDirty,Converter={StaticResource Vis}}" Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel>
     </Border>
     <Border x:Name="DetailPanel" Grid.Column="2" Style="{StaticResource CE.Card}" Padding="18" VerticalAlignment="Top">
      <StackPanel>
       <TextBlock x:Name="DetailHeading" Text="Buổi hẹn và kết luận" Focusable="True" Style="{StaticResource CE.SectionHeading}" TextWrapping="Wrap"/>
       <TextBlock Text="Chọn lịch hẹn để xem đúng người tiêm và dòng dịch vụ." Visibility="{Binding NoDetail,Converter={StaticResource Vis}}" Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,10"/>
       <Button Content="Tải lại chi tiết" Command="{Binding DetailCommand}" Style="{StaticResource CE.Button.Secondary}" HorizontalAlignment="Left" Margin="0,10"/>
       <TextBlock Text="{Binding Detail.Appointment.Label}" Style="{StaticResource CE.Heading}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Detail.Appointment.SourceLabel}" Style="{StaticResource CE.Body}" TextWrapping="Wrap" Margin="0,8,0,0"/>
       <TextBlock Text="{Binding Detail.Appointment.Customer.FullName,StringFormat=Khách hàng: {0}}" TextWrapping="Wrap" Margin="0,8,0,0"/>
       <TextBlock Text="{Binding Detail.Appointment.TimeLabel,StringFormat=Giờ trên máy: {0}}" TextWrapping="Wrap" Margin="0,8,0,0"/>
       <TextBlock Text="{Binding Detail.Appointment.Location,StringFormat=Địa điểm: {0}}" TextWrapping="Wrap" Margin="0,8,0,12"/>
       <StackPanel Visibility="{Binding IsDraft,Converter={StaticResource Vis}}">
        <TextBlock Text="Sinh tồn và tiền sử: chưa thu thập trong chức năng này. Không diễn giải là bình thường." Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>
        <StackPanel IsEnabled="{Binding CanEdit}">
         <TextBlock Text="Kết luận do bác sĩ lựa chọn" Style="{StaticResource CE.Caption}"/>
         <ComboBox x:Name="ConclusionInput" ItemsSource="{Binding ConclusionOptions}" SelectedItem="{Binding Conclusion}" Style="{StaticResource CE.ComboBox}" AutomationProperties.Name="Kết luận" Margin="0,4,0,12"/>
         <TextBlock Text="Lý do (bắt buộc khi tạm hoãn hoặc chống chỉ định)" Style="{StaticResource CE.Caption}" TextWrapping="Wrap"/>
         <TextBox Text="{Binding Reason,UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="76" VerticalScrollBarVisibility="Auto" Style="{StaticResource CE.TextBox}" AutomationProperties.Name="Lý do kết luận" Margin="0,4,0,12"/>
         <TextBlock Text="Vắc xin chỉ định cho buổi hẹn" Style="{StaticResource CE.SectionHeading}" TextWrapping="Wrap"/>
         <TextBlock Text="Đủ điều kiện: chủ động chọn ít nhất một vắc xin. Chỉ các mục được chọn có chỉ định; không tự cho phép toàn bộ gói." Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,6,0,10"/>
         <ItemsControl ItemsSource="{Binding Vaccines}" IsEnabled="{Binding CanSelectVaccines}"><ItemsControl.ItemTemplate><DataTemplate>
          <CheckBox IsChecked="{Binding IsSelected}" Margin="0,6" AutomationProperties.Name="{Binding Name}"><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></CheckBox>
         </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
       </StackPanel>
       <StackPanel Visibility="{Binding IsRecorded,Converter={StaticResource Vis}}" Margin="0,12,0,0">
        <TextBlock Text="Kết luận đã lưu · Chỉ đọc" Style="{StaticResource CE.SectionHeading}"/>
        <TextBlock Text="{Binding Assessment.Conclusion}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,6"/>
        <TextBlock Text="{Binding Assessment.Reason}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Assessment.Doctor.FullName,StringFormat=Bác sĩ: {0}}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <TextBlock Text="{Binding Assessment.RecordedLabel,StringFormat=Ghi nhận (giờ trên máy): {0}}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <TextBlock Text="Sinh tồn và tiền sử: chưa thu thập trong S5.3." Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,10"/>
        <TextBlock Text="Chỉ định đã lưu" Style="{StaticResource CE.SectionHeading}"/>
        <ItemsControl ItemsSource="{Binding Assessment.Indications}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8"><TextBlock Text="{Binding VaccineName}" TextWrapping="Wrap"/><TextBlock Text="{Binding ResultLabel}" Style="{StaticResource CE.Caption}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="Kết luận và chỉ định chưa phải ghi nhận đã tiêm." Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>
       </StackPanel>
      </StackPanel>
     </Border>
    </Grid>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="1" Background="{StaticResource CE.Surface}" BorderBrush="{StaticResource CE.CardBorder}" BorderThickness="0,1,0,0" Padding="24,12">
   <WrapPanel HorizontalAlignment="Right"><Button Content="Xóa bản nháp" Command="{Binding ResetDraftCommand}" Style="{StaticResource CE.Button.Secondary}" Margin="0,0,10,0"/><Button x:Name="SaveButton" Content="Xác nhận lưu kết luận" Click="ConfirmAssessment" IsEnabled="{Binding CanSave}" Style="{StaticResource CE.Button.Primary}"/></WrapPanel>
  </Border>
 </Grid>
</UserControl>
