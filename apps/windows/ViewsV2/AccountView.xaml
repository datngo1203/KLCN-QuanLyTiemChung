<UserControl x:Class="TiemChung.Desktop.ViewsV2.AccountView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="24" Background="{StaticResource CE.Canvas}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><Button DockPanel.Dock="Right" Content="Tải lại" Command="{Binding ReloadCommand}" Style="{StaticResource CE.Button.Secondary}" HorizontalAlignment="Right"/>
   <StackPanel><TextBlock Text="Nhân viên &amp; tài khoản" Style="{StaticResource CE.Heading}"/>
    <TextBlock Text="Mỗi nhân viên có một chức danh. Quyền được áp dụng tự động theo công việc." Style="{StaticResource CE.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </DockPanel>
  <TextBlock Grid.Row="1" Text="Chọn tài khoản và chức danh để cập nhật quyền truy cập. Không thể tự đổi chức danh của tài khoản đang đăng nhập." Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,14"/>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CE.Card}" Padding="12"><ListView ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Style="{StaticResource CE.ListView}" AutomationProperties.Name="Tài khoản nhân viên">
    <ListView.ItemTemplate><DataTemplate><StackPanel Margin="4,8"><TextBlock Text="{Binding FullName}" Style="{StaticResource CE.Body}" FontWeight="SemiBold"/><TextBlock Text="{Binding Username}" Style="{StaticResource CE.Caption}"/></StackPanel></DataTemplate></ListView.ItemTemplate>
   </ListView></Border>
   <Border Grid.Column="2" Style="{StaticResource CE.Card}" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Chức danh và quyền truy cập" Style="{StaticResource CE.SectionHeading}"/>
    <TextBlock Text="{Binding Selected.FullName,TargetNullValue=Chưa chọn nhân viên}" Style="{StaticResource CE.Body}" Margin="0,12,0,4"/>
    <TextBlock Text="Chức danh" Style="{StaticResource CE.Caption}" Margin="0,12,0,4"/>
    <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Label" Style="{StaticResource CE.ComboBox}" AutomationProperties.Name="Chức danh nhân viên"/>
    <TextBlock Text="Quyền theo chức danh" Style="{StaticResource CE.Caption}" Margin="0,16,0,4"/>
    <TextBlock Text="{Binding SelectedRole.Access}" Style="{StaticResource CE.Body}" TextWrapping="Wrap"/>
    <TextBlock Text="Sau khi đổi chức danh, nhân viên cần đăng nhập lại để sử dụng quyền mới. Khởi tạo và khôi phục mật khẩu dùng công cụ quản trị hiện có." Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,16,0,0"/>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <DockPanel Grid.Row="3" Margin="0,16,0,0"><Button DockPanel.Dock="Right" Content="Lưu chức danh" Command="{Binding SaveRoleCommand}" Style="{StaticResource CE.Button.Primary}" HorizontalAlignment="Right"/><TextBlock Text="{Binding Feedback}" Style="{StaticResource CE.Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/></DockPanel>
 </Grid>
</UserControl>
