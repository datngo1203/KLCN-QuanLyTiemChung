<UserControl x:Class="TiemChung.Desktop.ViewsV2.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Screens/Account.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Vis"/></ResourceDictionary></UserControl.Resources>
    <Grid Margin="28" Background="{StaticResource CE.Canvas}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14"><StackPanel><TextBlock Text="Nhân viên &amp; tài khoản" Style="{StaticResource CE.Heading}"/><TextBlock Text="Hồ sơ nhân viên, tài khoản và quyền bổ sung" Style="{StaticResource CE.Caption}" Margin="0,4,0,0"/></StackPanel><Border DockPanel.Dock="Right" Style="{StaticResource CE.Badge.Sample}"><TextBlock Text="{Binding DataSourceLabel}"/></Border></DockPanel>
        <TabControl Grid.Row="1" Style="{StaticResource A12.TabControl}" ItemContainerStyle="{StaticResource A12.TabItem}">
            <TabItem Header="Nhân viên">
                <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CE.Card}" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Danh sách nhân viên" Style="{StaticResource CE.SectionHeading}"/><DataGrid Grid.Row="1" Style="{StaticResource CE.DataGrid}" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,8"><DataGrid.Columns><DataGridTextColumn Header="Họ tên" Binding="{Binding Name}" Width="220"/><DataGridTextColumn Header="Chức danh" Binding="{Binding JobTitle}" Width="110"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding EmploymentStatus}" Width="130"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="1" Text="Chưa có nhân viên trong nguồn dữ liệu." Visibility="{Binding HasNoEmployees,Converter={StaticResource Vis}}" Style="{StaticResource CE.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
                    <Border Grid.Column="2" Style="{StaticResource CE.Card}" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Thông tin nhân viên" Style="{StaticResource CE.SectionHeading}"/><TextBlock Text="Họ tên *" Style="{StaticResource CE.Caption}" Margin="0,10,0,4"/><TextBox Text="{Binding EmployeeName,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}"/><TextBlock Text="CCCD *" Style="{StaticResource CE.Caption}" Margin="0,8,0,4"/><TextBox Text="{Binding CitizenId,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}"/><TextBlock Text="{Binding CitizenIdError}" Style="{StaticResource CE.Caption}" Foreground="{StaticResource CE.Danger.Foreground}" Margin="0,3,0,0"/><TextBlock Text="Số điện thoại *" Style="{StaticResource CE.Caption}" Margin="0,8,0,4"/><TextBox Text="{Binding Phone,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}"/><TextBlock Text="Email *" Style="{StaticResource CE.Caption}" Margin="0,8,0,4"/><TextBox Text="{Binding Email,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}"/><TextBlock Text="Bộ phận *" Style="{StaticResource CE.Caption}" Margin="0,8,0,4"/><ComboBox ItemsSource="{Binding Departments}" SelectedItem="{Binding Department}" Style="{StaticResource CE.ComboBox}"/><TextBlock Text="Chức danh · chọn đúng một *" Style="{StaticResource CE.Caption}" Margin="0,8,0,4"/><ComboBox ItemsSource="{Binding JobTitles}" SelectedItem="{Binding JobTitle}" Style="{StaticResource CE.ComboBox}"/><TextBlock Text="Trạng thái nhân viên *" Style="{StaticResource CE.Caption}" Margin="0,8,0,4"/><ComboBox ItemsSource="{Binding EmploymentStatuses}" SelectedItem="{Binding EmploymentStatus}" Style="{StaticResource CE.ComboBox}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Mới" Command="{Binding NewEmployeeCommand}" Style="{StaticResource CE.Button.Secondary}" Margin="0,0,8,0"/><Button Content="Lưu nhân viên" Command="{Binding SaveEmployeeCommand}" Style="{StaticResource CE.Button.Primary}"/></StackPanel><TextBlock Text="{Binding Feedback}" Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></ScrollViewer></Border>
                </Grid>
            </TabItem>
            <TabItem Header="Tài khoản">
                <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CE.Card}" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Danh sách tài khoản" Style="{StaticResource CE.SectionHeading}"/><ListView Grid.Row="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" Style="{StaticResource CE.ListView}" Margin="0,8"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding UserName}" Style="{StaticResource CE.Body}" FontWeight="SemiBold"/><TextBlock Text="{Binding EmployeeName}" Style="{StaticResource CE.Caption}" Margin="0,2,0,0"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><Border Style="{StaticResource CE.Badge.Danger}" Visibility="{Binding IsLocked,Converter={StaticResource Vis}}"><TextBlock Text="Đã khóa"/></Border><Border Style="{StaticResource CE.Badge.Success}" Visibility="{Binding IsActive,Converter={StaticResource Vis}}"><TextBlock Text="Hoạt động"/></Border></StackPanel></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><TextBlock Grid.Row="1" Text="Chưa có tài khoản trong nguồn dữ liệu." Visibility="{Binding HasNoAccounts,Converter={StaticResource Vis}}" Style="{StaticResource CE.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
                    <Border Grid.Column="2" Style="{StaticResource CE.Card}" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Tạo tài khoản" Style="{StaticResource CE.SectionHeading}"/><TextBlock Text="Nhân viên chưa có tài khoản *" Style="{StaticResource CE.Caption}" Margin="0,10,0,4"/><ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding EmployeeForAccount}" Style="{StaticResource CE.ComboBox}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="Tên đăng nhập *" Style="{StaticResource CE.Caption}" Margin="0,8,0,4"/><TextBox Text="{Binding UserName,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}" Tag="Không dấu, không khoảng trắng"/><TextBlock Text="{Binding UserNameError}" Style="{StaticResource CE.Caption}" Foreground="{StaticResource CE.Danger.Foreground}" Margin="0,3,0,0"/><Button Content="Tạo tài khoản" Command="{Binding CreateAccountCommand}" Style="{StaticResource CE.Button.Primary}" HorizontalAlignment="Right" Margin="0,10,0,12"/><Separator/><TextBlock Text="Thao tác tài khoản đã chọn" Style="{StaticResource CE.SectionHeading}" Margin="0,12,0,4"/><TextBlock Text="{Binding SelectedAccount.UserName,TargetNullValue=Chưa chọn tài khoản}" Style="{StaticResource CE.Body}"/><TextBlock Text="Không thể khóa hoặc tự cấp quyền cho tài khoản đang đăng nhập." Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,5,0,8"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{Binding ToggleLockLabel}" Command="{Binding ToggleLockCommand}" Style="{StaticResource CE.Button.Secondary}" Margin="0,0,8,0"/><Button Content="Đặt lại mật khẩu" Command="{Binding ResetPasswordCommand}" Style="{StaticResource CE.Button.Secondary}"/></StackPanel><TextBlock Text="{Binding Feedback}" Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></ScrollViewer></Border>
                </Grid>
            </TabItem>
            <TabItem Header="Quyền bổ sung">
                <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CE.Card}" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Chọn tài khoản" Style="{StaticResource CE.SectionHeading}"/><ListView Grid.Row="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" Style="{StaticResource CE.ListView}" Margin="0,8"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding UserName}" Style="{StaticResource CE.Body}" FontWeight="SemiBold"/><TextBlock Text="{Binding EmployeeName}" Style="{StaticResource CE.Caption}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><TextBlock Grid.Row="1" Text="Chưa có tài khoản trong nguồn dữ liệu." Visibility="{Binding HasNoAccounts,Converter={StaticResource Vis}}" Style="{StaticResource CE.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
                    <Border Grid.Column="2" Style="{StaticResource CE.Card}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Mã quyền trong Screen Spec" Style="{StaticResource CE.SectionHeading}"/><TextBlock Text="Các mã dưới đây cần được seed và ánh xạ ở backend." Style="{StaticResource CE.Caption}" Margin="0,4,0,0"/></StackPanel><ContentControl Grid.Row="1" Style="{StaticResource CE.Alert.Warning}" Visibility="{Binding IsCurrentAccount,Converter={StaticResource Vis}}" Margin="0,10"><TextBlock Text="Không cho tự gán hoặc nâng quyền tài khoản đang đăng nhập." TextWrapping="Wrap"/></ContentControl><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding PermissionOptions}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Code}" IsChecked="{Binding IsSelected}" Margin="4,5" IsEnabled="{Binding DataContext.CanEditPermissions,RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Grid.Row="2" Text="Chưa có danh mục quyền trong nguồn dữ liệu." Visibility="{Binding HasNoPermissions,Converter={StaticResource Vis}}" Style="{StaticResource CE.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Grid.Row="3" Content="Lưu quyền bổ sung" Command="{Binding AssignPermissionsCommand}" Style="{StaticResource CE.Button.Primary}" HorizontalAlignment="Right" Margin="0,10,0,0"/></Grid></Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
