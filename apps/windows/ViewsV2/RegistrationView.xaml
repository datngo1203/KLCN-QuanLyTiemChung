<UserControl x:Class="TiemChung.Desktop.ViewsV2.RegistrationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Language="vi-VN">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24"><StackPanel>
  <TextBlock Text="TIẾP NHẬN / A07" Style="{StaticResource CE.Caption}"/>
  <TextBlock Text="Đăng ký dịch vụ" Style="{StaticResource CE.Heading}" Margin="0,4,0,8"/>
  <Border Style="{StaticResource CE.Badge.Sample}" HorizontalAlignment="Left" Margin="0,0,0,16"><TextBlock Text="{Binding DataSourceLabel}"/></Border>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
   <StackPanel>
    <Border Style="{StaticResource CE.Card}" Margin="0,0,0,16"><StackPanel>
     <TextBlock Text="1. Khách hàng và lịch dự kiến" Style="{StaticResource CE.SectionHeading}" Margin="0,0,0,12"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Khách hàng *" Style="{StaticResource CE.Caption}"/><ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding Customer}" DisplayMemberPath="Name" Style="{StaticResource CE.ComboBox}" Margin="0,4,0,8"/>
       <TextBlock Text="Hình thức tiêm *" Style="{StaticResource CE.Caption}"/><ComboBox ItemsSource="{Binding InjectionTypes}" SelectedItem="{Binding InjectionType}" Style="{StaticResource CE.ComboBox}" Margin="0,4,0,8"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Người được tiêm *" Style="{StaticResource CE.Caption}"/><ComboBox ItemsSource="{Binding AvailableRecipients}" SelectedItem="{Binding Recipient}" DisplayMemberPath="Name" Style="{StaticResource CE.ComboBox}" Margin="0,4,0,8"/>
       <TextBlock Text="Ngày dự kiến *" Style="{StaticResource CE.Caption}"/><DatePicker SelectedDate="{Binding PlannedDate}" Style="{StaticResource CE.DatePicker}" Margin="0,4,0,8"/></StackPanel>
     </Grid>
     <TextBlock Text="Giờ dự kiến * (HH:mm)" Style="{StaticResource CE.Caption}"/><TextBox Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}" Width="130" HorizontalAlignment="Left" Margin="0,4,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource CE.Card}" Margin="0,0,0,16"><StackPanel>
     <TextBlock Text="2. Dịch vụ vắc xin lẻ và gói" Style="{StaticResource CE.SectionHeading}" Margin="0,0,0,12"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="100"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox ItemsSource="{Binding Catalog}" SelectedItem="{Binding CatalogItem}" DisplayMemberPath="Name" Style="{StaticResource CE.ComboBox}" AutomationProperties.Name="Chọn vắc xin hoặc gói"/>
      <TextBox Grid.Column="2" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}" AutomationProperties.Name="Số lượng"/>
      <Button Grid.Column="4" Content="Thêm dịch vụ" Command="{Binding AddLineCommand}" Style="{StaticResource CE.Button.Secondary}"/>
     </Grid>
     <ContentControl Style="{StaticResource CE.Alert.Warning}" Margin="0,12,0,0" Visibility="{Binding IsOutOfStock, Converter={StaticResource Visible}}"><StackPanel><TextBlock Text="Vắc xin tạm hết. Có thể thêm khách vào hàng đợi mẫu."/><Button Content="Thêm vào hàng đợi" Command="{Binding ThemVaoHangDoiCommand}" Style="{StaticResource CE.Button.Secondary}" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></ContentControl>
     <TextBlock Text="Chưa có dịch vụ trong đăng ký." Margin="0,12,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CE.Caption}"><Style.Triggers><DataTrigger Binding="{Binding Lines.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers><Setter Property="Visibility" Value="Collapsed"/></Style></TextBlock.Style></TextBlock>
     <ItemsControl ItemsSource="{Binding Lines}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource CE.CardBorder}" BorderThickness="0,0,0,1" Padding="0,6"><DockPanel>
      <Button DockPanel.Dock="Right" Content="Xóa" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource CE.Button.Ghost}"/>
      <TextBlock DockPanel.Dock="Right" Text="{Binding TotalLabel}" Width="120" TextAlignment="Right" Style="{StaticResource CE.Body}"/>
      <StackPanel><TextBlock Text="{Binding Name}" Style="{StaticResource CE.Body}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Kind}" Style="{StaticResource CE.Caption}"/><TextBlock Text=" · SL: " Style="{StaticResource CE.Caption}"/><TextBlock Text="{Binding QuantityLabel}" Style="{StaticResource CE.Caption}"/><TextBlock Text=" · Giá: " Style="{StaticResource CE.Caption}"/><TextBlock Text="{Binding PriceLabel}" Style="{StaticResource CE.Caption}"/></StackPanel></StackPanel>
     </DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></Border>
    <Border Style="{StaticResource CE.Card}"><StackPanel>
     <TextBlock Text="3. Khuyến mãi và tổng tạm tính" Style="{StaticResource CE.SectionHeading}" Margin="0,0,0,12"/>
     <TextBlock Text="Khuyến mãi" Style="{StaticResource CE.Caption}"/><ComboBox ItemsSource="{Binding Promotions}" SelectedItem="{Binding Promotion}" Style="{StaticResource CE.ComboBox}" Margin="0,4,0,8"/>
     <TextBlock Text="{Binding PriceNote}" Style="{StaticResource CE.Caption}" Margin="0,0,0,12"/>
     <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding SubtotalLabel}" Style="{StaticResource CE.SectionHeading}"/><TextBlock Text="Tổng tạm tính" Style="{StaticResource CE.Body}"/></DockPanel>
     <TextBlock Text="{Binding FormError}" Foreground="{StaticResource CE.Danger.Foreground}" Margin="0,12,0,8"/>
     <Button Content="Tạo đăng ký" Command="{Binding TaoDangKyCommand}" Style="{StaticResource CE.Button.Primary}" HorizontalAlignment="Left"/>
    </StackPanel></Border>
   </StackPanel>
   <Border Grid.Column="2" Style="{StaticResource CE.Card}" VerticalAlignment="Top"><StackPanel>
    <TextBlock Text="Danh sách đăng ký" Style="{StaticResource CE.SectionHeading}" Margin="0,0,0,12"/>
    <TextBlock Text="Chưa có đăng ký."><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CE.Caption}"><Style.Triggers><DataTrigger Binding="{Binding Registrations.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers><Setter Property="Visibility" Value="Collapsed"/></Style></TextBlock.Style></TextBlock>
    <ItemsControl ItemsSource="{Binding Registrations}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource CE.CardBorder}" BorderThickness="0,0,0,1" Padding="0,8"><StackPanel>
     <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding TotalLabel}" Style="{StaticResource CE.Body}"/><TextBlock Text="{Binding Code}" Style="{StaticResource CE.Body}" FontWeight="SemiBold"/></DockPanel>
     <TextBlock Text="{Binding RecipientName}" Style="{StaticResource CE.Caption}" Margin="0,4"/>
     <Border Style="{StaticResource CE.Badge.Pending}" HorizontalAlignment="Left"><TextBlock Text="{Binding Status}"/></Border>
    </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></Border>
  </Grid>
  <TextBlock Text="{Binding Feedback}" Style="{StaticResource CE.Caption}" Margin="0,12,0,0"/>
 </StackPanel></ScrollViewer>
</UserControl>
