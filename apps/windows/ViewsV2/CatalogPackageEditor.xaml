<UserControl x:Class="TiemChung.Desktop.ViewsV2.CatalogPackageEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TiemChung.Desktop.ViewsV2"
             KeyboardNavigation.TabNavigation="Local">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource CE.SectionHeading}">
            <Setter Property="Margin" Value="0,14,0,8"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource CE.TextBox}">
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CE.Caption}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,6"/>
        </Style>
    </UserControl.Resources>
    <StackPanel IsEnabled="{Binding CanInteract}">
        <TextBlock Text="Định danh và trạng thái" Style="{StaticResource CE.SectionHeading}" Margin="0,0,0,8"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Mã nghiệp vụ *"/>
                <TextBox Text="{Binding Code,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CodeReadOnly}"
                         MaxLength="50" Style="{StaticResource Field}" AutomationProperties.Name="Mã gói"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Trạng thái"/>
                <ComboBox ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Status}" IsEnabled="{Binding CanEdit}" Margin="0,4,0,10"
                          Style="{StaticResource CE.ComboBox}" AutomationProperties.Name="Trạng thái gói"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="Tên gói *"/>
        <TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"
                 Style="{StaticResource Field}" AutomationProperties.Name="Tên gói"/>

        <TextBlock Text="Đối tượng và mô tả" Style="{StaticResource Section}"/>
        <TextBlock Text="Đối tượng tham khảo *"/>
        <TextBox Text="{Binding TargetAudience,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"
                 MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"
                 Style="{StaticResource Field}" AutomationProperties.Name="Đối tượng tham khảo"/>
        <TextBlock Text="Mô tả"/>
        <TextBox Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"
                 MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54"
                 Style="{StaticResource Field}" AutomationProperties.Name="Mô tả gói"/>

        <TextBlock Text="Thành phần gói" Style="{StaticResource Section}"/>
        <StackPanel Visibility="{Binding CanWrite,Converter={StaticResource Vis}}">
            <TextBlock Text="Tìm theo mã, tên, hãng hoặc phòng bệnh" Style="{StaticResource Hint}"/>
            <TextBox Text="{Binding ComponentSearch,UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Field}" AutomationProperties.Name="Tìm vắc xin thành phần"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding ComponentCandidates}" SelectedItem="{Binding ComponentCandidate}"
                          Style="{StaticResource CE.ComboBox}" AutomationProperties.Name="Kết quả tìm vắc xin"
                          MaxDropDownHeight="220" Margin="0,0,8,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{Binding Code,Mode=OneWay}"/><Run Text=" — "/><Run Text="{Binding Name,Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource CE.Caption}"/>
                                <TextBlock Text="{Binding Manufacturer}" Style="{StaticResource CE.Caption}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Content="Thêm" Command="{Binding AddComponentCommand}"
                        Style="{StaticResource CE.Button.Secondary}" AutomationProperties.Name="Thêm vắc xin đã chọn"/>
            </Grid>
            <TextBlock Text="{Binding CandidateHint}" Style="{StaticResource Hint}"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding PackageComponents}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource CE.Border}" BorderThickness="0,1,0,0" Padding="0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="64"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource CE.Caption}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Số lượng" Style="{StaticResource CE.Caption}"/>
                                <TextBox Text="{Binding Quantity,UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding DataContext.IsReadOnly,RelativeSource={RelativeSource AncestorType=local:CatalogPackageEditor}}"
                                         Style="{StaticResource CE.TextBox}" AutomationProperties.Name="{Binding Label,StringFormat='Số lượng — {0}'}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Gỡ" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                    Command="{Binding DataContext.RemoveComponentCommand,RelativeSource={RelativeSource AncestorType=local:CatalogPackageEditor}}"
                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label,StringFormat='Gỡ — {0}'}"
                                    Visibility="{Binding DataContext.CanWrite,RelativeSource={RelativeSource AncestorType=local:CatalogPackageEditor},Converter={StaticResource Vis}}"
                                    Style="{StaticResource CE.Button.Secondary}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Tổng hợp" Style="{StaticResource Section}"/>
        <TextBlock Text="{Binding ComponentSummary}" TextWrapping="Wrap" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding ComponentDiseases,StringFormat='Phòng bệnh: {0}'}" Style="{StaticResource Hint}"/>

        <TextBlock Text="Giá" Style="{StaticResource Section}"/>
        <TextBlock Text="Giá gói (VND) *"/>
        <local:VndMoneyInput RawText="{Binding Price,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"
                             Style="{StaticResource Field}" AutomationProperties.Name="Giá gói VND"/>
        <TextBlock Text="Giá gói được cấu hình độc lập với giá lẻ của các vắc xin thành phần." Style="{StaticResource Hint}"/>
    </StackPanel>
</UserControl>
