<Window x:Class="TiemChung.Desktop.ViewsV2.InventoryReceivingWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Nhập lô vắc xin — VAC" Width="800" Height="690" MinWidth="620" MinHeight="480"
 WindowStartupLocation="CenterOwner" Background="{StaticResource CE.Canvas}">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14">
   <TextBlock Text="Nhập lô vắc xin" Style="{StaticResource CE.Heading}"/>
   <TextBlock Text="Một lô mới từ nhà cung cấp · Không nhập bổ sung lô đã có" Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,10,0">
    <TextBlock Text="Cần Thủ kho Active có XemKho và NhapKho. Không tự cấp quyền nhập." TextWrapping="Wrap">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NoAccess}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
    <Border Style="{StaticResource CE.Card}" Padding="16">
     <StackPanel>
      <TextBlock Text="1. Chọn vắc xin" Style="{StaticResource CE.SectionHeading}"/>
      <WrapPanel Margin="0,10" IsEnabled="{Binding CanEdit}">
       <TextBox x:Name="VaccineSearch" Width="230" MaxLength="100" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}" AutomationProperties.Name="Tìm vắc xin">
        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding FindCommand}"/></TextBox.InputBindings>
       </TextBox>
       <Button Content="Tìm / Tải lại" Command="{Binding FindCommand}" Style="{StaticResource CE.Button.Secondary}" Margin="8,0"/>
       <Button Content="Trước" Command="{Binding PreviousCommand}" Style="{StaticResource CE.Button.Secondary}"/>
       <Button Content="Sau" Command="{Binding NextCommand}" Style="{StaticResource CE.Button.Secondary}" Margin="8,0,0,0"/>
      </WrapPanel>
      <ComboBox ItemsSource="{Binding Vaccines}" SelectedItem="{Binding Vaccine}" IsEnabled="{Binding CanEdit}" Style="{StaticResource CE.ComboBox}" AutomationProperties.Name="Vắc xin SQL">
       <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="{Binding Vaccine.Name,StringFormat=Đã chọn: {0}}" TextWrapping="Wrap" Margin="0,6,0,0"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource CE.Card}" Padding="16" Margin="0,12,0,0">
     <StackPanel IsEnabled="{Binding CanEdit}">
      <TextBlock Text="2. Đối chiếu lô và chứng từ" Style="{StaticResource CE.SectionHeading}"/>
      <Grid Margin="0,10,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><Label Content="Số lô *" Target="{Binding ElementName=LotInput}"/><TextBox x:Name="LotInput" MaxLength="80" Text="{Binding LotNumber,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}"/></StackPanel>
       <StackPanel Grid.Column="2"><Label Content="Số lượng thực nhận *" Target="{Binding ElementName=QuantityInput}"/><TextBox x:Name="QuantityInput" MaxLength="10" Text="{Binding Quantity,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}"/></StackPanel>
       <StackPanel Grid.Row="1" Margin="0,8,0,0"><Label Content="Ngày sản xuất *" Target="{Binding ElementName=ManufacturedInput}"/><DatePicker x:Name="ManufacturedInput" SelectedDate="{Binding ManufacturedOn}" DateValidationError="InvalidDate" Style="{StaticResource CE.DatePicker}"/></StackPanel>
       <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0"><Label Content="Hạn sử dụng *" Target="{Binding ElementName=ExpiryInput}"/><DatePicker x:Name="ExpiryInput" SelectedDate="{Binding ExpiresOn}" DateValidationError="InvalidDate" Style="{StaticResource CE.DatePicker}"/></StackPanel>
       <StackPanel Grid.Row="2" Margin="0,8,0,0"><Label Content="Nhà cung cấp theo chứng từ *" Target="{Binding ElementName=SupplierInput}"/><TextBox x:Name="SupplierInput" MaxLength="200" Text="{Binding SupplierName,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}"/></StackPanel>
       <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,8,0,0"><Label Content="Số chứng từ giao nhận *" Target="{Binding ElementName=DocumentInput}"/><TextBox x:Name="DocumentInput" MaxLength="100" Text="{Binding DocumentNumber,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}"/></StackPanel>
      </Grid>
      <Label Content="Vị trí bảo quản *" Target="{Binding ElementName=LocationInput}" Margin="0,8,0,0"/>
      <TextBox x:Name="LocationInput" MaxLength="200" Text="{Binding StorageLocation,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CE.TextBox}"/>
      <CheckBox Content="Đã kiểm tra, đủ điều kiện tiếp nhận" IsChecked="{Binding InspectionConfirmed}" Style="{StaticResource CE.CheckBox}" Margin="0,12,0,0"/>
      <TextBlock Text="Xác nhận đã đối chiếu chứng từ với hàng thực nhận, kiểm tình trạng lô và điều kiện bảo quản." TextWrapping="Wrap" Margin="0,4,0,0"/>
      <TextBlock Text="Nếu có sai lệch, chưa xác nhận nhập. CẦN BỔ SUNG biểu mẫu/tiêu chuẩn nội bộ; đây là form mô phỏng khóa luận." TextWrapping="Wrap" Style="{StaticResource CE.Caption}" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
    <TextBlock Text="{Binding Validation}" TextWrapping="Wrap" Style="{StaticResource CE.Caption}" Margin="0,12,0,0"/>
    <TextBlock x:Name="ReceiptResult" Text="{Binding ResultLabel}" TextWrapping="Wrap" FontWeight="SemiBold" Focusable="{Binding HasResult}" Margin="0,12,0,8"/>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,12,0,0">
   <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
   <WrapPanel HorizontalAlignment="Right">
    <Button Content="Tạo bản nháp mới" Click="NewDraft" IsEnabled="{Binding CanStartNew}" Style="{StaticResource CE.Button.Secondary}" Margin="0,0,8,6"/>
    <Button Content="GET đối chiếu" Command="{Binding ReconcileCommand}" Style="{StaticResource CE.Button.Secondary}" Margin="0,0,8,6"/>
    <Button Content="Thử lại yêu cầu cũ" Command="{Binding RetryCommand}" Style="{StaticResource CE.Button.Secondary}" Margin="0,0,8,6"/>
    <Button Content="Xem lại &amp; Nhập lô" Click="ConfirmReceipt" IsEnabled="{Binding CanSave}" Style="{StaticResource CE.Button.Primary}" Margin="0,0,0,6"/>
   </WrapPanel>
  </StackPanel>
 </Grid>
</Window>
