<UserControl x:Class="TiemChung.Desktop.ViewsV2.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24">
        <Border Style="{StaticResource CE.Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding Screen.Title}" Style="{StaticResource CE.Text.PageTitle}" />
                <TextBlock Text="Trang đang chờ triển khai." Style="{StaticResource CE.Text.Secondary}" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
