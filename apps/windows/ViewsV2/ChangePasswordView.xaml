<UserControl x:Class="TiemChung.Desktop.ViewsV2.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TiemChung.Desktop.ViewModels">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="Vis"/>
        <DataTemplate DataType="{x:Type vm:ChangePasswordViewModel}">
            <Grid Background="{StaticResource CE.Canvas}" Margin="28">
                <StackPanel>
                    <TextBlock Text="Đổi mật khẩu" Style="{StaticResource CE.Heading}"/>
                    <TextBlock Text="Cập nhật mật khẩu cho tài khoản đang đăng nhập" Style="{StaticResource CE.Caption}" Margin="0,4,0,18"/>
                    <Border Style="{StaticResource CE.Card}" Padding="22" MaxWidth="620" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Mật khẩu hiện tại" Style="{StaticResource CE.Body}" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="CurrentInput" Style="{StaticResource CE.PasswordBox}" PasswordChanged="PasswordInput_PasswordChanged" IsEnabled="{Binding IsNotBusy}" AutomationProperties.Name="Mật khẩu hiện tại"/>
                            <TextBlock Text="Mật khẩu mới" Style="{StaticResource CE.Body}" Margin="0,16,0,6"/>
                            <PasswordBox x:Name="NewInput" Style="{StaticResource CE.PasswordBox}" PasswordChanged="PasswordInput_PasswordChanged" IsEnabled="{Binding IsNotBusy}" AutomationProperties.Name="Mật khẩu mới"/>
                            <TextBlock Text="Xác nhận mật khẩu mới" Style="{StaticResource CE.Body}" Margin="0,16,0,6"/>
                            <PasswordBox x:Name="ConfirmInput" Style="{StaticResource CE.PasswordBox}" PasswordChanged="PasswordInput_PasswordChanged" IsEnabled="{Binding IsNotBusy}" AutomationProperties.Name="Xác nhận mật khẩu mới"/>
                            <TextBlock Text="Mật khẩu mới cần ít nhất 6 ký tự, khác mật khẩu hiện tại và trùng phần xác nhận." Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <Border Background="{StaticResource CE.Danger.Background}" BorderBrush="{StaticResource CE.Danger.Accent}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,14,0,0" Visibility="{Binding HasError, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding Error}" Foreground="{StaticResource CE.Danger.Foreground}" Style="{StaticResource CE.Body}" TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Text="{Binding Feedback}" Style="{StaticResource CE.Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                <Button Content="Hủy bỏ" Click="CancelClicked" Style="{StaticResource CE.Button.Secondary}" Margin="0,0,8,0"/>
                                <Button Content="Đổi mật khẩu" Command="{Binding ChangePasswordCommand}" Style="{StaticResource CE.Button.Primary}" MinWidth="140"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CE.Badge}" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="8,4">
                        <TextBlock Text="Chưa kết nối dịch vụ đổi mật khẩu; mật khẩu thật phải được bảo vệ tại máy chủ." Style="{StaticResource CE.Caption}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ContentControl Content="{Binding}"/>
</UserControl>
