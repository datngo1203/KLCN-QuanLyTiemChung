@startuml
left to right direction
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial
skinparam nodesep 35
skinparam ranksep 45
skinparam entity {
  BackgroundColor #FFFDEB
  BorderColor #333333
}
title MÔ HÌNH QUAN HỆ - HỒ SƠ VÀ TÀI KHOẢN

entity "QuyenHan" as QuyenHan {
    * MaQuyen : INT <<PK>>
    --
    TenQuyen : NVARCHAR(100)
    MoTa : NVARCHAR(500)
  }

entity "TaiKhoan" as TaiKhoan {
    * MaTaiKhoan : INT <<PK>>
    --
    MaNhanVien : INT <<FK, UK>>
    TenDangNhap : NVARCHAR(100) <<UK>>
    MatKhau : NVARCHAR(255)
    TrangThai : NVARCHAR(30)
  }

entity "NguoiDuocTiem" as NguoiDuocTiem {
    * MaNguoiDuocTiem : INT <<PK>>
    --
    MaKhachHang : INT <<FK>>
    HoTen : NVARCHAR(150)
    CCCD : VARCHAR(12) NULL
    NgaySinh : DATE
    GioiTinh : NVARCHAR(20)
    QuanHeVoiKhachHang : NVARCHAR(50)
  }

entity "NhanVien" as NhanVien {
    * MaNhanVien : INT <<PK>>
    --
    HoTen : NVARCHAR(150)
    CCCD : VARCHAR(12)
    SoDienThoai : VARCHAR(15)
    Email : NVARCHAR(254)
    BoPhan : NVARCHAR(100)
    ChucDanh : NVARCHAR(100)
    TrangThai : NVARCHAR(30)
  }

entity "TaiKhoan_QuyenHan" as TaiKhoanQuyenHan {
    * MaTaiKhoan : INT <<PK, FK>>
    * MaQuyen : INT <<PK, FK>>
  }

entity "KhachHang" as KhachHang {
    * MaKhachHang : INT <<PK>>
    --
    HoTen : NVARCHAR(150)
    CCCD : VARCHAR(12)
    SoDienThoai : VARCHAR(15)
    Email : NVARCHAR(254)
  }

NhanVien ||--o| TaiKhoan
TaiKhoan ||--o{ TaiKhoanQuyenHan
QuyenHan ||--o{ TaiKhoanQuyenHan
KhachHang ||--o{ NguoiDuocTiem
@enduml
