@startuml
title PHÂN TẦNG LỚP MỨC THIẾT KẾ
left to right direction
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam nodesep 45
skinparam ranksep 55
skinparam class {
  BackgroundColor #FFFDEB
  BorderColor #333333
  ArrowColor #333333
}
hide circle

package "Giao diện" {
  class "Giao diện Web" as UIWeb <<boundary>>
  class "Giao diện Windows" as UIWindows <<boundary>>
}
package "API / Điều khiển" {
  class "Hồ sơ API" as HoSoAPI <<control>>
  class "Dịch vụ API" as DichVuAPI <<control>>
  class "Kho API" as KhoAPI <<control>>
  class "Tiêm chủng API" as TiemChungAPI <<control>>
  class "Lịch hẹn API" as LichHenAPI <<control>>
  class "Tài khoản API" as TaiKhoanAPI <<control>>
}
package "Nghiệp vụ" {
  class "Hồ sơ service" as HoSoService <<service>>
  class "Đăng ký service" as DangKyService <<service>>
  class "Thanh toán service" as ThanhToanService <<service>>
  class "Kho service" as KhoService <<service>>
  class "Tiêm chủng service" as TiemChungService <<service>>
  class "Lịch hẹn service" as LichHenService <<service>>
  class "Tài khoản service" as TaiKhoanService <<service>>
}
package "Truy cập dữ liệu" {
  class "Hồ sơ DB" as HoSoDB <<data access>>
  class "Đăng ký DB" as DangKyDB <<data access>>
  class "Danh mục vắc xin DB" as VaccineDB <<data access>>
  class "Kho DB" as KhoDB <<data access>>
  class "Tiêm chủng DB" as TiemChungDB <<data access>>
  class "Lịch hẹn DB" as LichHenDB <<data access>>
  class "Thanh toán DB" as ThanhToanDB <<data access>>
  class "Tài khoản DB" as TaiKhoanDB <<data access>>
}

UIWeb ..> HoSoAPI
UIWeb ..> DichVuAPI
UIWeb ..> LichHenAPI
UIWindows ..> HoSoAPI
UIWindows ..> DichVuAPI
UIWindows ..> KhoAPI
UIWindows ..> TiemChungAPI
UIWindows ..> LichHenAPI
UIWindows ..> TaiKhoanAPI

HoSoAPI ..> HoSoService
DichVuAPI ..> DangKyService
DichVuAPI ..> ThanhToanService
KhoAPI ..> KhoService
TiemChungAPI ..> TiemChungService
LichHenAPI ..> LichHenService
TaiKhoanAPI ..> TaiKhoanService

HoSoService ..> HoSoDB
DangKyService ..> HoSoDB
DangKyService ..> DangKyDB
DangKyService ..> VaccineDB
ThanhToanService ..> DangKyDB
ThanhToanService ..> ThanhToanDB
KhoService ..> VaccineDB
KhoService ..> KhoDB
TiemChungService ..> VaccineDB
TiemChungService ..> TiemChungDB
LichHenService ..> TiemChungDB
LichHenService ..> LichHenDB
TaiKhoanService ..> TaiKhoanDB

@enduml
