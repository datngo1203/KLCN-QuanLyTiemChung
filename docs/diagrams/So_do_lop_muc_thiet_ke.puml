@startuml
title SƠ ĐỒ LỚP MỨC THIẾT KẾ - HỆ THỐNG QUẢN LÝ TIÊM CHỦNG
top to bottom direction
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam nodesep 55
skinparam ranksep 75
skinparam class {
  BackgroundColor #FFFDEB
  BorderColor #333333
  ArrowColor #333333
}
hide circle

class "Nhân viên" as NhanVien {
  - maNhanVien : int
  - hoTen : string
  - cccd : string
  - soDienThoai : string
  - email : string
  - boPhan : string
  - chucDanh : string
  - trangThai : string
  + capNhatThongTin(hoTen : string, soDienThoai : string, email : string) : void
}
class "Tài khoản" as TaiKhoan {
  - tenDangNhap : string
  - matKhau : string
  - trangThai : string
  + dangNhap(matKhau : string) : bool
  + dangXuat() : void
  + doiMatKhau(matKhauCu : string, matKhauMoi : string) : bool
}
class "Quyền hạn" as QuyenHan {
  - maQuyen : int
  - tenQuyen : string
  - moTa : string
}
class "Khách hàng" as KhachHang {
  - maKhachHang : int
  - hoTen : string
  - cccd : string
  - soDienThoai : string
  - email : string
  + capNhatThongTin(hoTen : string, cccd : string, soDienThoai : string, email : string) : void
  + layDanhSachNguoiDuocTiem() : List<NguoiDuocTiem>
}
class "Người được tiêm" as NguoiDuocTiem {
  - maNguoiDuocTiem : int
  - hoTen : string
  - cccd : string [0..1]
  - ngaySinh : DateTime
  - gioiTinh : string
  - quanHeVoiKhachHang : string
  + capNhatHoSo(hoTen : string, ngaySinh : DateTime, gioiTinh : string) : void
  + layLichSuTiem() : List<MuiTiem>
}
class "Đăng ký dịch vụ" as DangKyDichVu {
  - maDangKy : int
  - ngayDangKy : DateTime
  - hinhThucTiem : string
  - thoiGianDuKien : DateTime
  - trangThai : string
  + taoDangKy(ngayDangKy : DateTime, hinhThucTiem : string, thoiGianDuKien : DateTime) : int
  + capNhatDangKy(trangThai : string, thoiGianDuKien : DateTime) : bool
  + tinhTongTien() : decimal
}
class "Chi tiết vắc xin lẻ" as CTVacXin {
  - maChiTietVacXin : int
  - soLuong : int
  - giaTaiThoiDiemDangKy : decimal
  + tinhThanhTien() : decimal
}
class "Chi tiết gói vắc xin" as CTGoiVacXin {
  - maChiTietGoi : int
  - soLuongGoi : int
  - giaTaiThoiDiemDangKy : decimal
  + tinhThanhTien() : decimal
}
class "Thanh toán" as ThanhToan {
  - maThanhToan : int
  - soTien : decimal
  - phuongThuc : string
  - thoiDiem : DateTime
  - loaiThanhToan : string
  - trangThai : string
  + thucHienThanhToan(soTien : decimal, phuongThuc : string) : bool
  + xacNhanThanhToan(maGiaoDich : string) : bool
}
class "Khuyến mãi" as KhuyenMai {
  - maKhuyenMai : int
  - tenKhuyenMai : string
  - noiDung : string
  - thoiGianBatDau : DateTime
  - thoiGianKetThuc : DateTime
  - mucUuDai : decimal
  + kiemTraHieuLuc(thoiDiem : DateTime) : bool
}
class "Loại tiêm chủng" as LoaiTiemChung {
  - maLoaiTiemChung : int
  - tenLoaiTiemChung : string
  - moTa : string
}
class "Loại vắc xin" as LoaiVacXin {
  - maLoaiVacXin : int
  - tenLoaiVacXin : string
  - moTa : string
  + capNhatLoai(tenLoai : string, moTa : string) : void
}
class "Bệnh" as Benh {
  - maBenh : int
  - tenBenh : string
  - moTa : string
}
class "Vắc xin" as VacXin {
  - maVacXin : int
  - tenVacXin : string
  - nhaSanXuat : string
  - xuatXu : string
  - lieuLuong : string
  - theTich : decimal
  - phanUngSauTiem : string
  - gia : decimal
  - trangThai : string
  + traCuuThongTin() : string
  + kiemTraKhaDung(soLuong : int) : bool
}
class "Gói vắc xin" as GoiVacXin {
  - maGoi : int
  - tenGoi : string
  - giaGoi : decimal
  - trangThai : string
  + kiemTraKhaDung() : bool
  + tinhGiaGoi() : decimal
}
class "Lô vắc xin" as LoVacXin {
  - soLo : string
  - ngaySanXuat : DateTime
  - hanSuDung : DateTime
  - soLuongBanDau : int
  - soLuongTon : int
  - trangThai : string
  + kiemTraHanDung(ngayKiemTra : DateTime) : bool
  + capNhatTonKho(soLuongThayDoi : int) : int
}
class "Biến động kho" as BienDongKho {
  - maBienDong : int
  - loaiBienDong : string
  - soLuong : int
  - thoiDiem : DateTime
  + ghiNhanNhap(soLuong : int, thoiDiem : DateTime) : void
  + ghiNhanXuat(soLuong : int, thoiDiem : DateTime) : void
}
class "Chỉ định tiêm" as ChiDinhTiem {
  - maChiDinh : int
  - ketQuaChiDinh : string
  - thoiGian : DateTime
  - ghiChu : string
  + xacNhanChiDinh(ketQua : string, ghiChu : string) : bool
}
class "Phiếu khám sàng lọc" as PhieuKhamSangLoc {
  - maPhieuKham : int
  - chiSoSinhTon : string
  - tienSuBenhLy : string
  - ketLuan : string
  - lyDoHoan : string
  + ghiNhanKetQua(chiSoSinhTon : string, tienSuBenhLy : string) : void
  + ketLuanSangLoc(ketLuan : string, lyDoHoan : string) : bool
}
class "Mũi tiêm" as MuiTiem {
  - maMuiTiem : int
  - thoiDiemTiem : DateTime
  - viTriTiem : string
  - trangThai : string
  + ghiNhanMuiTiem(thoiDiem : DateTime, viTriTiem : string) : bool
}
class "Theo dõi sau tiêm" as TheoDoiSauTiem {
  - maTheoDoi : int
  - tinhTrang : string
  - mucDoPhanUng : string
  - huongXuTri : string
  - thoiDiem : DateTime
  + capNhatTinhTrang(tinhTrang : string, thoiDiem : DateTime) : void
  + ghiNhanPhanUng(mucDoPhanUng : string, huongXuTri : string) : void
}
class "Lịch hẹn tiêm" as LichHenTiem {
  - maLichHen : int
  - thoiGianHen : DateTime
  - diemTiem : string
  - trangThai : string
  + doiLich(thoiGianMoi : DateTime) : bool
  + huyLich(lyDo : string) : bool
}
class "Nhắc lịch" as NhacLich {
  - maNhacLich : int
  - kenhGui : string
  - thoiDiemGui : DateTime
  - trangThai : string
  + guiNhacLich() : bool
}
class "Hàng đợi vắc xin" as HangDoiVacXin {
  - maHangDoi : int
  - thoiDiemVaoHang : DateTime
  - trangThai : string
  + capNhatTrangThai(trangThai : string) : void
}

NhanVien -- "0..1" TaiKhoan
NhanVien -- "0..*" DangKyDichVu
NhanVien -- "0..*" PhieuKhamSangLoc
NhanVien -- "0..*" MuiTiem
NhanVien -- "0..*" ThanhToan
NhanVien -- "0..*" BienDongKho
TaiKhoan "0..*" -- "0..*" QuyenHan
KhachHang -- "0..*" NguoiDuocTiem
KhachHang -- "0..*" DangKyDichVu
NguoiDuocTiem -- "0..*" DangKyDichVu
DangKyDichVu *-- "0..*" CTVacXin
DangKyDichVu *-- "0..*" CTGoiVacXin
CTVacXin "0..*" --> VacXin
CTGoiVacXin "0..*" --> GoiVacXin
DangKyDichVu -- "0..*" ThanhToan
KhuyenMai "0..1" -- "0..*" DangKyDichVu
LoaiVacXin -- "0..*" VacXin
LoaiTiemChung -- "0..*" VacXin
VacXin "0..*" -- "1..*" Benh
GoiVacXin "0..*" -- "1..*" VacXin
VacXin -- "0..*" LoVacXin
LoVacXin -- "0..*" BienDongKho
ChiDinhTiem "0..*" --> VacXin
PhieuKhamSangLoc -- "0..*" ChiDinhTiem
DangKyDichVu -- "0..*" PhieuKhamSangLoc
NguoiDuocTiem -- "0..*" PhieuKhamSangLoc
NguoiDuocTiem -- "0..*" MuiTiem
LoVacXin -- "0..*" MuiTiem
MuiTiem -- "0..1" TheoDoiSauTiem
NguoiDuocTiem -- "0..*" LichHenTiem
LichHenTiem -- "0..*" NhacLich
DangKyDichVu -- "0..*" HangDoiVacXin
HangDoiVacXin "0..*" --> VacXin
@enduml
