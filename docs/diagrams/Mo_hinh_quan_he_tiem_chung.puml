@startuml
title MÔ HÌNH QUAN HỆ - HỆ THỐNG QUẢN LÝ TIÊM CHỦNG
top to bottom direction
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam nodesep 35
skinparam ranksep 50
skinparam entity {
  BackgroundColor #FFFDEB
  BorderColor #333333
}

package "Tài khoản và hồ sơ" {
  entity "NhanVien" as NhanVien {
    * MaNhanVien : INT <<PK>>
    --
    HoTen : NVARCHAR(150)
    CCCD : VARCHAR(12)
    SoDienThoai : VARCHAR(15)
    Email : NVARCHAR(254)
    BoPhan : NVARCHAR(100)
    ChucDanh : NVARCHAR(100)
    TrangThai : NVARCHAR(30)
  }
  entity "TaiKhoan" as TaiKhoan {
    * MaTaiKhoan : INT <<PK>>
    --
    MaNhanVien : INT <<FK, UK>>
    TenDangNhap : NVARCHAR(100) <<UK>>
    MatKhau : NVARCHAR(255)
    TrangThai : NVARCHAR(30)
  }
  entity "QuyenHan" as QuyenHan {
    * MaQuyen : INT <<PK>>
    --
    TenQuyen : NVARCHAR(100)
    MoTa : NVARCHAR(500)
  }
  entity "TaiKhoan_QuyenHan" as TaiKhoanQuyenHan {
    * MaTaiKhoan : INT <<PK, FK>>
    * MaQuyen : INT <<PK, FK>>
  }
  entity "KhachHang" as KhachHang {
    * MaKhachHang : INT <<PK>>
    --
    HoTen : NVARCHAR(150)
    CCCD : VARCHAR(12)
    SoDienThoai : VARCHAR(15)
    Email : NVARCHAR(254)
  }
  entity "NguoiDuocTiem" as NguoiDuocTiem {
    * MaNguoiDuocTiem : INT <<PK>>
    --
    MaKhachHang : INT <<FK>>
    HoTen : NVARCHAR(150)
    CCCD : VARCHAR(12) NULL
    NgaySinh : DATE
    GioiTinh : NVARCHAR(20)
    QuanHeVoiKhachHang : NVARCHAR(50)
  }
}

package "Đăng ký và thanh toán" {
  entity "DangKyDichVu" as DangKyDichVu {
    * MaDangKy : INT <<PK>>
    --
    MaKhachHang : INT <<FK>>
    MaNguoiDuocTiem : INT <<FK>>
    MaNhanVien : INT <<FK>>
    MaKhuyenMai : INT <<FK, NULL>>
    NgayDangKy : DATETIME2
    HinhThucTiem : NVARCHAR(50)
    ThoiGianDuKien : DATETIME2
    TrangThai : NVARCHAR(30)
  }
  entity "ChiTietVacXinLe" as CTVacXin {
    * MaChiTietVacXin : INT <<PK>>
    --
    MaDangKy : INT <<FK>>
    MaVacXin : INT <<FK>>
    SoLuong : INT
    GiaTaiThoiDiemDangKy : DECIMAL(18,2)
  }
  entity "ChiTietGoiVacXin" as CTGoiVacXin {
    * MaChiTietGoi : INT <<PK>>
    --
    MaDangKy : INT <<FK>>
    MaGoi : INT <<FK>>
    SoLuongGoi : INT
    GiaTaiThoiDiemDangKy : DECIMAL(18,2)
  }
  entity "ThanhToan" as ThanhToan {
    * MaThanhToan : INT <<PK>>
    --
    MaDangKy : INT <<FK>>
    MaNhanVien : INT <<FK>>
    SoTien : DECIMAL(18,2)
    PhuongThuc : NVARCHAR(50)
    ThoiDiem : DATETIME2
    LoaiThanhToan : NVARCHAR(30)
    TrangThai : NVARCHAR(30)
  }
  entity "KhuyenMai" as KhuyenMai {
    * MaKhuyenMai : INT <<PK>>
    --
    TenKhuyenMai : NVARCHAR(150)
    NoiDung : NVARCHAR(500)
    ThoiGianBatDau : DATETIME2
    ThoiGianKetThuc : DATETIME2
    MucUuDai : DECIMAL(8,2)
  }
}

package "Danh mục và kho vắc xin" {
  entity "LoaiTiemChung" as LoaiTiemChung {
    * MaLoaiTiemChung : INT <<PK>>
    --
    TenLoaiTiemChung : NVARCHAR(120)
    MoTa : NVARCHAR(500)
  }
  entity "LoaiVacXin" as LoaiVacXin {
    * MaLoaiVacXin : INT <<PK>>
    --
    TenLoaiVacXin : NVARCHAR(120)
    MoTa : NVARCHAR(500)
  }
  entity "Benh" as Benh {
    * MaBenh : INT <<PK>>
    --
    TenBenh : NVARCHAR(150)
    MoTa : NVARCHAR(500)
  }
  entity "VacXin" as VacXin {
    * MaVacXin : INT <<PK>>
    --
    MaLoaiVacXin : INT <<FK>>
    MaLoaiTiemChung : INT <<FK>>
    TenVacXin : NVARCHAR(150)
    NhaSanXuat : NVARCHAR(150)
    XuatXu : NVARCHAR(100)
    LieuLuong : NVARCHAR(100)
    TheTich : DECIMAL(10,2)
    PhanUngSauTiem : NVARCHAR(1000)
    Gia : DECIMAL(18,2)
    TrangThai : NVARCHAR(30)
  }
  entity "VacXin_Benh" as VacXinBenh {
    * MaVacXin : INT <<PK, FK>>
    * MaBenh : INT <<PK, FK>>
  }
  entity "GoiVacXin" as GoiVacXin {
    * MaGoi : INT <<PK>>
    --
    TenGoi : NVARCHAR(150)
    GiaGoi : DECIMAL(18,2)
    TrangThai : NVARCHAR(30)
  }
  entity "GoiVacXin_VacXin" as GoiVacXinVacXin {
    * MaGoi : INT <<PK, FK>>
    * MaVacXin : INT <<PK, FK>>
    SoLuong : INT
  }
  entity "LoVacXin" as LoVacXin {
    * SoLo : NVARCHAR(80) <<PK>>
    --
    MaVacXin : INT <<FK>>
    NgaySanXuat : DATE
    HanSuDung : DATE
    SoLuongBanDau : INT
    SoLuongTon : INT
    TrangThai : NVARCHAR(30)
  }
  entity "BienDongKho" as BienDongKho {
    * MaBienDong : INT <<PK>>
    --
    SoLo : NVARCHAR(80) <<FK>>
    MaNhanVien : INT <<FK>>
    LoaiBienDong : NVARCHAR(30)
    SoLuong : INT
    ThoiDiem : DATETIME2
  }
}

package "Khám, tiêm và lịch hẹn" {
  entity "PhieuKhamSangLoc" as PhieuKham {
    * MaPhieuKham : INT <<PK>>
    --
    MaDangKy : INT <<FK>>
    MaNguoiDuocTiem : INT <<FK>>
    MaNhanVien : INT <<FK>>
    ChiSoSinhTon : NVARCHAR(500)
    TienSuBenhLy : NVARCHAR(1000)
    KetLuan : NVARCHAR(500)
    LyDoHoan : NVARCHAR(500) NULL
  }
  entity "ChiDinhTiem" as ChiDinhTiem {
    * MaChiDinh : INT <<PK>>
    --
    MaPhieuKham : INT <<FK>>
    MaVacXin : INT <<FK>>
    KetQuaChiDinh : NVARCHAR(50)
    ThoiGian : DATETIME2
    GhiChu : NVARCHAR(500)
  }
  entity "MuiTiem" as MuiTiem {
    * MaMuiTiem : INT <<PK>>
    --
    MaNguoiDuocTiem : INT <<FK>>
    SoLo : NVARCHAR(80) <<FK>>
    MaNhanVien : INT <<FK>>
    ThoiDiemTiem : DATETIME2
    ViTriTiem : NVARCHAR(100)
    TrangThai : NVARCHAR(30)
  }
  entity "TheoDoiSauTiem" as TheoDoiSauTiem {
    * MaTheoDoi : INT <<PK>>
    --
    MaMuiTiem : INT <<FK, UK>>
    TinhTrang : NVARCHAR(100)
    MucDoPhanUng : NVARCHAR(100)
    HuongXuTri : NVARCHAR(500)
    ThoiDiem : DATETIME2
  }
  entity "LichHenTiem" as LichHenTiem {
    * MaLichHen : INT <<PK>>
    --
    MaNguoiDuocTiem : INT <<FK>>
    ThoiGianHen : DATETIME2
    DiemTiem : NVARCHAR(200)
    TrangThai : NVARCHAR(30)
  }
  entity "NhacLich" as NhacLich {
    * MaNhacLich : INT <<PK>>
    --
    MaLichHen : INT <<FK>>
    KenhGui : NVARCHAR(30)
    ThoiDiemGui : DATETIME2
    TrangThai : NVARCHAR(30)
  }
  entity "HangDoiVacXin" as HangDoiVacXin {
    * MaHangDoi : INT <<PK>>
    --
    MaDangKy : INT <<FK>>
    MaVacXin : INT <<FK>>
    ThoiDiemVaoHang : DATETIME2
    TrangThai : NVARCHAR(30)
  }
}

NhanVien ||--o| TaiKhoan
TaiKhoan ||--o{ TaiKhoanQuyenHan
QuyenHan ||--o{ TaiKhoanQuyenHan
KhachHang ||--o{ NguoiDuocTiem
KhachHang ||--o{ DangKyDichVu
NguoiDuocTiem ||--o{ DangKyDichVu
NhanVien ||--o{ DangKyDichVu
KhuyenMai |o--o{ DangKyDichVu
DangKyDichVu ||--o{ CTVacXin
VacXin ||--o{ CTVacXin
DangKyDichVu ||--o{ CTGoiVacXin
GoiVacXin ||--o{ CTGoiVacXin
DangKyDichVu ||--o{ ThanhToan
NhanVien ||--o{ ThanhToan
LoaiVacXin ||--o{ VacXin
LoaiTiemChung ||--o{ VacXin
VacXin ||--o{ VacXinBenh
Benh ||--o{ VacXinBenh
GoiVacXin ||--o{ GoiVacXinVacXin
VacXin ||--o{ GoiVacXinVacXin
VacXin ||--o{ LoVacXin
LoVacXin ||--o{ BienDongKho
NhanVien ||--o{ BienDongKho
DangKyDichVu ||--o{ PhieuKham
NguoiDuocTiem ||--o{ PhieuKham
NhanVien ||--o{ PhieuKham
PhieuKham ||--o{ ChiDinhTiem
VacXin ||--o{ ChiDinhTiem
NguoiDuocTiem ||--o{ MuiTiem
LoVacXin ||--o{ MuiTiem
NhanVien ||--o{ MuiTiem
MuiTiem ||--o| TheoDoiSauTiem
NguoiDuocTiem ||--o{ LichHenTiem
LichHenTiem ||--o{ NhacLich
DangKyDichVu ||--o{ HangDoiVacXin
VacXin ||--o{ HangDoiVacXin

@enduml
