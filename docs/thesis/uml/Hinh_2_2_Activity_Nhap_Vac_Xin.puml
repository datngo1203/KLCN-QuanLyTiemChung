@startuml
' HUIT UML Visual Profile v1 - compact data-aware layout
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 16
skinparam ArrowColor black
skinparam ActivityBorderColor black
skinparam ActivityBackgroundColor white
skinparam PartitionBorderColor black
skinparam PartitionBackgroundColor white
skinparam nodesep 20
skinparam ranksep 24
skinparam dpi 180

|Nhà cung cấp|
start
:Bàn giao lô vắc xin\nvà chứng từ giao nhận;

|Nhân viên kho|
:Đối chiếu lô, chứng từ\nvà điều kiện giao nhận;

if (Đủ căn cứ tiếp nhận?) then (Có)
else (Không)
  :Giữ lô tách biệt và\nlàm rõ sai lệch;
  if (Sai lệch đã được xử lý?) then (Có)
  else (Không)
    :Ghi nhận trạng thái\nchưa tiếp nhận;
    stop
  endif
endif

:Xác nhận tiếp nhận và\nghi nhận thông tin lô;
:Sắp xếp, bảo quản lô;
:Cập nhật tồn kho;
stop
@enduml
