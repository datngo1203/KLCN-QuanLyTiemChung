@startuml
' HUIT UML Visual Profile v1 - compact data-aware layout
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 16
skinparam ArrowColor black
skinparam ActivityBorderColor black
skinparam ActivityBackgroundColor white
skinparam PartitionBorderColor black
skinparam PartitionBackgroundColor white
skinparam nodesep 20
skinparam ranksep 24
skinparam dpi 180

|Bác sĩ|
start
:Tiếp nhận Người được tiêm\nvà lần phục vụ;
:Xem hồ sơ, đăng ký\nvà lịch sử tiêm;
:Khai thác sức khỏe và\nthực hiện khám sàng lọc;
:Ghi nhận kết quả và\nkết luận chuyên môn;

if (Đủ điều kiện tiêm?) then (Có)
  :Ghi nhận chỉ định vắc xin;
  stop
else (Không)
  if (Tạm hoãn?) then (Có)
    :Ghi nhận lý do tạm hoãn;
    stop
  else (Không)
    :Ghi nhận chống chỉ định\nhoặc cần đánh giá thêm;
    stop
  endif
endif
@enduml
