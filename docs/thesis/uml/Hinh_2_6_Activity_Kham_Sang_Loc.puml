@startuml
' HUIT UML Visual Profile v1 - compact-fixed layout
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 16
skinparam ArrowColor black
skinparam ActivityBorderColor black
skinparam ActivityBackgroundColor white
skinparam PartitionBorderColor black
skinparam PartitionBackgroundColor white
skinparam dpi 180

|Bác sĩ|
start
:Tiếp nhận Người được tiêm\nvà xác định lần phục vụ liên quan;
:Xem hồ sơ, thông tin đăng ký\nvà lịch sử tiêm chủng cần thiết;
:Khai thác thông tin sức khỏe\nvà thực hiện khám sàng lọc;
:Đánh giá tình trạng\ntại thời điểm khám;
:Ghi nhận kết quả khám sàng lọc\nvà kết luận chuyên môn;

if (Đủ điều kiện tiêm?) then (Có)
  :Ghi nhận chỉ định vắc xin\nphù hợp cho lần phục vụ;
  stop
else (Không)
  if (Tạm hoãn?) then (Có)
    :Ghi nhận kết quả\nvà lý do tạm hoãn;
    stop
  else (Không)
    :Ghi nhận kết luận chống chỉ định\nhoặc cần đánh giá thêm;
    stop
  endif
endif
@enduml
