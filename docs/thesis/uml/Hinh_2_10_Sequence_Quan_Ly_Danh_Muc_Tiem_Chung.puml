@startuml
' THESIS-R1 - HUIT/Rational Rose Sequence Diagram profile
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 16
skinparam dpi 180
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  LifeLineBackgroundColor white
  ParticipantBorderColor black
  ParticipantBackgroundColor white
  ActorBorderColor black
  ActorFontColor black
  ParticipantFontColor black
  GroupBorderColor black
  GroupBackgroundColor white
  GroupFontColor black
  MessageAlign center
}
hide footbox
autonumber

actor "Quản trị viên" as Admin
boundary "QuanLyDanhMucGD" as UI
control "DieuKhienDanhMuc" as CatalogControl
entity "QuyenHan" as Permission
entity "DanhMucTiemChung" as Catalog

Admin -> UI : moQuanLyDanhMuc()
activate UI

UI -> CatalogControl : taiDanhSach(nhom, trangThai)
activate CatalogControl
CatalogControl -> Catalog : truyVanDanhMuc(nhom, trangThai)
activate Catalog
Catalog --> CatalogControl : danhSachHienCo
deactivate Catalog
CatalogControl --> UI : duLieuDanhMuc
deactivate CatalogControl
UI --> Admin : hienThiDanhSach(duLieuDanhMuc)

Admin -> UI : chonThaoTac(hanhDong)
UI --> Admin : hienThiBieuMauHoacXacNhan(hanhDong)
Admin -> UI : nhapThongTinHoacXacNhan(duLieu)

UI -> CatalogControl : yeuCauThucHien(hanhDong, duLieu)
activate CatalogControl
CatalogControl -> Permission : kiemTraQuyen(hanhDong)
activate Permission
Permission --> CatalogControl : ketQuaQuyen
deactivate Permission

alt Không đủ quyền
  CatalogControl --> UI : tuChoiThaoTac()
  deactivate CatalogControl
  UI --> Admin : thongBaoKhongDuQuyen()
else Được phép
  CatalogControl -> Catalog : kiemTraDuLieuVaThucThi(hanhDong, duLieu)
  activate Catalog

  alt Không hợp lệ hoặc vi phạm ràng buộc
    Catalog --> CatalogControl : loiNghiepVu
    deactivate Catalog
    CatalogControl --> UI : thongBaoLoi(loiNghiepVu)
    deactivate CatalogControl
    UI --> Admin : yeuCauDieuChinhHoacGiuNguyenDuLieu()
  else Hợp lệ
    Catalog --> CatalogControl : duLieuSauThayDoi
    deactivate Catalog
    CatalogControl --> UI : ketQuaCapNhat
    deactivate CatalogControl
    UI --> Admin : hienThiKetQuaMoiNhat(ketQuaCapNhat)
  end
end

deactivate UI
@enduml
