@startuml
' THESIS-R1 - HUIT/Rational Rose Sequence Diagram profile
' UC1 - logical operations with code traceability
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 16
skinparam dpi 180
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  LifeLineBackgroundColor white
  ParticipantBorderColor black
  ParticipantBackgroundColor white
  ActorBorderColor black
  ActorFontColor black
  ParticipantFontColor black
  GroupBorderColor black
  GroupBackgroundColor white
  GroupFontColor black
  MessageAlign center
}
hide footbox
autonumber

actor "Quản trị viên" as Admin
boundary "CatalogView" as View
control "CatalogViewModel" as VM
participant "CatalogApiService" as Service

Admin -> View : moQuanLyDanhMuc()
activate View
View -> VM : khoiTaoDanhMuc()
activate VM
VM -> Service : taiDanhSach(nhom, tuKhoa, trangThai)
activate Service
Service --> VM : danhSach
deactivate Service
VM --> View : capNhatDanhSach(danhSach)
deactivate VM
View --> Admin : hienThiDanhSach()

Admin -> View : chonNhomDanhMuc(nhom)
View -> VM : chuyenNhomDanhMuc(nhom)
activate VM
VM -> Service : taiDanhSach(nhom, tuKhoa, trangThai)
activate Service
Service --> VM : danhSach
deactivate Service
VM --> View : capNhatDanhSach(danhSach)
deactivate VM
View --> Admin : hienThiDanhSach()

Admin -> View : chonThaoTac(hanhDong)

alt Không đủ quyền chỉnh sửa
  View --> Admin : thongBaoKhongDuQuyen()
else Có quyền chỉnh sửa
  alt Thêm mới hoặc cập nhật
    View --> Admin : hienThiBieuMau()
    Admin -> View : nhapThongTin(duLieu)
    View -> VM : luuDanhMuc(duLieu)
    activate VM
    VM -> Service : luuDanhMuc(nhom, id, duLieu)
    activate Service

    alt Dữ liệu không hợp lệ hoặc vi phạm ràng buộc
      Service --> VM : loiNghiepVu
      deactivate Service
      VM --> View : hienThiLoi(loiNghiepVu)
      deactivate VM
      View --> Admin : yeuCauDieuChinh()
    else Lưu thành công
      Service --> VM : danhMucDaLuu
      deactivate Service
      VM -> Service : taiDanhSach(nhom, tuKhoa, trangThai)
      activate Service
      Service --> VM : danhSachMoi
      deactivate Service
      VM --> View : capNhatDanhSach(danhSachMoi)
      deactivate VM
      View --> Admin : thongBaoLuuThanhCong()
    end
  else Xóa
    View --> Admin : yeuCauXacNhanXoa()
    Admin -> View : xacNhanXoa()
    View -> VM : xoaDanhMuc(id)
    activate VM
    VM -> Service : xoaDanhMuc(nhom, id)
    activate Service

    alt Không thể xóa
      Service --> VM : loiNghiepVu
      deactivate Service
      VM --> View : hienThiLoi(loiNghiepVu)
      deactivate VM
      View --> Admin : thongBaoKhongTheXoa()
    else Xóa thành công
      Service --> VM : ketQuaXoa
      deactivate Service
      VM -> Service : taiDanhSach(nhom, tuKhoa, trangThai)
      activate Service
      Service --> VM : danhSachMoi
      deactivate Service
      VM --> View : capNhatDanhSach(danhSachMoi)
      deactivate VM
      View --> Admin : thongBaoXoaThanhCong()
    end
  end
end

deactivate View
@enduml
