@startuml
' THESIS-R1 - HUIT/Rational Rose Sequence Diagram profile
' UC1 naming aligned to main implementation
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 16
skinparam dpi 180
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  LifeLineBackgroundColor white
  ParticipantBorderColor black
  ParticipantBackgroundColor white
  ActorBorderColor black
  ActorFontColor black
  ParticipantFontColor black
  GroupBorderColor black
  GroupBackgroundColor white
  GroupFontColor black
  MessageAlign center
}
hide footbox
autonumber

actor "Quản trị viên" as Admin
boundary "CatalogView" as View
control "CatalogViewModel" as VM
control "CatalogApiService" as Service

Admin -> View : moQuanLyDanhMuc()
activate View
View -> VM : InitializeAsync()
activate VM
VM -> VM : Load()
VM -> Service : ListAsync<T>(resource, search, status)
activate Service
Service --> VM : items
deactivate Service
VM --> View : Rows
deactivate VM
View --> Admin : hienThiDanhSach()

Admin -> View : chonNhomDanhMuc(tab)
View -> VM : SelectResourceAsync(tab)
activate VM
VM -> VM : Load()
VM -> Service : ListAsync<T>(resource, search, status)
activate Service
Service --> VM : items
deactivate Service
VM --> View : Rows
deactivate VM
View --> Admin : hienThiDanhSach()

Admin -> View : chonThaoTac(hanhDong)

alt CanEdit = false
  View --> Admin : thongBaoKhongDuQuyen()
else CanEdit = true
  alt Tạo mới hoặc cập nhật
    View -> VM : SaveCommand.Execute()
    activate VM
    VM -> VM : Save()
    VM -> Service : SaveAsync<T>(resource, id, body)
    activate Service
    Service --> VM : saved
    deactivate Service

    alt Lưu thành công
      VM -> VM : Apply(saved)
      VM -> VM : Load(saved.Id)
      VM -> Service : ListAsync<T>(resource, search, status)
      activate Service
      Service --> VM : items
      deactivate Service
      VM --> View : Rows, Feedback
    else Validation / HttpRequestException
      VM --> View : Feedback
    end
    deactivate VM
  else Xóa
    View -> VM : DeleteCommand.Execute()
    activate VM
    VM -> VM : Delete()
    VM -> Service : DeleteAsync(resource, id)
    activate Service
    Service --> VM : completed
    deactivate Service
    VM -> VM : Load()
    VM -> Service : ListAsync<T>(resource, search, status)
    activate Service
    Service --> VM : items
    deactivate Service
    VM --> View : Rows, Feedback
    deactivate VM
  end

  View --> Admin : hienThiKetQua()
end

deactivate View
@enduml
