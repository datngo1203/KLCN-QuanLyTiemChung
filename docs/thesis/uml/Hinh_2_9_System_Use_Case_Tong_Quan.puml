@startuml
' THESIS-R1 — Hình 2.9 System Use Case summary
' Semantic source: SCOPE.md System Use Case semantic lock v3 + presentation lock v1
' Summary shows primary/representative actor associations only; detail views carry full coverage.
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 15
skinparam ArrowColor black
skinparam ActorBorderColor black
skinparam UsecaseBorderColor black
skinparam RectangleBorderColor black
skinparam dpi 180

left to right direction

actor "Khách hàng" as Customer
actor "Lễ tân" as Reception

rectangle "HỆ THỐNG QUẢN LÝ TIÊM CHỦNG" as SystemBoundary {
  usecase "Quản lý hồ sơ khách hàng/\nngười được tiêm" as UC09
  usecase "Tra cứu dịch vụ\ntiêm chủng" as UC10
  usecase "Đăng ký dịch vụ\ntiêm chủng" as UC11
  usecase "Theo dõi hành trình\ntiêm chủng" as UC19

  usecase "Quản lý lịch hẹn" as UC12
  usecase "Gửi nhắc lịch" as UC13
  usecase "Ghi nhận khám sàng lọc\nvà chỉ định" as UC15
  usecase "Thanh toán dịch vụ" as UC16
  usecase "Ghi nhận mũi tiêm" as UC17
  usecase "Ghi nhận theo dõi\nsau tiêm" as UC18

  ' Two semantic-free layout columns.
  UC09 -[hidden]down- UC10
  UC10 -[hidden]down- UC11
  UC11 -[hidden]down- UC19

  UC12 -[hidden]down- UC13
  UC13 -[hidden]down- UC15
  UC15 -[hidden]down- UC16
  UC16 -[hidden]down- UC17
  UC17 -[hidden]down- UC18

  UC09 -[hidden]right- UC12
  UC10 -[hidden]right- UC13
  UC11 -[hidden]right- UC15
  UC19 -[hidden]right- UC16
}

actor "Bác sĩ" as Doctor
actor "Thu ngân" as Cashier
actor "Điều dưỡng" as Nurse

' Summary: primary/representative actor associations only.
Customer -right- UC09
Customer -right- UC10
Customer -right- UC11
Customer -right- UC19

Reception -right- UC12
Reception -right- UC13

UC15 -right- Doctor
UC16 -right- Cashier
UC17 -right- Nurse
UC18 -right- Nurse

@enduml
