@startuml
' THESIS-R1 — Hình 2.9 System Use Case summary
' Semantic source: SCOPE.md System Use Case semantic lock v3 + presentation lock v1
' Summary shows primary/representative actor associations only.
' "Khách hàng" is repeated as the same semantic actor to reduce connector crossing.
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 15
skinparam ArrowColor black
skinparam ActorBorderColor black
skinparam UsecaseBorderColor black
skinparam RectangleBorderColor black
skinparam nodesep 26
skinparam ranksep 28
skinparam dpi 180

top to bottom direction

actor "Khách hàng" as CustomerTop
actor "Bác sĩ" as Doctor
actor "Khách hàng" as CustomerBottom

rectangle "HỆ THỐNG QUẢN LÝ TIÊM CHỦNG" as SystemBoundary {
  usecase "Quản lý hồ sơ khách hàng/\nngười được tiêm" as UC09
  usecase "Tra cứu dịch vụ\ntiêm chủng" as UC10
  usecase "Đăng ký dịch vụ\ntiêm chủng" as UC11
  usecase "Quản lý lịch hẹn" as UC12
  usecase "Gửi nhắc lịch" as UC13
  usecase "Ghi nhận khám sàng lọc\nvà chỉ định" as UC15
  usecase "Thanh toán dịch vụ" as UC16
  usecase "Theo dõi hành trình\ntiêm chủng" as UC19
  usecase "Ghi nhận mũi tiêm" as UC17
  usecase "Ghi nhận theo dõi\nsau tiêm" as UC18

  UC09 -[hidden]down- UC10
  UC10 -[hidden]down- UC11
  UC11 -[hidden]down- UC12
  UC12 -[hidden]down- UC13
  UC13 -[hidden]down- UC15
  UC15 -[hidden]down- UC16
  UC16 -[hidden]down- UC19
  UC19 -[hidden]down- UC17
  UC17 -[hidden]down- UC18
}

actor "Lễ tân" as Reception
actor "Thu ngân" as Cashier
actor "Điều dưỡng" as Nurse

' Keep actor columns vertically ordered; hidden links have no semantic meaning.
CustomerTop -[hidden]down- Doctor
Doctor -[hidden]down- CustomerBottom
Reception -[hidden]down- Cashier
Cashier -[hidden]down- Nurse

' Summary: primary/representative actor associations only.
CustomerTop -right- UC09
CustomerTop -right- UC10
CustomerTop -right- UC11

Reception -left- UC12
Reception -left- UC13

Doctor -right- UC15
Cashier -left- UC16
CustomerBottom -right- UC19
Nurse -left- UC17
Nurse -left- UC18

@enduml
