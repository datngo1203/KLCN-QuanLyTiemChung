@startuml
' THESIS-R1 — Hình 2.9 System Use Case summary
' Visual contract: approved layout prototype v3.
' Semantics are locked in SCOPE.md; hidden links below are layout-only.
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 15
skinparam ArrowColor black
skinparam ActorBorderColor black
skinparam UsecaseBorderColor black
skinparam RectangleBorderColor black
skinparam linetype polyline
skinparam nodesep 34
skinparam ranksep 34
skinparam dpi 180

left to right direction

actor "Khách hàng" as Customer
actor "Lễ tân" as Reception

rectangle "HỆ THỐNG QUẢN LÝ TIÊM CHỦNG" as SystemBoundary {
  ' Customer-facing cluster — top to bottom
  usecase "Quản lý hồ sơ khách hàng/\nngười được tiêm" as UC09
  usecase "Tra cứu dịch vụ\ntiêm chủng" as UC10
  usecase "Đăng ký dịch vụ\ntiêm chủng" as UC11
  usecase "Theo dõi hành trình\ntiêm chủng" as UC19

  ' Reception cluster — lower than Customer cluster
  usecase "Quản lý lịch hẹn" as UC12
  usecase "Gửi nhắc lịch" as UC13

  ' Clinical cluster — top to bottom, reading order only
  usecase "Ghi nhận khám sàng lọc\nvà chỉ định" as UC15
  usecase "Thanh toán dịch vụ" as UC16
  usecase "Ghi nhận mũi tiêm" as UC17
  usecase "Ghi nhận theo dõi\nsau tiêm" as UC18

  ' Vertical stacks.
  UC09 -[hidden]down- UC10
  UC10 -[hidden]down- UC11
  UC11 -[hidden]down- UC19

  UC12 -[hidden]down- UC13

  UC15 -[hidden]down- UC16
  UC16 -[hidden]down- UC17
  UC17 -[hidden]down- UC18

  ' Horizontal grouping: customer/reception cluster left, clinical cluster right.
  UC09 -[hidden]right- UC15
  UC10 -[hidden]right- UC16
  UC11 -[hidden]right- UC17
  UC19 -[hidden]right- UC18

  ' Keep Reception cluster below Customer cluster without semantic relation.
  UC19 -[hidden]down- UC12
}

actor "Bác sĩ" as Doctor
actor "Thu ngân" as Cashier
actor "Điều dưỡng" as Nurse

' Actor column ordering only.
Customer -[hidden]down- Reception
Doctor -[hidden]down- Cashier
Cashier -[hidden]down- Nurse

' Actor placement anchors only.
Customer -[hidden]right- UC10
Reception -[hidden]right- UC12
UC15 -[hidden]right- Doctor
UC16 -[hidden]right- Cashier
UC17 -[hidden]right- Nurse

' Primary/representative actor associations only.
Customer -- UC09
Customer -- UC10
Customer -- UC11
Customer -- UC19

Reception -- UC12
Reception -- UC13

UC15 -- Doctor
UC16 -- Cashier
UC17 -- Nurse
UC18 -- Nurse

@enduml
