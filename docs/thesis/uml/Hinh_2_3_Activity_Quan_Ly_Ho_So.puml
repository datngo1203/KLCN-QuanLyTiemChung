@startuml
' HUIT UML Visual Profile v1 - compact data-aware layout
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 16
skinparam ArrowColor black
skinparam ActivityBorderColor black
skinparam ActivityBackgroundColor white
skinparam PartitionBorderColor black
skinparam PartitionBackgroundColor white
skinparam nodesep 20
skinparam ranksep 24
skinparam dpi 180

|Khách hàng|
start
:Cung cấp thông tin\nnhận dạng và liên hệ;

|Lễ tân|
:Xác định Khách hàng, Người được tiêm\nvà mối liên hệ;
:Tra cứu hồ sơ;

if (Có hồ sơ phù hợp?) then (Có)
  :Đối chiếu và cập nhật\nthông tin thay đổi;
else (Không)
  :Ghi nhận hồ sơ mới;
endif

if (Thông tin nhận dạng và\nmối liên hệ đã rõ?) then (Có)
else (Không)
  |Khách hàng|
  :Bổ sung hoặc làm rõ thông tin;
  |Lễ tân|
  :Xác định lại đúng chủ thể;
endif

:Xác nhận hồ sơ sẵn sàng\ncho đăng ký dịch vụ;
stop
@enduml
