@startuml
' HUIT UML Visual Profile v1 - compact data-aware layout
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 16
skinparam ArrowColor black
skinparam ActivityBorderColor black
skinparam ActivityBackgroundColor white
skinparam PartitionBorderColor black
skinparam PartitionBackgroundColor white
skinparam nodesep 20
skinparam ranksep 24
skinparam dpi 180

|Khách hàng|
start
:Nêu nhu cầu dịch vụ\ncho Người được tiêm;

|Lễ tân|
:Xác định hồ sơ\nNgười được tiêm;
if (Đăng ký cho nhiều\nNgười được tiêm?) then (Có)
  :Tách thành từng đăng ký riêng;
else (Không)
endif

|Khách hàng|
:Chọn dịch vụ, gói\nhoặc vắc xin;

|Lễ tân|
:Ghi nhận đăng ký và thời gian\nmong muốn (nếu có);
:Kiểm tra thông tin đăng ký;
if (Thông tin đã đầy đủ?) then (Có)
else (Không)
  |Khách hàng|
  :Bổ sung thông tin;
  |Lễ tân|
  :Cập nhật đăng ký;
endif

:Hoàn tất tiếp nhận;
stop
@enduml
