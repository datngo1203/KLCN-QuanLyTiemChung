@startuml
' HUIT UML Visual Profile v1 - compact data-aware layout
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 16
skinparam ArrowColor black
skinparam ActivityBorderColor black
skinparam ActivityBackgroundColor white
skinparam PartitionBorderColor black
skinparam PartitionBackgroundColor white
skinparam nodesep 20
skinparam ranksep 24
skinparam dpi 180

|Thu ngân|
start
:Tiếp nhận đăng ký và\nthông tin thanh toán;
:Đối chiếu số tiền,\nưu đãi hoặc quyền lợi;

if (Nghĩa vụ đã được\nđáp ứng trước đó?) then (Có)
  :Không tạo giao dịch trùng;
  stop
else (Không)
endif

|Khách hàng|
:Lựa chọn phương thức thanh toán;

|Thu ngân|
:Xử lý khoản thanh toán;
if (Giao dịch hoàn tất?) then (Có)
  :Ghi nhận giao dịch và\ncung cấp biên nhận;
  stop
else (Không)
  :Ghi nhận trạng thái\nchưa hoàn tất;
  stop
endif
@enduml
