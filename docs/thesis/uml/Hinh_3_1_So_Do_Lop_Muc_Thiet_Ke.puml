@startuml
' THESIS-R1 - Hình 3.1 Sơ đồ lớp mức thiết kế
' HUIT Chương 6/7 + current Domain/EF evidence
' PlantUML class syntax; design-level associations, not physical ERD

skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 11
skinparam classFontStyle bold
skinparam classAttributeFontStyle plain
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classBorderColor black
skinparam classFontColor black
skinparam arrowColor black
skinparam linetype polyline
skinparam nodesep 46
skinparam ranksep 54
hide circle
hide empty methods
top to bottom direction

class GoiVacXin <<entity>> {
  -MaGoi : int
  -TenGoi : string
}

class GoiVacXin_VacXin <<association>> {
  -MaGoi : int
  -MaVacXin : int
  -SoLuong : int
}

class VacXin <<entity>> {
  -MaVacXin : int
  -TenVacXin : string
}

class LoVacXin <<entity>> {
  -SoLo : string
  -HanSuDung : DateOnly
  -SoLuongTon : int
  -TrangThai : string
}

class KhuyenMai <<entity>> {
  -MaKhuyenMai : int
  -TenKhuyenMai : string
  -MucUuDai : decimal
}

class KhachHang <<entity>> {
  -MaKhachHang : int
  -HoTen : string
  -SoDienThoai : string
}

class DangKyDichVu <<entity>> {
  -MaDangKy : int
  -MaKhachHang : int
  -MaNguoiDuocTiem : int
  -TrangThai : string
}

class ChiTietGoiVacXin <<association>> {
  -MaChiTietGoi : int
  -MaGoi : int
  -SoLuongGoi : int
}

class NguoiDuocTiem <<entity>> {
  -MaNguoiDuocTiem : int
  -MaHoSo : string
  -NgaySinh : DateOnly
}

class ThanhToan <<entity>> {
  -MaThanhToan : int
  -SoTien : decimal
  -TrangThai : string
}

class ChiTietVacXinLe <<association>> {
  -MaChiTietVacXin : int
  -MaVacXin : int
  -SoLuong : int
}

class LichHenTiem <<entity>> {
  -MaLichHen : int
  -ThoiGianHen : DateTime
  -TrangThai : string
}

class NhacLich <<entity>> {
  -MaNhacLich : int
  -ScheduledAt : DateTime?
  -TrangThai : string
}

class NhanVien <<entity>> {
  -MaNhanVien : int
  -HoTen : string
  -ChucDanh : string
}

class PhieuKhamSangLoc <<entity>> {
  -MaPhieuKham : int
  -KetLuan : string
}

class ChiDinhTiem <<entity>> {
  -MaChiDinh : int
  -KetQuaChiDinh : string
}

class MuiTiem <<entity>> {
  -MaMuiTiem : int
  -ThoiDiemTiem : DateTime
}

class TheoDoiSauTiem <<entity>> {
  -MaTheoDoi : int
  -TinhTrang : string
  -MucDoPhanUng : string
}

' ---------------------------------------------------------------------------
' Layout strategy
' Portrait A4: minimal constraints.
' Keep only the catalog header and central clinical spine fixed; let Graphviz
' compact support classes around their real associations.
' ---------------------------------------------------------------------------

' Catalog header.
GoiVacXin -[hidden]right- GoiVacXin_VacXin
GoiVacXin_VacXin -[hidden]right- VacXin

' Main business / clinical spine.
DangKyDichVu -[hidden]down- LichHenTiem
LichHenTiem -[hidden]down- PhieuKhamSangLoc
PhieuKhamSangLoc -[hidden]down- ChiDinhTiem
ChiDinhTiem -[hidden]down- MuiTiem
MuiTiem -[hidden]down- TheoDoiSauTiem

' Keep common side companions close without forcing whole rows.
GoiVacXin -[hidden]down- ChiTietGoiVacXin
VacXin -[hidden]down- ChiTietVacXinLe
KhachHang -[hidden]down- NguoiDuocTiem
LichHenTiem -[hidden]right- NhacLich
NhanVien -[hidden]right- PhieuKhamSangLoc
MuiTiem -[hidden]right- LoVacXin

' ---------------------------------------------------------------------------
' Catalog / package / inventory
' ---------------------------------------------------------------------------

GoiVacXin "1" -right- "0..*" GoiVacXin_VacXin
GoiVacXin_VacXin "0..*" -right- "1" VacXin

GoiVacXin "1" -down- "0..*" ChiTietGoiVacXin
ChiTietGoiVacXin "0..*" -right- "1" DangKyDichVu

VacXin "1" -down- "0..*" ChiTietVacXinLe
DangKyDichVu "1" -right- "0..*" ChiTietVacXinLe

VacXin "1" -- "0..*" LoVacXin

' ---------------------------------------------------------------------------
' Profile / registration / payment
' ---------------------------------------------------------------------------

KhachHang "1" -down- "0..*" NguoiDuocTiem
NguoiDuocTiem "1" -right- "0..*" DangKyDichVu
KhachHang "1" -- "0..*" DangKyDichVu

DangKyDichVu "0..*" -right- "0..1" KhuyenMai

' ThanhToan.MaDangKy is required and unique.
DangKyDichVu "1" -right- "0..1" ThanhToan

' ---------------------------------------------------------------------------
' Appointment / reminder
' ---------------------------------------------------------------------------

' LichHenTiem.MaDangKy is nullable.
DangKyDichVu "0..1" -down- "0..*" LichHenTiem
NguoiDuocTiem "1" -- "0..*" LichHenTiem
LichHenTiem "1" -right- "0..*" NhacLich

' ---------------------------------------------------------------------------
' Screening / indication
' ---------------------------------------------------------------------------

' PhieuKhamSangLoc.MaLichHen is nullable and unique when present.
LichHenTiem "0..1" -down- "0..1" PhieuKhamSangLoc

' Required semantic ownership of a screening record.
DangKyDichVu "1" -- "0..*" PhieuKhamSangLoc
NguoiDuocTiem "1" -- "0..*" PhieuKhamSangLoc
NhanVien "1" -right- "0..*" PhieuKhamSangLoc

PhieuKhamSangLoc "1" -down- "0..*" ChiDinhTiem
VacXin "1" -- "0..*" ChiDinhTiem

' ---------------------------------------------------------------------------
' Vaccination / aftercare
' ---------------------------------------------------------------------------

' MuiTiem.MaChiDinh is nullable and unique when present.
ChiDinhTiem "0..1" -down- "0..1" MuiTiem

NguoiDuocTiem "1" -- "0..*" MuiTiem
MuiTiem "0..*" -right- "1" LoVacXin
NhanVien "1" -- "0..*" MuiTiem

' TheoDoiSauTiem.MaMuiTiem is required and unique.
MuiTiem "1" -down- "0..1" TheoDoiSauTiem

' TheoDoiSauTiem.MaNhanVien is nullable.
NhanVien "0..1" -- "0..*" TheoDoiSauTiem

@enduml
