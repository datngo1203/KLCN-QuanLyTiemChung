@startuml
' THESIS-R1 - Hình 3.1 Sơ đồ lớp mức thiết kế
' HUIT Chương 6/7 + current Domain/EF evidence
' PlantUML class syntax; design-level associations, not physical ERD

skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 11
skinparam classFontStyle bold
skinparam classAttributeFontStyle plain
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classBorderColor black
skinparam classFontColor black
skinparam arrowColor black
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 52
hide circle
hide empty methods
top to bottom direction

class GoiVacXin <<entity>> {
  -MaGoi : int
  -TenGoi : string
}

class GoiVacXin_VacXin <<association>> {
  -MaGoi : int
  -MaVacXin : int
  -SoLuong : int
}

class VacXin <<entity>> {
  -MaVacXin : int
  -TenVacXin : string
}

class LoVacXin <<entity>> {
  -SoLo : string
  -HanSuDung : DateOnly
  -SoLuongTon : int
  -TrangThai : string
}

class KhuyenMai <<entity>> {
  -MaKhuyenMai : int
  -TenKhuyenMai : string
  -MucUuDai : decimal
}

class KhachHang <<entity>> {
  -MaKhachHang : int
  -HoTen : string
  -SoDienThoai : string
}

class DangKyDichVu <<entity>> {
  -MaDangKy : int
  -MaKhachHang : int
  -MaNguoiDuocTiem : int
  -TrangThai : string
}

class ChiTietGoiVacXin <<association>> {
  -MaChiTietGoi : int
  -MaGoi : int
  -SoLuongGoi : int
}

class NguoiDuocTiem <<entity>> {
  -MaNguoiDuocTiem : int
  -MaHoSo : string
  -NgaySinh : DateOnly
}

class ThanhToan <<entity>> {
  -MaThanhToan : int
  -SoTien : decimal
  -TrangThai : string
}

class ChiTietVacXinLe <<association>> {
  -MaChiTietVacXin : int
  -MaVacXin : int
  -SoLuong : int
}

class LichHenTiem <<entity>> {
  -MaLichHen : int
  -ThoiGianHen : DateTime
  -TrangThai : string
}

class NhacLich <<entity>> {
  -MaNhacLich : int
  -ScheduledAt : DateTime?
  -TrangThai : string
}

class NhanVien <<entity>> {
  -MaNhanVien : int
  -HoTen : string
  -ChucDanh : string
}

class PhieuKhamSangLoc <<entity>> {
  -MaPhieuKham : int
  -KetLuan : string
}

class ChiDinhTiem <<entity>> {
  -MaChiDinh : int
  -KetQuaChiDinh : string
}

class MuiTiem <<entity>> {
  -MaMuiTiem : int
  -ThoiDiemTiem : DateTime
}

class TheoDoiSauTiem <<entity>> {
  -MaTheoDoi : int
  -TinhTrang : string
  -MucDoPhanUng : string
}

' ---------------------------------------------------------------------------
' Layout hints only — preserve the portrait arrangement approved by the user.
' ---------------------------------------------------------------------------

GoiVacXin -[hidden]right- GoiVacXin_VacXin
GoiVacXin_VacXin -[hidden]right- VacXin
VacXin -[hidden]right- LoVacXin

ChiTietGoiVacXin -[hidden]right- KhachHang
KhachHang -[hidden]right- KhuyenMai
KhuyenMai -[hidden]right- DangKyDichVu
DangKyDichVu -[hidden]right- NguoiDuocTiem
NguoiDuocTiem -[hidden]right- ThanhToan
ThanhToan -[hidden]right- ChiTietVacXinLe

GoiVacXin -[hidden]down- ChiTietGoiVacXin
VacXin -[hidden]down- ChiTietVacXinLe
LoVacXin -[hidden]down- ChiTietVacXinLe
KhachHang -[hidden]down- NguoiDuocTiem
DangKyDichVu -[hidden]down- LichHenTiem

LichHenTiem -[hidden]right- NhacLich
LichHenTiem -[hidden]down- PhieuKhamSangLoc
NhanVien -[hidden]right- PhieuKhamSangLoc
PhieuKhamSangLoc -[hidden]down- ChiDinhTiem
ChiDinhTiem -[hidden]left- MuiTiem
MuiTiem -[hidden]down- TheoDoiSauTiem

' ---------------------------------------------------------------------------
' Catalog / package / inventory
' ---------------------------------------------------------------------------

GoiVacXin "1" -- "0..*" GoiVacXin_VacXin
VacXin "1" -- "0..*" GoiVacXin_VacXin
VacXin "1" -- "0..*" LoVacXin

' Registration detail classes are refined association classes.
DangKyDichVu "1" -- "0..*" ChiTietGoiVacXin
GoiVacXin "1" -- "0..*" ChiTietGoiVacXin

DangKyDichVu "1" -- "0..*" ChiTietVacXinLe
VacXin "1" -- "0..*" ChiTietVacXinLe

' ---------------------------------------------------------------------------
' Profile / registration / payment
' ---------------------------------------------------------------------------

KhachHang "1" -- "0..*" NguoiDuocTiem
KhachHang "1" -- "0..*" DangKyDichVu
NguoiDuocTiem "1" -- "0..*" DangKyDichVu
KhuyenMai "0..1" -- "0..*" DangKyDichVu

' MaDangKy in ThanhToan is required and unique.
DangKyDichVu "1" -- "0..1" ThanhToan

' ---------------------------------------------------------------------------
' Appointment / reminder
' ---------------------------------------------------------------------------

' MaDangKy in LichHenTiem is nullable: an appointment may have no registration.
DangKyDichVu "0..1" -- "0..*" LichHenTiem
NguoiDuocTiem "1" -- "0..*" LichHenTiem
LichHenTiem "1" -- "0..*" NhacLich

' ---------------------------------------------------------------------------
' Screening / indication
' ---------------------------------------------------------------------------

' MaLichHen is nullable but unique when present.
LichHenTiem "0..1" -- "0..1" PhieuKhamSangLoc

' Screening always belongs to a registration and recipient.
DangKyDichVu "1" -- "0..*" PhieuKhamSangLoc
NguoiDuocTiem "1" -- "0..*" PhieuKhamSangLoc
NhanVien "1" -- "0..*" PhieuKhamSangLoc

PhieuKhamSangLoc "1" -- "0..*" ChiDinhTiem
VacXin "1" -- "0..*" ChiDinhTiem

' ---------------------------------------------------------------------------
' Vaccination / aftercare
' ---------------------------------------------------------------------------

' MaChiDinh is nullable and unique when present.
ChiDinhTiem "0..1" -- "0..1" MuiTiem

NguoiDuocTiem "1" -- "0..*" MuiTiem
LoVacXin "1" -- "0..*" MuiTiem
NhanVien "1" -- "0..*" MuiTiem

' MaMuiTiem in TheoDoiSauTiem is required and unique.
MuiTiem "1" -- "0..1" TheoDoiSauTiem

' MaNhanVien in TheoDoiSauTiem is nullable.
NhanVien "0..1" -- "0..*" TheoDoiSauTiem

@enduml
