@startdot
digraph G {
  graph [rankdir=TB, splines=ortho, overlap=false, concentrate=false, nodesep=0.42, ranksep=0.75, pad=0.16, bgcolor="white"];
  node [shape=record, fontname="Times New Roman", fontsize=11.5, color="black", penwidth=1.0, margin="0.07,0.05"];
  edge [fontname="Times New Roman", fontsize=8.2, color="black", penwidth=0.9, dir=none, labeldistance=1.2];

  vx [label="{«entity»\nVacXin|+MaVacXin : int\l+TenVacXin : string\l}"];
  gv [label="{«entity»\nGoiVacXin|+MaGoi : int\l+TenGoi : string\l}"];
  lo [label="{«entity»\nLoVacXin|+SoLo : string\l+HanSuDung : DateOnly\l+SoLuongTon : int\l}"];
  ctv [label="{«entity»\nChiTietVacXinLe|+MaChiTietVacXin : int\l+SoLuong : int\l}"];
  ctg [label="{«entity»\nChiTietGoiVacXin|+MaChiTietGoi : int\l+SoLuongGoi : int\l}"];

  kh [label="{«entity»\nKhachHang|+MaKhachHang : int\l+HoTen : string\l}"];
  ndt [label="{«entity»\nNguoiDuocTiem|+MaNguoiDuocTiem : int\l+MaHoSo : string\l}"];
  km [label="{«entity»\nKhuyenMai|+MaKhuyenMai : int\l+MucUuDai : decimal\l}"];
  dk [label="{«entity»\nDangKyDichVu|+MaDangKy : int\l+TrangThai : string\l}"];
  tt [label="{«entity»\nThanhToan|+MaThanhToan : int\l+SoTien : decimal\l}"];
  nv [label="{«entity»\nNhanVien|+MaNhanVien : int\l+ChucDanh : string\l}"];
  lh [label="{«entity»\nLichHenTiem|+MaLichHen : int\l+ThoiGianHen : DateTime\l}"];
  nl [label="{«entity»\nNhacLich|+MaNhacLich : int\l+ScheduledAt : DateTime?\l}"];
  pk [label="{«entity»\nPhieuKhamSangLoc|+MaPhieuKham : int\l+KetLuan : string\l}"];
  cd [label="{«entity»\nChiDinhTiem|+MaChiDinh : int\l+KetQuaChiDinh : string\l}"];
  mt [label="{«entity»\nMuiTiem|+MaMuiTiem : int\l+ThoiDiemTiem : DateTime\l}"];
  td [label="{«entity»\nTheoDoiSauTiem|+MaTheoDoi : int\l+TinhTrang : string\l}"];

  // Compact portrait rows: catalog/inventory above, business flow below.
  {rank=same; vx; gv; lo;}
  {rank=same; ctv; ctg;}
  {rank=same; kh; ndt; km;}
  {rank=same; dk; tt; nv;}
  {rank=same; lh; nl;}
  {rank=same; pk;}
  {rank=same; cd; mt; td;}

  // Order helpers.
  vx -> gv -> lo [style=invis, weight=90];
  ctv -> ctg [style=invis, weight=70];
  kh -> ndt -> km [style=invis, weight=90];
  dk -> tt -> nv [style=invis, weight=90];
  lh -> nl [style=invis, weight=70];
  cd -> mt -> td [style=invis, weight=90];

  // Keep the catalog/service block above the business block.
  ctv -> kh [style=invis, weight=80];
  ctg -> ndt [style=invis, weight=80];
  lo -> km [style=invis, weight=80];

  // Catalog/service core.
  vx:s -> ctv:n [taillabel="1", headlabel="0..*", weight=10];
  gv:s -> ctg:n [taillabel="1", headlabel="0..*", weight=10];
  vx:e -> lo:w [taillabel="1", headlabel="0..*", weight=8];

  // Profile/registration core.
  kh:e -> ndt:w [taillabel="1", headlabel="0..*", weight=10];
  kh:s -> dk:nw [taillabel="1", headlabel="0..*", constraint=false];
  ndt:s -> dk:n [taillabel="1", headlabel="0..*", weight=10];
  km:s -> dk:ne [taillabel="0..1", headlabel="0..*", constraint=false];
  dk:nw -> ctv:s [taillabel="1", headlabel="0..*", constraint=false];
  dk:n -> ctg:s [taillabel="1", headlabel="0..*", constraint=false];
  dk:e -> tt:w [taillabel="1", headlabel="0..1", weight=8];

  // Appointment core.
  dk:s -> lh:n [taillabel="0..1", headlabel="0..*", weight=10];
  ndt:s -> lh:n [taillabel="1", headlabel="0..*", constraint=false];
  lh:e -> nl:w [taillabel="1", headlabel="0..*", weight=8];
  lh:s -> pk:n [taillabel="0..1", headlabel="0..1", weight=10];

  // Clinical core.
  nv:s -> pk:e [taillabel="1", headlabel="0..*", constraint=false];
  pk:s -> cd:n [taillabel="1", headlabel="0..*", weight=10];
  vx:s -> cd:w [taillabel="1", headlabel="0..*", constraint=false];
  cd:e -> mt:w [taillabel="0..1", headlabel="0..1", weight=10];
  ndt:s -> mt:n [taillabel="1", headlabel="0..*", constraint=false];
  lo:s -> mt:w [taillabel="1", headlabel="0..*", constraint=false];
  nv:s -> mt:e [taillabel="1", headlabel="0..*", constraint=false];
  mt:e -> td:w [taillabel="1", headlabel="0..1", weight=10];
  nv:e -> td:e [taillabel="0..1", headlabel="0..*", constraint=false];
}
@enddot
