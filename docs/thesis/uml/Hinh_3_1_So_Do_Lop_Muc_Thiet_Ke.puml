@startdot
digraph G {
  graph [
    rankdir=LR,
    splines=ortho,
    overlap=false,
    concentrate=false,
    pack=true,
    packmode="cluster",
    nodesep=0.38,
    ranksep=0.65,
    pad=0.18,
    bgcolor="white",
    fontname="Times New Roman"
  ];

  node [
    shape=plain,
    fontname="Times New Roman"
  ];

  edge [
    fontname="Times New Roman",
    fontsize=9,
    color="black",
    penwidth=0.9,
    dir=none
  ];

  // ---------- ZONE 1: HỒ SƠ & ĐĂNG KÝ ----------
  subgraph cluster_profile {
    label="Hồ sơ và đăng ký";
    color="#777777";
    penwidth=0.8;
    style="rounded";

    kh [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD>«entity»<BR/><B>KhachHang</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+MaKhachHang : int<BR ALIGN="LEFT"/>+HoTen : string</TD></TR>
    </TABLE>>];

    ndt [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD>«entity»<BR/><B>NguoiDuocTiem</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+MaNguoiDuocTiem : int<BR ALIGN="LEFT"/>+MaHoSo : string</TD></TR>
    </TABLE>>];

    dk [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD>«entity»<BR/><B>DangKyDichVu</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+MaDangKy : int<BR ALIGN="LEFT"/>+TrangThai : string</TD></TR>
    </TABLE>>];

    km [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD>«entity»<BR/><B>KhuyenMai</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+MaKhuyenMai : int<BR ALIGN="LEFT"/>+MucUuDai : decimal</TD></TR>
    </TABLE>>];

    tt [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD>«entity»<BR/><B>ThanhToan</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+MaThanhToan : int<BR ALIGN="LEFT"/>+SoTien : decimal</TD></TR>
    </TABLE>>];

    ctv [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD>«entity»<BR/><B>ChiTietVacXinLe</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+MaChiTietVacXin : int<BR ALIGN="LEFT"/>+SoLuong : int</TD></TR>
    </TABLE>>];

    ctg [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD>«entity»<BR/><B>ChiTietGoiVacXin</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+MaChiTietGoi : int<BR ALIGN="LEFT"/>+SoLuongGoi : int</TD></TR>
    </TABLE>>];

    kh -> ndt [taillabel="1", headlabel="0..*", weight=8];
    ndt -> dk [taillabel="1", headlabel="0..*", weight=8];
    km -> dk [constraint=false];
    tt -> dk [constraint=false];
    ctv -> dk [constraint=false];
    ctg -> dk [constraint=false];
  }

  // ---------- ZONE 2: QUY TRÌNH TIÊM ----------
  subgraph cluster_clinical {
    label="Quy trình tiêm chủng";
    color="#777777";
    penwidth=0.8;
    style="rounded";

    lh [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD>«entity»<BR/><B>LichHenTiem</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+MaLichHen : int<BR ALIGN="LEFT"/>+ThoiGianHen : DateTime<BR ALIGN="LEFT"/>+TrangThai : string</TD></TR>
    </TABLE>>];

    nl [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD>«entity»<BR/><B>NhacLich</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+MaNhacLich : int<BR ALIGN="LEFT"/>+ScheduledAt : DateTime?</TD></TR>
    </TABLE>>];

    pk [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD>«entity»<BR/><B>PhieuKhamSangLoc</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+MaPhieuKham : int<BR ALIGN="LEFT"/>+KetLuan : string</TD></TR>
    </TABLE>>];

    nv [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD>«entity»<BR/><B>NhanVien</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+MaNhanVien : int<BR ALIGN="LEFT"/>+ChucDanh : string</TD></TR>
    </TABLE>>];

    cd [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD>«entity»<BR/><B>ChiDinhTiem</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+MaChiDinh : int<BR ALIGN="LEFT"/>+KetQuaChiDinh : string</TD></TR>
    </TABLE>>];

    mt [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD>«entity»<BR/><B>MuiTiem</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+MaMuiTiem : int<BR ALIGN="LEFT"/>+ThoiDiemTiem : DateTime</TD></TR>
    </TABLE>>];

    td [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD>«entity»<BR/><B>TheoDoiSauTiem</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+MaTheoDoi : int<BR ALIGN="LEFT"/>+TinhTrang : string</TD></TR>
    </TABLE>>];

    lh -> pk [taillabel="0..1", headlabel="0..1", weight=8];
    pk -> cd [taillabel="1", headlabel="0..*", weight=8];
    cd -> mt [taillabel="0..1", headlabel="0..1", weight=8];
    mt -> td [taillabel="1", headlabel="0..1", weight=8];

    nl -> lh [constraint=false];
    nv -> pk [constraint=false];
  }

  // ---------- ZONE 3: DANH MỤC & KHO ----------
  subgraph cluster_catalog {
    label="Danh mục và kho";
    color="#777777";
    penwidth=0.8;
    style="rounded";

    vx [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD>«entity»<BR/><B>VacXin</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+MaVacXin : int<BR ALIGN="LEFT"/>+TenVacXin : string</TD></TR>
    </TABLE>>];

    gv [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD>«entity»<BR/><B>GoiVacXin</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+MaGoi : int<BR ALIGN="LEFT"/>+TenGoi : string</TD></TR>
    </TABLE>>];

    lo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD>«entity»<BR/><B>LoVacXin</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+SoLo : string<BR ALIGN="LEFT"/>+HanSuDung : DateOnly<BR ALIGN="LEFT"/>+SoLuongTon : int</TD></TR>
    </TABLE>>];

    vx -> lo [taillabel="1", headlabel="0..*", weight=8];
  }

  // ---------- CROSS-ZONE CORE LINKS ----------
  dk -> lh [taillabel="1", headlabel="0..*", weight=12];
  vx -> cd [constraint=false];
  lo -> mt [constraint=false];
  vx -> ctv [constraint=false];
  gv -> ctg [constraint=false];

  // Gentle alignment hints only; not fixed coordinates.
  dk -> pk [style=invis, weight=2];
  cd -> vx [style=invis, weight=2];
}
@enddot
