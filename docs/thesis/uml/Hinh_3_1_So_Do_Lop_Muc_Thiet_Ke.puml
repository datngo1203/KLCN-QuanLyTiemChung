@startuml
' THESIS-R1 - Hình 3.1 Sơ đồ lớp mức thiết kế - single landscape
' HUIT Chương 7 + current Domain/EF evidence
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 28
skinparam ranksep 45
skinparam dpi 180
left to right direction
hide empty methods
hide circle

class KhachHang <<entity>> {
  +MaKhachHang : int
  +HoTen : string
  +SoDienThoai : string
}
class NguoiDuocTiem <<entity>> {
  +MaNguoiDuocTiem : int
  +MaHoSo : string
  +NgaySinh : DateOnly
}
class NhanVien <<entity>> {
  +MaNhanVien : int
  +HoTen : string
  +ChucDanh : string
}
class KhuyenMai <<entity>> {
  +MaKhuyenMai : int
  +TenKhuyenMai : string
  +MucUuDai : decimal
}

class DangKyDichVu <<entity>> {
  +MaDangKy : int
  +MaKhachHang : int
  +MaNguoiDuocTiem : int
  +TrangThai : string
}
class ChiTietVacXinLe <<entity>> {
  +MaChiTietVacXin : int
  +MaVacXin : int
  +SoLuong : int
}
class ChiTietGoiVacXin <<entity>> {
  +MaChiTietGoi : int
  +MaGoi : int
  +SoLuongGoi : int
}
class ThanhToan <<entity>> {
  +MaThanhToan : int
  +SoTien : decimal
  +TrangThai : string
}
class LichHenTiem <<entity>> {
  +MaLichHen : int
  +ThoiGianHen : DateTime
  +TrangThai : string
}
class NhacLich <<entity>> {
  +MaNhacLich : int
  +ScheduledAt : DateTime?
  +TrangThai : string
}

class PhieuKhamSangLoc <<entity>> {
  +MaPhieuKham : int
  +KetLuan : string
}
class ChiDinhTiem <<entity>> {
  +MaChiDinh : int
  +KetQuaChiDinh : string
}
class MuiTiem <<entity>> {
  +MaMuiTiem : int
  +SoLo : string
  +ThoiDiemTiem : DateTime
}
class TheoDoiSauTiem <<entity>> {
  +MaTheoDoi : int
  +TinhTrang : string
  +MucDoPhanUng : string
}

class VacXin <<entity>> {
  +MaVacXin : int
  +Code : string
  +TenVacXin : string
  +Gia : decimal
}
class GoiVacXin <<entity>> {
  +MaGoi : int
  +Code : string
  +TenGoi : string
  +GiaGoi : decimal
}
class Benh <<entity>> {
  +MaBenh : int
  +TenBenh : string
}
class CongNgheVacXin <<entity>> {
  +MaCongNghe : int
  +TenCongNghe : string
}
class VaccineRegimen <<entity>> {
  +Id : int
  +Name : string
}
class VaccineRegimenDose <<entity>> {
  +Id : int
  +DoseOrder : int
  +TimingLabel : string
}
class LoVacXin <<entity>> {
  +SoLo : string
  +HanSuDung : DateOnly
  +SoLuongTon : int
}
class InventoryReceipt <<entity>> {
  +SoLo : string
  +SupplierName : string
  +DocumentNumber : string
}
class BienDongKho <<entity>> {
  +MaBienDong : int
  +LoaiBienDong : string
  +SoLuong : int
}

' Core business relations
KhachHang "1" -- "0..*" NguoiDuocTiem
KhachHang "1" -- "0..*" DangKyDichVu
NguoiDuocTiem "1" -- "0..*" DangKyDichVu
KhuyenMai "0..1" -- "0..*" DangKyDichVu

DangKyDichVu "1" -- "0..*" ChiTietVacXinLe
DangKyDichVu "1" -- "0..*" ChiTietGoiVacXin
DangKyDichVu "1" -- "0..1" ThanhToan
DangKyDichVu "1" -- "0..*" LichHenTiem
LichHenTiem "1" -- "0..*" NhacLich
NguoiDuocTiem "1" -- "0..*" LichHenTiem

LichHenTiem "0..1" -- "0..1" PhieuKhamSangLoc
NhanVien "1" -- "0..*" PhieuKhamSangLoc
PhieuKhamSangLoc "1" -- "0..*" ChiDinhTiem
ChiDinhTiem "0..1" -- "0..1" MuiTiem
NguoiDuocTiem "1" -- "0..*" MuiTiem
MuiTiem "1" -- "0..1" TheoDoiSauTiem

VacXin "1" -- "0..*" ChiTietVacXinLe
GoiVacXin "1" -- "0..*" ChiTietGoiVacXin
VacXin "1" -- "0..*" ChiDinhTiem
GoiVacXin "0..*" -- "0..*" VacXin : thành phần
VacXin "0..*" -- "0..*" Benh : phòng bệnh
VacXin "0..*" -- "0..*" CongNgheVacXin : công nghệ
VacXin "1" -- "0..*" VaccineRegimen
VaccineRegimen "1" -- "1..*" VaccineRegimenDose

VacXin "1" -- "0..*" LoVacXin
LoVacXin "1" -- "0..*" MuiTiem : sử dụng
LoVacXin "1" -- "0..1" InventoryReceipt : tiếp nhận
LoVacXin "1" -- "0..*" BienDongKho

' Layout rows for A4 landscape
KhachHang -[hidden]right-> DangKyDichVu
DangKyDichVu -[hidden]right-> LichHenTiem
LichHenTiem -[hidden]right-> PhieuKhamSangLoc
PhieuKhamSangLoc -[hidden]right-> ChiDinhTiem
ChiDinhTiem -[hidden]right-> MuiTiem
MuiTiem -[hidden]right-> TheoDoiSauTiem

NguoiDuocTiem -[hidden]right-> ChiTietVacXinLe
ChiTietVacXinLe -[hidden]right-> ThanhToan
ThanhToan -[hidden]right-> VacXin
VacXin -[hidden]right-> LoVacXin
LoVacXin -[hidden]right-> InventoryReceipt

NhanVien -[hidden]right-> KhuyenMai
KhuyenMai -[hidden]right-> ChiTietGoiVacXin
ChiTietGoiVacXin -[hidden]right-> GoiVacXin
GoiVacXin -[hidden]right-> VaccineRegimen
VaccineRegimen -[hidden]right-> VaccineRegimenDose
VaccineRegimenDose -[hidden]right-> BienDongKho

Benh -[hidden]right-> CongNgheVacXin
CongNgheVacXin -[hidden]right-> NhacLich
@enduml
