@startdot
digraph G {
  graph [
    rankdir=TB,
    splines=polyline,
    overlap=false,
    concentrate=false,
    nodesep=0.34,
    ranksep=0.72,
    pad=0.18,
    bgcolor="white",
    fontname="Times New Roman"
  ];
  node [
    shape=record,
    fontname="Times New Roman",
    fontsize=12,
    color="black",
    penwidth=1.0,
    margin="0.09,0.06"
  ];
  edge [
    fontname="Times New Roman",
    fontsize=9,
    color="black",
    penwidth=0.95,
    dir=none,
    labelfloat=true,
    labeldistance=1.4
  ];

  kh [label="{«entity»\nKhachHang|+MaKhachHang : int\l+HoTen : string\l+SoDienThoai : string\l}"];
  ndt [label="{«entity»\nNguoiDuocTiem|+MaNguoiDuocTiem : int\l+MaHoSo : string\l+NgaySinh : DateOnly\l}"];
  dk [label="{«entity»\nDangKyDichVu|+MaDangKy : int\l+MaKhachHang : int\l+MaNguoiDuocTiem : int\l+TrangThai : string\l}"];
  lh [label="{«entity»\nLichHenTiem|+MaLichHen : int\l+ThoiGianHen : DateTime\l+TrangThai : string\l}"];
  pk [label="{«entity»\nPhieuKhamSangLoc|+MaPhieuKham : int\l+KetLuan : string\l}"];
  cd [label="{«entity»\nChiDinhTiem|+MaChiDinh : int\l+KetQuaChiDinh : string\l}"];
  mt [label="{«entity»\nMuiTiem|+MaMuiTiem : int\l+SoLo : string\l+ThoiDiemTiem : DateTime\l}"];
  td [label="{«entity»\nTheoDoiSauTiem|+MaTheoDoi : int\l+TinhTrang : string\l+MucDoPhanUng : string\l}"];

  nv [label="{«entity»\nNhanVien|+MaNhanVien : int\l+HoTen : string\l+ChucDanh : string\l}"];
  km [label="{«entity»\nKhuyenMai|+MaKhuyenMai : int\l+TenKhuyenMai : string\l+MucUuDai : decimal\l}"];
  tt [label="{«entity»\nThanhToan|+MaThanhToan : int\l+SoTien : decimal\l+TrangThai : string\l}"];
  nl [label="{«entity»\nNhacLich|+MaNhacLich : int\l+ScheduledAt : DateTime?\l+TrangThai : string\l}"];

  ctv [label="{«entity»\nChiTietVacXinLe|+MaChiTietVacXin : int\l+MaVacXin : int\l+SoLuong : int\l}"];
  ctg [label="{«entity»\nChiTietGoiVacXin|+MaChiTietGoi : int\l+MaGoi : int\l+SoLuongGoi : int\l}"];
  vx [label="{«entity»\nVacXin|+MaVacXin : int\l+Code : string\l+TenVacXin : string\l+Gia : decimal\l}"];
  gv [label="{«entity»\nGoiVacXin|+MaGoi : int\l+Code : string\l+TenGoi : string\l+GiaGoi : decimal\l}"];
  benh [label="{«entity»\nBenh|+MaBenh : int\l+TenBenh : string\l}"];
  cn [label="{«entity»\nCongNgheVacXin|+MaCongNghe : int\l+TenCongNghe : string\l}"];
  reg [label="{«entity»\nVaccineRegimen|+Id : int\l+Name : string\l}"];
  dose [label="{«entity»\nVaccineRegimenDose|+Id : int\l+DoseOrder : int\l+TimingLabel : string\l}"];

  rec [label="{«entity»\nInventoryReceipt|+SoLo : string\l+SupplierName : string\l+DocumentNumber : string\l}"];
  lo [label="{«entity»\nLoVacXin|+SoLo : string\l+HanSuDung : DateOnly\l+SoLuongTon : int\l}"];
  bd [label="{«entity»\nBienDongKho|+MaBienDong : int\l+LoaiBienDong : string\l+SoLuong : int\l}"];

  // ----- Fixed landscape lanes -----
  { rank=same; kh; ndt; dk; lh; pk; cd; mt; td; }
  { rank=same; nv; km; tt; nl; }
  { rank=same; ctv; vx; gv; ctg; reg; dose; }
  { rank=same; benh; cn; rec; lo; bd; }

  // Horizontal ordering only.
  kh -> ndt -> dk -> lh -> pk -> cd -> mt -> td [style=invis, weight=120];
  nv -> km -> tt -> nl [style=invis, weight=100];
  ctv -> vx -> gv -> ctg -> reg -> dose [style=invis, weight=100];
  benh -> cn -> rec -> lo -> bd [style=invis, weight=100];

  // Vertical lane anchors.
  kh -> nv [style=invis, weight=40];
  dk -> tt [style=invis, weight=40];
  lh -> nl [style=invis, weight=40];
  cd -> vx [style=invis, weight=40];
  vx -> lo [style=invis, weight=40];
  gv -> ctg [style=invis, weight=40];

  // ----- Core design associations only -----
  kh:e -> ndt:w [taillabel="1", headlabel="0..*"];
  ndt:e -> dk:w [taillabel="1", headlabel="0..*"];
  dk:e -> lh:w [taillabel="1", headlabel="0..*"];
  lh:e -> pk:w [taillabel="0..1", headlabel="0..1"];
  pk:e -> cd:w [taillabel="1", headlabel="0..*"];
  cd:e -> mt:w [taillabel="0..1", headlabel="0..1"];
  mt:e -> td:w [taillabel="1", headlabel="0..1"];

  km:n -> dk:s [taillabel="0..1", headlabel="0..*"];
  tt:n -> dk:s [taillabel="0..1", headlabel="1"];
  nl:n -> lh:s [taillabel="0..*", headlabel="1"];
  nv:n -> pk:s [taillabel="1", headlabel="0..*"];

  ctv:n -> dk:s [taillabel="0..*", headlabel="1"];
  ctg:n -> dk:s [taillabel="0..*", headlabel="1"];
  vx:n -> ctv:s [taillabel="1", headlabel="0..*"];
  gv:n -> ctg:s [taillabel="1", headlabel="0..*"];
  vx:n -> cd:s [taillabel="1", headlabel="0..*"];

  vx:e -> gv:w [taillabel="0..*", headlabel="0..*", label="thành phần"];
  vx:s -> benh:n [label="phòng bệnh"];
  vx:s -> cn:n [label="công nghệ"];
  vx:e -> reg:w [taillabel="1", headlabel="0..*"];
  reg:e -> dose:w [taillabel="1", headlabel="1..*"];

  rec:e -> lo:w [taillabel="0..1", headlabel="1", label="tiếp nhận"];
  vx:s -> lo:n [taillabel="1", headlabel="0..*"];
  lo:e -> bd:w [taillabel="1", headlabel="0..*"];
  lo:n -> mt:s [taillabel="1", headlabel="0..*", label="sử dụng"];
}
@enddot
