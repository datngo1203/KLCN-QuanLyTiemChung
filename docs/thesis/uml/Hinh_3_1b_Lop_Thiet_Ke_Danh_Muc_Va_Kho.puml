@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 15
skinparam dpi 180
skinparam classAttributeIconSize 0
skinparam linetype ortho
top to bottom direction
hide empty methods
hide circle

class VacXin <<entity>> {
  +MaVacXin : int
  +Code : string
  +TenVacXin : string
  +NhaSanXuat : string
  +XuatXu : string
  +LieuLuong : string
  +TheTich : decimal
  +Gia : decimal
  +TrangThai : string
}
class Benh <<entity>> {
  +MaBenh : int
  +Code : string
  +TenBenh : string
  +TrangThai : string
}
class VacXin_Benh <<association>> {
  +MaVacXin : int
  +MaBenh : int
}
class CongNgheVacXin <<entity>> {
  +MaCongNghe : int
  +Code : string
  +TenCongNghe : string
  +TrangThai : string
}
class VacXin_CongNghe <<association>> {
  +MaVacXin : int
  +MaCongNghe : int
}
class GoiVacXin <<entity>> {
  +MaGoi : int
  +Code : string
  +TenGoi : string
  +GiaGoi : decimal
  +TrangThai : string
}
class GoiVacXin_VacXin <<association>> {
  +MaGoi : int
  +MaVacXin : int
  +SoLuong : int
}
class VaccineRegimen <<entity>> {
  +Id : int
  +VaccineId : int
  +Name : string
  +TargetAudience : string
}
class VaccineRegimenDose <<entity>> {
  +Id : int
  +RegimenId : int
  +DoseOrder : int
  +TimingLabel : string
  +IntervalValue : int?
  +IntervalUnit : string?
}
class KhuyenMai <<entity>> {
  +MaKhuyenMai : int
  +TenKhuyenMai : string
  +ThoiGianBatDau : DateTime
  +ThoiGianKetThuc : DateTime
  +MucUuDai : decimal
  +IsEnabled : bool
}
class LoVacXin <<entity>> {
  +SoLo : string
  +MaVacXin : int
  +NgaySanXuat : DateOnly
  +HanSuDung : DateOnly
  +SoLuongBanDau : int
  +SoLuongTon : int
  +TrangThai : string
}
class BienDongKho <<entity>> {
  +MaBienDong : int
  +MaMuiTiem : int?
  +SoLo : string
  +MaNhanVien : int
  +LoaiBienDong : string
  +SoLuong : int
  +ThoiDiem : DateTime
}
class InventoryReceipt <<entity>> {
  +SoLo : string
  +SupplierName : string
  +DocumentNumber : string
  +StorageLocation : string
  +MovementId : int
}
class NhanVien <<reference>> {
  +MaNhanVien : int
  +HoTen : string
}
class MuiTiem <<reference>> {
  +MaMuiTiem : int
  +SoLo : string
}

VacXin "1" -- "0..*" VacXin_Benh
Benh "1" -- "0..*" VacXin_Benh
VacXin "1" -- "0..*" VacXin_CongNghe
CongNgheVacXin "1" -- "0..*" VacXin_CongNghe
GoiVacXin "1" -- "0..*" GoiVacXin_VacXin
VacXin "1" -- "0..*" GoiVacXin_VacXin
VacXin "1" -- "0..*" VaccineRegimen
VaccineRegimen "1" -- "1..*" VaccineRegimenDose
VacXin "1" -- "0..*" LoVacXin
LoVacXin "1" -- "0..*" BienDongKho
NhanVien "1" -- "0..*" BienDongKho
MuiTiem "0..1" -- "0..1" BienDongKho : xuất kho
LoVacXin "1" -- "0..1" InventoryReceipt : tiếp nhận

' layout
VacXin -[hidden]down- GoiVacXin
GoiVacXin -[hidden]down- LoVacXin
LoVacXin -[hidden]down- BienDongKho

note bottom
  Hình giữ các lớp danh mục/kho và lớp kết hợp đang có trong code.
  Khuyến mãi là danh mục độc lập; quan hệ áp dụng với đăng ký được thể hiện ở Hình 3.1a.
end note
@enduml